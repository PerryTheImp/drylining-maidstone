---
import Layout from "../layouts/Layout.astro";
import { faqs } from "../data/faqs";

function toSlug(str: string): string {
  return str
    .toLowerCase()
    .replace(/[^a-z0-9\s]/g, "")
    .replace(/\s+/g, "-")
    .replace(/-+/g, "-")
    .replace(/^-|-$/g, "");
}

// Group FAQs by topic for the index page. Topic order matters — basics first,
// then cost/time, then installation methods, then specific scenarios, then
// Maidstone-specific regulations.
const groups: { label: string; tagline: string; questions: typeof faqs }[] = [
  {
    label: "Dry Lining Basics",
    tagline: "What it is, how it works, and why it's the standard finish in Maidstone",
    questions: faqs.filter(f =>
      ["What is dry lining and how does it work?",
       "What is the difference between dry lining and plastering?",
       "What are the main benefits of dry lining?",
       "What materials are used for dry lining?",
       "How thick is a drylined wall?"].includes(f.question)
    ),
  },
  {
    label: "Costs, Timeframes & Quotes",
    tagline: "Maidstone pricing, programme lengths and what to expect",
    questions: faqs.filter(f =>
      ["How much does dry lining cost in Maidstone?",
       "Is dry lining cheaper than traditional plastering?",
       "How long does dry lining take to install?",
       "How long does dry lining last?",
       "How much does it cost to dry line a 3-bed terrace in Maidstone?",
       "How much do suspended ceilings cost in Maidstone?"].includes(f.question)
    ),
  },
  {
    label: "Installation Methods",
    tagline: "Dot-and-dab, metal stud, partition walls and ceilings",
    questions: faqs.filter(f =>
      ["What is dot-and-dab dry lining?",
       "What is metal frame dry lining?",
       "Do drylined walls need to be skimmed?",
       "Can dry lining be installed over brick walls?",
       "Can dry lining cover uneven or damaged walls?",
       "Can ceilings be dry lined?",
       "Can pipes and electrical cables be hidden behind dry lining?"].includes(f.question)
    ),
  },
  {
    label: "Property Types & Specific Projects",
    tagline: "Older homes, lofts, bathrooms, soundproofing and energy efficiency",
    questions: faqs.filter(f =>
      ["Can dry lining be used in a loft conversion?",
       "Is dry lining suitable for older homes in Maidstone?",
       "Is dry lining suitable for Victorian terraces in Maidstone central and Bearsted?",
       "Is dry lining suitable for commercial properties?",
       "Can dry lining be used on damp walls?",
       "How do you deal with damp in Maidstone Victorian terrace walls before dry lining?",
       "Can bathrooms and kitchens be dry lined?",
       "Can dry lining improve soundproofing?",
       "Can dry lining improve a property's energy efficiency?",
       "Can dry lining improve wall insulation?",
       "Is insulated plasterboard worth using?",
       "Does dry lining help prevent condensation?",
       "Does dry lining make a room smaller?",
       "Can dry lining help with soundproofing between flats in Maidstone town centre?"].includes(f.question)
    ),
  },
  {
    label: "Choosing a Contractor & Maidstone Regulations",
    tagline: "Compliance, HMO licensing, building regs and vetting tradespeople",
    questions: faqs.filter(f =>
      ["How do I choose a dry lining contractor in Maidstone?",
       "What should I ask a dry lining company before hiring them?",
       "Do I need planning permission for dry lining?",
       "What are the building regulations for dry lining in Maidstone?",
       "Do I need fire-rated plasterboard in my HMO in Maidstone?",
       "Do I need an HMO licence in Maidstone?",
       "What is the Article 4 Direction for HMOs in Maidstone?",
       "How long does a commercial office fit-out take in Maidstone?",
       "Where can I get suspended ceilings in Maidstone and the wider ME postcode area?"].includes(f.question)
    ),
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.question,
        "acceptedAnswer": { "@type": "Answer", "text": f.answer.replace(/\n+/g, " ").trim() },
      })),
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://dryliningmaidstone.co.uk/" },
        { "@type": "ListItem", position: 2, name: "FAQ", item: "https://dryliningmaidstone.co.uk/faq/" },
      ],
    },
  ],
};
---

<Layout
  title="Dry Lining FAQ | Drylining Maidstone — Common Questions Answered"
  description="Frequently asked questions about drylining, plasterboarding, partition walls and suspended ceilings in Maidstone. Practical answers covering cost, timeframes, building regulations, HMOs and how to choose a contractor."
  canonical="/faq/"
  schema={schema}
>
  <!-- HERO — matches new site design: dark navy gradient + yellow accent + breadcrumb + H1 + CTAs -->
  <section style="position:relative;min-height:480px;display:flex;align-items:center;background:linear-gradient(135deg,#0a0e1a 0%,#1a1f3a 100%);overflow:hidden;">
    <img src="/images/maidstone-town.jpg" alt="Maidstone town centre skyline — backdrop for the Drylining Maidstone FAQ" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.25;" />
    <div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(10,14,26,0.85) 0%,rgba(26,31,58,0.85) 100%);"></div>
    <div class="container" style="position:relative;z-index:1;">
      <nav style="font-size:0.75rem;color:rgba(255,255,255,0.6);margin-bottom:1.5rem;">
        <a href="/" style="color:#FACC15;">HOME</a> / <span style="color:#FACC15;font-weight:600;">FAQ</span>
      </nav>
      <span style="display:inline-block;padding:0.375rem 1rem;background:rgba(30,64,175,0.15);border:1px solid #FACC15;color:#FACC15;font-size:0.75rem;font-weight:700;letter-spacing:0.05em;border-radius:99px;margin-bottom:1.25rem;">MAIDSTONE DRYLINING FAQ</span>
      <h1 style="font-size:3.5rem;font-weight:800;color:var(--white);line-height:1.1;margin-bottom:1.25rem;">Dry Lining Questions, <span style="color:#FACC15;">Answered</span></h1>
      <p style="font-size:1.125rem;color:rgba(255,255,255,0.85);margin-bottom:1.5rem;max-width:48rem;">Practical, plain-English answers to the {faqs.length} questions Maidstone homeowners, landlords and contractors ask us most often — covering cost, timeframes, building regs, HMOs and how to vet a contractor.</p>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;">
        <a href="/get-quote/" class="btn btn-highlight">Get My Free Quote</a>
        <a href="#basics" class="btn btn-outline" style="color:var(--white);border-color:rgba(255,255,255,0.3);">Browse Questions</a>
      </div>
    </div>
  </section>

  <!-- TL;DR card -->
  <section class="container" style="padding:3rem 1.5rem 0;">
    <div style="background:rgba(30,64,175,0.05);border-left:4px solid #FACC15;padding:1rem 1.5rem;margin-bottom:2rem;border-radius:0 8px 8px 0;">
      <p style="margin:0;font-size:1rem;font-weight:600;color:var(--text);"><strong>TL;DR:</strong> {faqs.length} questions, grouped by topic. Click any question for the full Maidstone-specific answer with current 2026 prices, building regulations, HMO licensing rules and cost-saving tips. Can't find what you need? <a href="/get-quote/" style="color:var(--primary);">Send us your question</a> and we'll respond within 24 hours.</p>
    </div>
  </section>

  <!-- Question groups -->
  {groups.map((group, gi) => (
    <section id={["basics","costs","methods","projects","regulations"][gi]} class="container" style="padding:2rem 1.5rem;">
      <header style="margin-bottom:1.5rem;">
        <h2 style="font-size:1.875rem;font-weight:700;margin-bottom:0.5rem;">{group.label}</h2>
        <p style="color:var(--text-light);font-size:1.0625rem;margin:0;">{group.tagline}</p>
      </header>
      <ul style="list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:1rem;">
        {group.questions.map(f => (
          <li>
            <a href={`/drylining-faq/${toSlug(f.question)}/`} style="display:block;padding:1.25rem 1.5rem;background:var(--white);border:1px solid var(--border);border-radius:var(--radius);text-decoration:none;color:var(--text);transition:border-color 0.2s,box-shadow 0.2s;line-height:1.5;">
              <span style="color:var(--primary);font-weight:600;font-size:0.875rem;display:block;margin-bottom:0.5rem;text-transform:uppercase;letter-spacing:0.05em;">Read answer →</span>
              <span style="font-size:1.0625rem;font-weight:600;color:var(--text);">{f.question}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <!-- Still have questions -->
  <section class="container" style="padding:2rem 1.5rem 4rem;">
    <div style="text-align:center;background:var(--accent);padding:3rem 2rem;border-radius:var(--radius);">
      <h3 style="font-size:1.75rem;font-weight:700;color:var(--secondary);margin-bottom:0.75rem;">Still Have Questions?</h3>
      <p style="color:var(--text);margin-bottom:1.5rem;font-size:1.0625rem;max-width:36rem;margin-left:auto;margin-right:auto;">Our team is happy to help. Send a brief, your plans, or just a question — we'll come back with a plain-English answer or a free itemised quote, usually within 24 hours.</p>
      <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
        <a href="/get-quote/" class="btn btn-primary">Get a Free Quote</a>
        <a href="/contact/" class="btn btn-outline">Contact Us</a>
      </div>
    </div>
  </section>
</Layout>
