---
import Layout from "../../layouts/Layout.astro";

// Posts registry — each entry is rendered on /blog/ index
// Cron-driven pipeline adds new posts here weekly
type Post = {
  slug: string;
  title: string;
  description: string;
  pubDate: string;        // ISO date
  category: string;
  readMinutes: number;
  href: string;
};

const posts: Post[] = [
  // Entries added as posts are published. Cron writes a new entry here
  // and the corresponding page under /blog/{slug}/.
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Blog",
      "@id": "https://dryliningmaidstone.co.uk/blog/#blog",
      "name": "Drylining Maidstone Blog",
      "description": "Local drylining, partition wall, suspended ceiling, and renovation insights for Maidstone homeowners, builders, and commercial fit-out teams.",
      "url": "https://dryliningmaidstone.co.uk/blog/",
      "inLanguage": "en-GB"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://dryliningmaidstone.co.uk/" },
        { "@type": "ListItem", "position": 2, "name": "Resources", "item": "https://dryliningmaidstone.co.uk/resources/dry-lining-cost-guide/" },
        { "@type": "ListItem", "position": 3, "name": "Blog", "item": "https://dryliningmaidstone.co.uk/blog/" }
      ]
    }
  ]
};
---

<Layout
  title="Blog | Drylining Maidstone — Local Projects, Pricing & Building-Regulation Insights"
  description="Maidstone-focused drylining, partition walls, suspended ceilings, plasterboarding, and Building Regulations insight. Real local projects across ME14, ME15, ME16, ME17, ME18, plain-English guides, no fluff."
  canonical="/blog/"
  schema={schema}
>
  <!-- Hero -->
  <section style="position:relative;min-height:440px;display:flex;align-items:center;background:linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);overflow:hidden; max-height:560px;">
    <img src="/images/service-commercial.jpg" alt="Drylining Maidstone blog — local project insights" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;">
    <div style="position:absolute;inset:0;background:linear-gradient(90deg,rgba(17,17,17,0.88) 0%,rgba(17,17,17,0.65) 50%,rgba(17,17,17,0.25) 80%,rgba(17,17,17,0) 100%);"></div>
    <div class="container" style="position:relative;z-index:1;">
      <nav style="font-size:13px;color:rgba(255,255,255,0.70);margin-bottom:14px;">
        <a href="/" style="text-decoration:none;color:rgba(255,255,255,0.70);">Home</a> / <a href="/resources/dry-lining-cost-guide/" style="text-decoration:none;color:rgba(255,255,255,0.70);">Resources</a> / <span style="color:#ffffff;">Blog</span>
      </nav>
      <div style="display:inline-block;background:rgba(30,64,175,0.3);color:#fff;padding:0.375rem 1rem;border-radius:9999px;font-size:0.8125rem;font-weight:600;margin-bottom:1.25rem;border:1px solid rgba(250,204,21,0.4);">Updated Weekly · Maidstone Local</div>
      <h1 style="font-size:clamp(1.875rem,4vw,2.75rem);font-weight:800;color:var(--white);line-height:1.1;margin:0 0 1rem;max-width:780px;">The <span style="color:var(--highlight);">Drylining</span> Maidstone Blog</h1>
      <p style="font-size:1.0625rem;color:rgba(255,255,255,0.88);max-width:680px;line-height:1.6;margin:0 0 1.5rem;">Plain-English guides, real Maidstone projects across ME14, ME15, ME16, ME17, ME18, and Building Regulations insight for homeowners, builders, and commercial fit-out teams. New posts every Tuesday.</p>
      <div style="display:flex;gap:0.75rem;flex-wrap:wrap;">
        <a href="/get-quote/" class="btn btn-highlight" style="font-size:0.9375rem;padding:0.75rem 1.5rem;">Get My Free Quote</a>
        <a href="tel:+448001234567" class="btn btn-outline" style="border-color:rgba(255,255,255,0.4);color:var(--white);font-size:0.9375rem;padding:0.625rem 1.5rem;">Call the Maidstone Team</a>
      </div>
    </div>
  </section>

  <!-- Posts grid -->
  <section class="section">
    <div class="container">
      <h2 style="font-size:2rem;font-weight:800;color:var(--secondary);margin-bottom:1rem;">Latest Articles</h2>
      <p style="color:var(--text-light);font-size:1.0625rem;margin-bottom:2.5rem;max-width:700px;">All articles are written for the Maidstone market: local postcodes (ME14, ME15, ME16, ME17, ME18), real project case studies, regional pricing, and the building regulations that affect Kent projects specifically.</p>

      {posts.length === 0 ? (
        <div style="background:var(--accent);border:1px dashed var(--border);border-radius:var(--radius);padding:3rem 2rem;text-align:center;">
          <h3 style="font-size:1.5rem;font-weight:700;color:var(--secondary);margin-bottom:0.75rem;">First article publishing this week</h3>
          <p style="color:var(--text-light);max-width:560px;margin:0 auto 1.5rem;">Our content team is writing one fresh, location-specific guide per week. New posts will appear here automatically as they ship.</p>
          <a href="/resources/dry-lining-cost-guide/" class="btn btn-primary">Read the 2026 Cost Guide</a>
        </div>
      ) : (
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:1.5rem;">
          {posts.map(p => (
            <a href={p.href} style="background:var(--white);border:1px solid var(--border);border-radius:var(--radius);padding:1.5rem;color:inherit;text-decoration:none;transition:transform 0.2s ease, box-shadow 0.2s ease;display:flex;flex-direction:column;gap:0.5rem;" class="card-hover">
              <div style="font-size:0.75rem;font-weight:600;color:var(--primary);text-transform:uppercase;letter-spacing:0.05em;">{p.category}</div>
              <h3 style="font-size:1.25rem;font-weight:700;color:var(--secondary);line-height:1.3;margin:0;">{p.title}</h3>
              <p style="color:var(--text-light);font-size:0.9375rem;margin:0;flex:1;">{p.description}</p>
              <div style="display:flex;gap:1rem;font-size:0.8125rem;color:var(--text-light);">
                <time>{new Date(p.pubDate).toLocaleDateString("en-GB", { year: "numeric", month: "short", day: "numeric" })}</time>
                <span>·</span>
                <span>{p.readMinutes} min read</span>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- CTA -->
  <section class="section" style="background:var(--accent);">
    <div class="container" style="text-align:center;max-width:680px;">
      <h2 style="font-size:1.75rem;font-weight:800;color:var(--secondary);margin-bottom:1rem;">Have a project in mind?</h2>
      <p style="color:var(--text-light);font-size:1.0625rem;margin-bottom:1.5rem;">Reading the guides is a great start — but every Maidstone project is different. Get a free, no-obligation quote tailored to your specific property and postcode.</p>
      <div style="display:flex;gap:0.75rem;justify-content:center;flex-wrap:wrap;">
        <a href="/get-quote/" class="btn btn-highlight" style="font-size:1rem;padding:0.875rem 1.75rem;">Get My Free Quote</a>
        <a href="tel:+448001234567" class="btn btn-outline" style="font-size:1rem;padding:0.75rem 1.75rem;">Call the Maidstone Team</a>
      </div>
    </div>
  </section>
</Layout>
