---
import Layout from "../layouts/Layout.astro";
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "serviceType": "Drylining Quote Request",
      "additionalType": "https://www.wikidata.org/entity/Q213825",
      "sameAs": "https://en.wikipedia.org/wiki/Drywall",
      "provider": { 
        "@type": "LocalBusiness", 
        "name": "Drylining Maidstone", 
        "@id": "https://dryliningmaidstone.co.uk/#business",
        "knowsAbout": [
          "https://en.wikipedia.org/wiki/Drywall",
          "https://en.wikipedia.org/wiki/Plaster",
          "https://en.wikipedia.org/wiki/Partition_wall",
          "https://en.wikipedia.org/wiki/Building_regulations_in_the_United_Kingdom",
          "https://en.wikipedia.org/wiki/Construction_worker",
          "https://en.wikipedia.org/wiki/General_contractor",
          "https://en.wikipedia.org/wiki/Cold-formed_steel",
          "https://en.wikipedia.org/wiki/Dropped_ceiling"
        ]
      },
      "areaServed": { 
        "@type": "City", 
        "name": "Maidstone",
        "sameAs": [
          "https://en.wikipedia.org/wiki/Maidstone",
          "https://www.wikidata.org/entity/Q213180"
        ]
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://dryliningmaidstone.co.uk/" },
        { "@type": "ListItem", "position": 2, "name": "Get a Quote", "item": "https://dryliningmaidstone.co.uk/get-quote/" }
      ]
    }
  ]
};
---
<Layout title="Get a Free Quote | Drylining Maidstone" description="Request a free, no-obligation quote for drylining, partition walls, and suspended ceilings in Maidstone. Fast response within 24 hours." canonical="/get-quote/" schema={schema}>
<section style="position:relative;min-height:480px;display:flex;align-items:center;background:linear-gradient(135deg,#0a0e1a 0%,#1a1f3a 100%);overflow:hidden;">
  <img src="/images/service-refurbishment.jpg" alt="Maidstone renovation project ready for drylining quote" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.45;">
  <div style="position:absolute;inset:0;background:linear-gradient(90deg,rgba(10,14,26,0.85) 0%,rgba(10,14,26,0.5) 60%,rgba(10,14,26,0.2) 100%);"></div>
  <div class="container" style="position:relative;z-index:1;text-align:center;">
    <nav style="font-size:12px;color:rgba(255,255,255,0.7);margin-bottom:14px;letter-spacing:0.05em;text-transform:uppercase;">
      <a href="/" style="text-decoration:none;color:rgba(255,255,255,0.7);">Home</a> &nbsp;/&nbsp; <span style="color:#FACC15;">Get a Quote</span>
    </nav>
    <div style="display:inline-block;background:rgba(30,64,175,0.25);color:#ffffff;padding:0.4rem 1rem;border-radius:9999px;font-size:0.8125rem;font-weight:600;margin-bottom:1.25rem;border:1px solid rgba(250,204,21,0.4);letter-spacing:0.05em;">FREE, NO-OBLIGATION · 24-HOUR RESPONSE</div>
    <h1 style="font-size:clamp(2.25rem,5vw,3.75rem);font-weight:800;color:#ffffff;margin-bottom:1rem;line-height:1.05;letter-spacing:-0.02em;">Get My <span style="color:#FACC15;">Free Quote</span></h1>
    <p style="font-size:1.125rem;color:rgba(255,255,255,0.88);max-width:680px;margin:0 auto 1.5rem;line-height:1.65;font-weight:400;">Tell us about your project and we will provide a free, no-obligation quote within <strong style="color:#ffffff;">24 hours</strong>. No hidden fees, no pressure — just honest pricing for quality drylining work across Maidstone.</p>
    <div style="display:flex;gap:0.875rem;justify-content:center;flex-wrap:wrap;">
      <a href="tel:+448****8888" class="btn btn-outline" style="border-color:rgba(255,255,255,0.4);color:#ffffff;font-size:1rem;padding:0.75rem 1.75rem;">Call FREEPHONE 0800 MAIDSTONE</a>
    </div>
  </div>
</section>
<section class="section"><div class="container"><div style="max-width:600px;margin:0 auto;">
<form action="https://script.google.com/macros/s/AKfycbx2ROgDcHu3ArLmfqPETQYCkFn_5YP6fy1WfZMbynAZsoARpnMRntm5iLlgKSFSJBkG/exec" method="POST" id="quoteForm" style="display:flex;flex-direction:column;gap:1rem;">
<input type="hidden" name="source" value="dryliningmaidstone-co-uk" />
<div><label style="display:block;font-weight:600;margin-bottom:0.375rem;font-size:0.9375rem;">Name <span style="color:var(--primary);">*</span></label><input type="text" name="name" required placeholder="Your full name" style="width:100%;padding:0.875rem 1rem;border:1px solid var(--border);border-radius:var(--radius);font-size:0.9375rem;font-family:inherit;" /></div>
<div><label style="display:block;font-weight:600;margin-bottom:0.375rem;font-size:0.9375rem;">Phone <span style="color:var(--primary);">*</span></label><input type="tel" name="phone" required placeholder="Your phone number" style="width:100%;padding:0.875rem 1rem;border:1px solid var(--border);border-radius:var(--radius);font-size:0.9375rem;font-family:inherit;" /></div>
<div><label style="display:block;font-weight:600;margin-bottom:0.375rem;font-size:0.9375rem;">Email</label><input type="email" name="email" placeholder="Your email address" style="width:100%;padding:0.875rem 1rem;border:1px solid var(--border);border-radius:var(--radius);font-size:0.9375rem;font-family:inherit;" /></div>
<div><label style="display:block;font-weight:600;margin-bottom:0.375rem;font-size:0.9375rem;">Service <span style="color:var(--primary);">*</span></label><select name="service" required style="width:100%;padding:0.875rem 1rem;border:1px solid var(--border);border-radius:var(--radius);font-size:0.9375rem;font-family:inherit;background:var(--white);color:var(--text);"><option value="" disabled selected>Select a service</option><option>Drylining Contractors</option><option>Partition Walls</option><option>Metal Stud Partitioning</option><option>Suspended Ceilings</option><option>Plasterboard Installation</option><option>Taping & Jointing</option><option>Commercial Drylining</option><option>Office Drylining</option><option>Other / Not Sure</option></select></div>
<div><label style="display:block;font-weight:600;margin-bottom:0.375rem;font-size:0.9375rem;">Project Details</label><textarea name="details" rows="4" placeholder="Tell us about your project — size, timeline, budget, anything we should know..." style="width:100%;padding:0.875rem 1rem;border:1px solid var(--border);border-radius:var(--radius);font-size:0.9375rem;font-family:inherit;resize:vertical;"></textarea></div>
<button type="submit" class="btn btn-primary" id="quoteSubmitBtn" style="width:100%;margin-top:0.5rem;">Request Free Quote</button>
<div id="quoteFormMessage" style="padding:1rem;border-radius:var(--radius);margin-top:1rem;display:none;font-size:0.9375rem;"></div>
</form>
</div></div></section>

<!-- Map -->
<section style="padding: 0 0 4rem;">
  <div class="container">
    <h2 style="font-size: 1.75rem; font-weight: 800; margin-bottom: 0.5rem; text-align: center;">Our Service Area — Maidstone &amp; Surrounding Borough</h2>
    <p style="text-align:center;color:var(--text-light);margin-bottom:1.5rem;font-size:0.9375rem;">Based in Maidstone city centre, covering all ME14, ME15, ME16, ME17, ME18, TN12, TN27 postcodes across the Maidstone borough.</p>
    <div style="border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow);">
      <iframe src="https://maps.google.com/maps?q=Maidstone,+Kent,+UK&t=&z=12&ie=UTF8&iwloc=&output=embed" width="100%" height="450" style="border:0; display:block;" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" title="Drylining Maidstone service area map"></iframe>
    </div>
  </div>
</section>
<script>
(function(){
var form=document.getElementById("quoteForm");var btn=document.getElementById("quoteSubmitBtn");var msg=document.getElementById("quoteFormMessage");if(!form)return;
form.addEventListener("submit",function(e){
e.preventDefault();
btn.disabled=true;btn.textContent="Sending...";msg.style.display="none";msg.className="";
var data=new FormData(form);var payload={};
data.forEach(function(v,k){payload[k]=v;});
fetch(form.action,{method:"POST",body:JSON.stringify(payload),headers:{"Content-Type":"application/json"},mode:"no-cors"})
.then(function(r){if(r.ok||r.status===0){msg.style.display="block";msg.style.background="#dcfce7";msg.style.color="#15803d";msg.style.border="1px solid #bbf7d0";msg.textContent="Thank you! Your quote request has been sent. We will contact you within 24 hours.";form.reset();}else{throw new Error("Status "+r.status);}})
.catch(function(err){msg.style.display="block";msg.style.background="#fee2e2";msg.style.color="#b91c1c";msg.style.border="1px solid #fecaca";msg.textContent="Something went wrong. Please call us on FREEPHONE 0800 MAIDSTONE or try again.";})
.finally(function(){btn.disabled=false;btn.textContent="Request Free Quote";});
});
})();
</script>
</Layout>