---
import Layout from "../../../layouts/Layout.astro";

const question = "Can dry lining be installed over brick walls?";
const answer = `Yes. Dot-and-dab is the standard method for fixing plasterboard directly to brick or blockwork in Maidstone. The wall must be clean, sound, and free of loose material or existing render. We do not recommend direct fixing to:

- Damp brickwork (rising or penetrating damp must be resolved first)
- Painted surfaces (adhesion will fail)
- Loose or crumbling render (must be hacked off and re-rendered)
- Walls with active salt contamination

For solid 9-inch (225mm) Victorian brick walls typical of Maidstone central, Bearsted and Loose, we typically specify 50-80mm insulated plasterboard dot-and-dab. For damp or contaminated walls, an independent metal stud with a ventilated cavity is the more reliable approach.`;
const description = `Yes. Dot-and-dab is the standard method for fixing plasterboard directly to brick or blockwork in Maidstone. The wall must be clean, sound, and free of loose mate`;
const canonical = "/drylining-faq/can-dry-lining-be-installed-over-brick-walls/";

const schema = {"@context": "https://schema.org", "@graph": [{"@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Can dry lining be installed over brick walls?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. Dot-and-dab is the standard method for fixing plasterboard directly to brick or blockwork in Maidstone. The wall must be clean, sound, and free of loose material or existing render. We do not recommend direct fixing to:\n\n- Damp brickwork (rising or penetrating damp must be resolved first)\n- Painted surfaces (adhesion will fail)\n- Loose or crumbling render (must be hacked off and re-rendered)\n- Walls with active salt contamination\n\nFor solid 9-inch (225mm) Victorian brick walls typical of Maidstone central, Bearsted and Loose, we typically specify 50-80mm insulated plasterboard dot-and-dab. For damp or contaminated walls, an independent metal stud with a ventilated cavity is the more reliable approach."}}]}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://dryliningmaidstone.co.uk/"}, {"@type": "ListItem", "position": 2, "name": "FAQ", "item": "https://dryliningmaidstone.co.uk/faq/"}, {"@type": "ListItem", "position": 3, "name": "Can dry lining be installed over brick walls?", "item": "https://dryliningmaidstone.co.uk/drylining-faq/can-dry-lining-be-installed-over-brick-walls/"}]}]};---

<Layout
  title={question + " | Drylining Maidstone"}
  description={description}
  canonical={canonical}
  schema={schema}
>
  <main class="container" style="padding: 34px 0 70px;">
    <article class="card" style="padding: 28px; max-width: 860px;">
      <header style="margin-bottom: 22px;">
        <p style="margin: 0 0 10px; color: var(--primary); font-weight: 700; letter-spacing: 0.02em; text-transform: uppercase; font-size: 13px;">
          Maidstone Drylining FAQ
        </p>
        <h1 style="margin: 0; font-size: clamp(26px, 4vw, 36px); line-height: 1.15;">{question}</h1>
      </header>

      <section style="padding: 18px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); margin-bottom: 22px;">
        <p style="margin: 0 0 1rem; font-size: 1.0625rem; line-height: 1.8; color: var(--text);">Yes. Dot-and-dab is the standard method for fixing plasterboard directly to brick or blockwork in Maidstone. The wall must be clean, sound, and free of loose material or existing render. We do not recommend direct fixing to:</p>
<p style="margin: 0 0 1rem; font-size: 1.0625rem; line-height: 1.8; color: var(--text);">- Damp brickwork (rising or penetrating damp must be resolved first)
- Painted surfaces (adhesion will fail)
- Loose or crumbling render (must be hacked off and re-rendered)
- Walls with active salt contamination</p>
<p style="margin: 0 0 1rem; font-size: 1.0625rem; line-height: 1.8; color: var(--text);">For solid 9-inch (225mm) Victorian brick walls typical of Maidstone central, Bearsted and Loose, we typically specify 50-80mm insulated plasterboard dot-and-dab. For damp or contaminated walls, an independent metal stud with a ventilated cavity is the more reliable approach.</p>
      </section>

      <section style="margin: 24px 0; padding: 18px 0; border-top: 1px solid var(--border);">
        <h3 style="font-size: 1.1rem; margin-bottom: 12px; color: var(--text);">Related Questions</h3>
        <ul style="list-style: none; padding: 0; margin: 0;">
<li><a href="/drylining-faq/what-is-dot-and-dab-dry-lining/" style="color: var(--primary); font-weight: 500;">What is dot-and-dab dry lining?</a></li>
<li><a href="/drylining-faq/can-dry-lining-be-used-on-damp-walls/" style="color: var(--primary); font-weight: 500;">Can dry lining be used on damp walls?</a></li>
<li><a href="/drylining-faq/can-dry-lining-be-used-in-a-loft-conversion/" style="color: var(--primary); font-weight: 500;">Is dry lining suitable for older Maidstone homes?</a></li>
        </ul>
      </section>

      <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-top: 24px;">
        <a href="/faq/" class="btn btn-outline">All FAQs</a>
        <a href="/get-quote/" class="btn btn-primary">Get a Quote</a>
      </div>
    </article>
  </main>
</Layout>
