---
import Layout from "../../../layouts/Layout.astro";

const question = "Can dry lining be used on damp walls?";
const answer = `No — dry lining should not be applied directly to a damp wall. It will trap moisture against the masonry and cause the plasterboard to fail, often within months. Black mould, peeling paint, and rotten skirting follow.

The damp must first be identified and resolved:

- Rising damp: requires a new damp-proof course (DPC) injection
- Penetrating damp: requires external repairs (render, pointing, gutters)
- Condensation: requires improved ventilation and/or insulation

Once the wall is dry, we can install a chemical or sheet damp-proof membrane, use moisture-resistant plasterboard, or build an independent metal stud wall with a ventilated cavity. For Maidstone's pre-1930s housing stock — Victorian terraces in Maidstone central, Bearsted, Loose and Boxley — independent stud is often the most reliable approach.`;
const description = `No — dry lining should not be applied directly to a damp wall. It will trap moisture against the masonry and cause the plasterboard to fail, often within months`;
const canonical = "/drylining-faq/can-dry-lining-be-used-on-damp-walls/";

const schema = {"@context": "https://schema.org", "@graph": [{"@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Can dry lining be used on damp walls?", "acceptedAnswer": {"@type": "Answer", "text": "No — dry lining should not be applied directly to a damp wall. It will trap moisture against the masonry and cause the plasterboard to fail, often within months. Black mould, peeling paint, and rotten skirting follow.\n\nThe damp must first be identified and resolved:\n\n- Rising damp: requires a new damp-proof course (DPC) injection\n- Penetrating damp: requires external repairs (render, pointing, gutters)\n- Condensation: requires improved ventilation and/or insulation\n\nOnce the wall is dry, we can install a chemical or sheet damp-proof membrane, use moisture-resistant plasterboard, or build an independent metal stud wall with a ventilated cavity. For Maidstone's pre-1930s housing stock — Victorian terraces in Maidstone central, Bearsted, Loose and Boxley — independent stud is often the most reliable approach."}}]}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://dryliningmaidstone.co.uk/"}, {"@type": "ListItem", "position": 2, "name": "FAQ", "item": "https://dryliningmaidstone.co.uk/faq/"}, {"@type": "ListItem", "position": 3, "name": "Can dry lining be used on damp walls?", "item": "https://dryliningmaidstone.co.uk/drylining-faq/can-dry-lining-be-used-on-damp-walls/"}]}]};---

<Layout
  title={question + " | Drylining Maidstone"}
  description={description}
  canonical={canonical}
  schema={schema}
>
  <main class="container" style="padding: 34px 0 70px;">
    <article class="card" style="padding: 28px; max-width: 860px;">
      <header style="margin-bottom: 22px;">
        <p style="margin: 0 0 10px; color: var(--primary); font-weight: 700; letter-spacing: 0.02em; text-transform: uppercase; font-size: 13px;">
          Maidstone Drylining FAQ
        </p>
        <h1 style="margin: 0; font-size: clamp(26px, 4vw, 36px); line-height: 1.15;">{question}</h1>
      </header>

      <section style="padding: 18px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); margin-bottom: 22px;">
        <p style="margin: 0 0 1rem; font-size: 1.0625rem; line-height: 1.8; color: var(--text);">No — dry lining should not be applied directly to a damp wall. It will trap moisture against the masonry and cause the plasterboard to fail, often within months. Black mould, peeling paint, and rotten skirting follow.</p>
<p style="margin: 0 0 1rem; font-size: 1.0625rem; line-height: 1.8; color: var(--text);">The damp must first be identified and resolved:</p>
<p style="margin: 0 0 1rem; font-size: 1.0625rem; line-height: 1.8; color: var(--text);">- Rising damp: requires a new damp-proof course (DPC) injection
- Penetrating damp: requires external repairs (render, pointing, gutters)
- Condensation: requires improved ventilation and/or insulation</p>
<p style="margin: 0 0 1rem; font-size: 1.0625rem; line-height: 1.8; color: var(--text);">Once the wall is dry, we can install a chemical or sheet damp-proof membrane, use moisture-resistant plasterboard, or build an independent metal stud wall with a ventilated cavity. For Maidstone's pre-1930s housing stock — Victorian terraces in Maidstone central, Bearsted, Loose and Boxley — independent stud is often the most reliable approach.</p>
      </section>

      <section style="margin: 24px 0; padding: 18px 0; border-top: 1px solid var(--border);">
        <h3 style="font-size: 1.1rem; margin-bottom: 12px; color: var(--text);">Related Questions</h3>
        <ul style="list-style: none; padding: 0; margin: 0;">
<li><a href="/drylining-faq/does-dry-lining-help-prevent-condensation/" style="color: var(--primary); font-weight: 500;">Does dry lining help prevent condensation?</a></li>
<li><a href="/drylining-faq/can-dry-lining-be-installed-over-brick-walls/" style="color: var(--primary); font-weight: 500;">Can dry lining be installed over brick walls?</a></li>
<li><a href="/drylining-faq/can-dry-lining-be-used-in-a-loft-conversion/" style="color: var(--primary); font-weight: 500;">Is dry lining suitable for older Maidstone homes?</a></li>
        </ul>
      </section>

      <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-top: 24px;">
        <a href="/faq/" class="btn btn-outline">All FAQs</a>
        <a href="/get-quote/" class="btn btn-primary">Get a Quote</a>
      </div>
    </article>
  </main>
</Layout>
