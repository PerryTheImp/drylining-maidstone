---
import Layout from "../../../layouts/Layout.astro";

const question = "How much does dry lining cost in Maidstone?";
const answer = "Dry lining costs in Maidstone for September 2026 are typically:\n\n- Standard 12.5mm plasterboard (dot-and-dab to blockwork): £25 - £42 per m²\n- Tape-and-joint finish on standard board: £7 - £11 per m²\n- Full plaster skim over plasterboard: £7 - £11 per m²\n- Moisture-resistant or fire-rated board upgrade: +£5 - £9 per m²\n- Insulated plasterboard (PIR, 50-80mm): £38 - £60 per m²\n- Acoustic dry lining system: £45 - £72 per m²\n- Suspended ceiling (MF plasterboard): £28 - £50 per m²\n- Metal stud partition (single layer, per linear metre): £55 - £100 per m\n- Metal stud partition (double layer, acoustic/fire): £78 - £135 per m\n\nMaidstone prices sit roughly 5-15% above the UK national average because labour day rates in Kent (£200 - £280) are higher than the national average (£180 - £250).  Material costs are largely consistent across the UK.\n\nFor a Maidstone three-bed terrace, expect £4,000 - £8,500 over 1-2 weeks. Commercial 500-1,000 m² fit-outs typically range £18,000 - £45,000 over 2-4 weeks. Every project is unique — request a free, itemised quote.";
const description = "Dry lining costs in Maidstone for September 2026 are typically: - Standard 12.5mm plasterboard (dot-and-dab to blockwork): £25 - £42 per m² -";
const canonical = "/drylining-faq/how-much-does-dry-lining-cost-in-maidstone/";

const schema = {"@context":"https://schema.org","@graph":[{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How much does dry lining cost in Maidstone?","acceptedAnswer":{"@type":"Answer","text":"Dry lining costs in Maidstone for September 2026 are typically:  - Standard 12.5mm plasterboard (dot-and-dab to blockwork): £25 - £42 per m² - Tape-and-joint finish on standard board: £7 - £11 per m² - Full plaster skim over plasterboard: £7 - £11 per m² - Moisture-resistant or fire-rated board upgrade: +£5 - £9 per m² - Insulated plasterboard (PIR, 50-80mm): £38 - £60 per m² - Acoustic dry lining system: £45 - £72 per m² - Suspended ceiling (MF plasterboard): £28 - £50 per m² - Metal stud partition (single layer, per linear metre): £55 - £100 per m - Metal stud partition (double layer, acoustic/fire): £78 - £135 per m  Maidstone prices sit roughly 5-15% above the UK national average because labour day rates in Kent (£200 - £280) are higher than the national average (£180 - £250).  Material costs are largely consistent across the UK.  For a Maidstone three-bed terrace, expect £4,000 - £8,500 over 1-2 weeks. Commercial 500-1,000 m² fit-outs typically range £18,000 - £45,000 over 2-4 weeks. Every project is unique — request a free, itemised quote."}}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://dryliningmaidstone.co.uk/"},{"@type":"ListItem","position":2,"name":"FAQ","item":"https://dryliningmaidstone.co.uk/faq/"},{"@type":"ListItem","position":3,"name":"How much does dry lining cost in Maidstone?","item":"https://dryliningmaidstone.co.uk/drylining-faq/how-much-does-dry-lining-cost-in-maidstone/"}]}]};
---

<Layout
  title={`${question} | Drylining Maidstone`}
  description={description}
  canonical={canonical}
  schema={schema}
>
  <!-- HERO — matches new site design: dark navy gradient + yellow accent + breadcrumb + badge + H1 + CTAs -->
  <section style="position:relative;min-height:380px;display:flex;align-items:center;background:linear-gradient(135deg,#0a0e1a 0%,#1a1f3a 100%);overflow:hidden;">
    <img src="/images/maidstone-town.jpg" alt="Maidstone town centre — backdrop for the Drylining Maidstone FAQ" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.20;" />
    <div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(10,14,26,0.88) 0%,rgba(26,31,58,0.88) 100%);"></div>
    <div class="container" style="position:relative;z-index:1;">
      <nav style="font-size:0.75rem;color:rgba(255,255,255,0.6);margin-bottom:1.25rem;">
        <a href="/" style="color:#FACC15;">HOME</a> / <a href="/faq/" style="color:#FACC15;">FAQ</a> / <span style="color:#FACC15;font-weight:600;">{question.slice(0, 60)}{question.length > 60 ? "…" : ""}</span>
      </nav>
      <span style="display:inline-block;padding:0.375rem 1rem;background:rgba(30,64,175,0.15);border:1px solid #FACC15;color:#FACC15;font-size:0.75rem;font-weight:700;letter-spacing:0.05em;border-radius:99px;margin-bottom:1.25rem;">MAIDSTONE DRYLINING FAQ</span>
      <h1 style="font-size:clamp(1.75rem,4vw,3rem);font-weight:800;color:var(--white);line-height:1.15;margin-bottom:1rem;max-width:48rem;">{question}</h1>
      <p style="font-size:1.0625rem;color:rgba(255,255,255,0.85);margin-bottom:1.5rem;max-width:42rem;">Maidstone-specific answer with current 2026 pricing, building regulations, HMO licensing rules and practical advice from our local team.</p>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;">
        <a href="/get-quote/" class="btn btn-highlight">Get My Free Quote</a>
        <a href="/faq/" class="btn btn-outline" style="color:var(--white);border-color:rgba(255,255,255,0.3);">All FAQs</a>
      </div>
    </div>
  </section>

  <main class="container" style="padding:3rem 1.5rem 4rem;">
    <article class="card" style="padding:2rem;max-width:880px;">
      <div style="background:rgba(30,64,175,0.05);border-left:4px solid #FACC15;padding:1rem 1.5rem;margin-bottom:1.75rem;border-radius:0 8px 8px 0;">
        <p style="margin:0;font-size:0.875rem;color:var(--text);text-transform:uppercase;letter-spacing:0.05em;font-weight:700;">Quick Answer</p>
        <p style="margin:0.5rem 0 0;font-size:1.0625rem;color:var(--text);line-height:1.7;font-weight:500;">{description}</p>
      </div>

      <div class="faq-answer" style="font-size:1.0625rem;line-height:1.85;color:var(--text);">
  <p style="margin:0 0 1.1rem;color:var(--text);line-height:1.8;">Dry lining costs in Maidstone for September 2026 are typically:</p>
  <ul style="list-style:disc;padding-left:1.5rem;margin:0 0 1.25rem;color:var(--text);">
    <li style="margin-bottom:0.45rem;line-height:1.75;">Standard 12.5mm plasterboard (dot-and-dab to blockwork): £25 - £42 per m²</li>
    <li style="margin-bottom:0.45rem;line-height:1.75;">Tape-and-joint finish on standard board: £7 - £11 per m²</li>
    <li style="margin-bottom:0.45rem;line-height:1.75;">Full plaster skim over plasterboard: £7 - £11 per m²</li>
    <li style="margin-bottom:0.45rem;line-height:1.75;">Moisture-resistant or fire-rated board upgrade: +£5 - £9 per m²</li>
    <li style="margin-bottom:0.45rem;line-height:1.75;">Insulated plasterboard (PIR, 50-80mm): £38 - £60 per m²</li>
    <li style="margin-bottom:0.45rem;line-height:1.75;">Acoustic dry lining system: £45 - £72 per m²</li>
    <li style="margin-bottom:0.45rem;line-height:1.75;">Suspended ceiling (MF plasterboard): £28 - £50 per m²</li>
    <li style="margin-bottom:0.45rem;line-height:1.75;">Metal stud partition (single layer, per linear metre): £55 - £100 per m</li>
    <li style="margin-bottom:0.45rem;line-height:1.75;">Metal stud partition (double layer, acoustic/fire): £78 - £135 per m</li>
  </ul>
  <p style="margin:0 0 1.1rem;color:var(--text);line-height:1.8;">Maidstone prices sit roughly 5-15% above the UK national average because labour day rates in Kent (£200 - £280) are higher than the national average (£180 - £250).  Material costs are largely consistent across the UK.</p>
  <p style="margin:0 0 1.1rem;color:var(--text);line-height:1.8;">For a Maidstone three-bed terrace, expect £4,000 - £8,500 over 1-2 weeks. Commercial 500-1,000 m² fit-outs typically range £18,000 - £45,000 over 2-4 weeks. Every project is unique — request a free, itemised quote.</p>
      </div>

      <div style="margin-top:2.5rem;padding:1.5rem;background:var(--accent);border-radius:var(--radius);">
        <h3 style="font-size:1.25rem;font-weight:700;color:var(--secondary);margin-bottom:0.75rem;">Need a quote for this in Maidstone?</h3>
        <p style="color:var(--text);margin-bottom:1.25rem;font-size:1rem;">Send a brief, your plans or just a few photos. We will turn around a fixed-price quote within 48 hours, anywhere across ME14–ME20, TN12 and TN27 postcodes.</p>
        <div style="display:flex;gap:0.75rem;flex-wrap:wrap;">
          <a href="/get-quote/" class="btn btn-primary">Get My Free Quote</a>
          <a href="/contact/" class="btn btn-outline">Contact Us</a>
        </div>
      </div>
    </article>

    <aside style="max-width:880px;margin-top:2rem;padding:1.5rem;background:var(--white);border:1px solid var(--border);border-radius:var(--radius);">
      <h3 style="font-size:1.125rem;font-weight:700;color:var(--text);margin-bottom:1rem;">Related Questions</h3>
      <ul style="list-style:none;padding:0;margin:0;display:grid;gap:0.625rem;">
            <li><a href="/drylining-faq/what-is-dry-lining-and-how-does-it-work/" style="color:var(--primary);font-weight:500;">What is dry lining and how does it work?</a></li>
            <li><a href="/drylining-faq/is-dry-lining-cheaper-than-traditional-plastering/" style="color:var(--primary);font-weight:500;">Is dry lining cheaper than traditional plastering?</a></li>
            <li><a href="/drylining-faq/how-long-does-dry-lining-take-to-install/" style="color:var(--primary);font-weight:500;">How long does dry lining take to install?</a></li>
      </ul>
      <p style="margin-top:1.25rem;font-size:0.9375rem;color:var(--text-light);"><a href="/faq/" style="color:var(--primary);font-weight:600;">Browse all 41 FAQs →</a></p>
    </aside>
  </main>
</Layout>
