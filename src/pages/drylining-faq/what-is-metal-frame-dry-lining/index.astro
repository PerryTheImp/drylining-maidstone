---
import Layout from "../../../layouts/Layout.astro";

const question = "What is metal frame dry lining?";
const answer = `Metal frame dry lining uses galvanised steel stud and track systems (commonly British Gypsum Gypframe or Knauf) instead of timber framing. It is non-combustible, dimensionally stable, lighter than timber, and produces straighter walls.

Metal stud is the standard for commercial partitions in Maidstone — office fit-outs in Maidstone riverside, retail units in Hazlitt Theatre Outlet, healthcare and education projects, and any fire-rated or acoustic partition. It is also the default choice where Part B (Fire Safety) requires non-combustible construction, or where Part E (Resistance to Sound) requires independent stud framing to decouple the plasterboard from the structure.

For residential Maidstone work, both timber and metal stud are suitable depending on specification. Metal stud costs more than timber in material but saves labour time and gives a better acoustic result.`;
const description = `Metal frame dry lining uses galvanised steel stud and track systems (commonly British Gypsum Gypframe or Knauf) instead of timber framing. It is non-combustible`;
const canonical = "/drylining-faq/what-is-metal-frame-dry-lining/";

const schema = {"@context": "https://schema.org", "@graph": [{"@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "What is metal frame dry lining?", "acceptedAnswer": {"@type": "Answer", "text": "Metal frame dry lining uses galvanised steel stud and track systems (commonly British Gypsum Gypframe or Knauf) instead of timber framing. It is non-combustible, dimensionally stable, lighter than timber, and produces straighter walls.\n\nMetal stud is the standard for commercial partitions in Maidstone — office fit-outs in Maidstone riverside, retail units in Hazlitt Theatre Outlet, healthcare and education projects, and any fire-rated or acoustic partition. It is also the default choice where Part B (Fire Safety) requires non-combustible construction, or where Part E (Resistance to Sound) requires independent stud framing to decouple the plasterboard from the structure.\n\nFor residential Maidstone work, both timber and metal stud are suitable depending on specification. Metal stud costs more than timber in material but saves labour time and gives a better acoustic result."}}]}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://dryliningmaidstone.co.uk/"}, {"@type": "ListItem", "position": 2, "name": "FAQ", "item": "https://dryliningmaidstone.co.uk/faq/"}, {"@type": "ListItem", "position": 3, "name": "What is metal frame dry lining?", "item": "https://dryliningmaidstone.co.uk/drylining-faq/what-is-metal-frame-dry-lining/"}]}]};---

<Layout
  title={question + " | Drylining Maidstone"}
  description={description}
  canonical={canonical}
  schema={schema}
>
  <main class="container" style="padding: 34px 0 70px;">
    <article class="card" style="padding: 28px; max-width: 860px;">
      <header style="margin-bottom: 22px;">
        <p style="margin: 0 0 10px; color: var(--primary); font-weight: 700; letter-spacing: 0.02em; text-transform: uppercase; font-size: 13px;">
          Maidstone Drylining FAQ
        </p>
        <h1 style="margin: 0; font-size: clamp(26px, 4vw, 36px); line-height: 1.15;">{question}</h1>
      </header>

      <section style="padding: 18px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); margin-bottom: 22px;">
        <p style="margin: 0 0 1rem; font-size: 1.0625rem; line-height: 1.8; color: var(--text);">Metal frame dry lining uses galvanised steel stud and track systems (commonly British Gypsum Gypframe or Knauf) instead of timber framing. It is non-combustible, dimensionally stable, lighter than timber, and produces straighter walls.</p>
<p style="margin: 0 0 1rem; font-size: 1.0625rem; line-height: 1.8; color: var(--text);">Metal stud is the standard for commercial partitions in Maidstone — office fit-outs in Maidstone riverside, retail units in Hazlitt Theatre Outlet, healthcare and education projects, and any fire-rated or acoustic partition. It is also the default choice where Part B (Fire Safety) requires non-combustible construction, or where Part E (Resistance to Sound) requires independent stud framing to decouple the plasterboard from the structure.</p>
<p style="margin: 0 0 1rem; font-size: 1.0625rem; line-height: 1.8; color: var(--text);">For residential Maidstone work, both timber and metal stud are suitable depending on specification. Metal stud costs more than timber in material but saves labour time and gives a better acoustic result.</p>
      </section>

      <section style="margin: 24px 0; padding: 18px 0; border-top: 1px solid var(--border);">
        <h3 style="font-size: 1.1rem; margin-bottom: 12px; color: var(--text);">Related Questions</h3>
        <ul style="list-style: none; padding: 0; margin: 0;">
<li><a href="/drylining-faq/can-dry-lining-cover-uneven-or-damaged-walls/" style="color: var(--primary); font-weight: 500;">Can dry lining cover uneven or damaged walls?</a></li>
<li><a href="/drylining-faq/can-dry-lining-improve-soundproofing/" style="color: var(--primary); font-weight: 500;">Can dry lining improve soundproofing?</a></li>
<li><a href="/services/metal-stud-partitioning/" style="color: var(--primary); font-weight: 500;">Metal stud partitioning service</a></li>
        </ul>
      </section>

      <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-top: 24px;">
        <a href="/faq/" class="btn btn-outline">All FAQs</a>
        <a href="/get-quote/" class="btn btn-primary">Get a Quote</a>
      </div>
    </article>
  </main>
</Layout>
