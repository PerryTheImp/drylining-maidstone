---
import Layout from "../../../layouts/Layout.astro";

const question = "Do I need planning permission for dry lining?";
const answer = `Usually no. Internal drylining is generally permitted development and does not require planning permission from Maidstone Borough Council. Exceptions:

- Listed buildings: listed-building consent may be required even for internal work
- External drylining: any work that alters the external appearance of the building needs planning permission
- Flats and maisonettes: some internal alterations require building-regulations approval even where planning is not needed

Building Regulations approval IS required for significant work, including:

- Fire safety upgrades (Part B) — fire-rated partitions, escape routes
- Acoustic upgrades (Part E) — separating walls in conversions and HMOs
- Thermal upgrades (Part L) — insulation affecting U-values
- Structural alterations (Part A) — removing or modifying load-bearing walls

We handle the Building Control notification with Maidstone Borough Council on your behalf. For listed-building consent, you will need an architect or planning consultant — we are happy to recommend local specialists.`;
const description = `Usually no. Internal drylining is generally permitted development and does not require planning permission from Maidstone Borough Council. Exceptions:  - Listed buil`;
const canonical = "/drylining-faq/do-i-need-planning-permission-for-dry-lining/";

const schema = {"@context": "https://schema.org", "@graph": [{"@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Do I need planning permission for dry lining?", "acceptedAnswer": {"@type": "Answer", "text": "Usually no. Internal drylining is generally permitted development and does not require planning permission from Maidstone Borough Council. Exceptions:\n\n- Listed buildings: listed-building consent may be required even for internal work\n- External drylining: any work that alters the external appearance of the building needs planning permission\n- Flats and maisonettes: some internal alterations require building-regulations approval even where planning is not needed\n\nBuilding Regulations approval IS required for significant work, including:\n\n- Fire safety upgrades (Part B) — fire-rated partitions, escape routes\n- Acoustic upgrades (Part E) — separating walls in conversions and HMOs\n- Thermal upgrades (Part L) — insulation affecting U-values\n- Structural alterations (Part A) — removing or modifying load-bearing walls\n\nWe handle the Building Control notification with Maidstone Borough Council on your behalf. For listed-building consent, you will need an architect or planning consultant — we are happy to recommend local specialists."}}]}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://dryliningmaidstone.co.uk/"}, {"@type": "ListItem", "position": 2, "name": "FAQ", "item": "https://dryliningmaidstone.co.uk/faq/"}, {"@type": "ListItem", "position": 3, "name": "Do I need planning permission for dry lining?", "item": "https://dryliningmaidstone.co.uk/drylining-faq/do-i-need-planning-permission-for-dry-lining/"}]}]};---

<Layout
  title={question + " | Drylining Maidstone"}
  description={description}
  canonical={canonical}
  schema={schema}
>
  <main class="container" style="padding: 34px 0 70px;">
    <article class="card" style="padding: 28px; max-width: 860px;">
      <header style="margin-bottom: 22px;">
        <p style="margin: 0 0 10px; color: var(--primary); font-weight: 700; letter-spacing: 0.02em; text-transform: uppercase; font-size: 13px;">
          Maidstone Drylining FAQ
        </p>
        <h1 style="margin: 0; font-size: clamp(26px, 4vw, 36px); line-height: 1.15;">{question}</h1>
      </header>

      <section style="padding: 18px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); margin-bottom: 22px;">
        <p style="margin: 0 0 1rem; font-size: 1.0625rem; line-height: 1.8; color: var(--text);">Usually no. Internal drylining is generally permitted development and does not require planning permission from Maidstone Borough Council. Exceptions:</p>
<p style="margin: 0 0 1rem; font-size: 1.0625rem; line-height: 1.8; color: var(--text);">- Listed buildings: listed-building consent may be required even for internal work
- External drylining: any work that alters the external appearance of the building needs planning permission
- Flats and maisonettes: some internal alterations require building-regulations approval even where planning is not needed</p>
<p style="margin: 0 0 1rem; font-size: 1.0625rem; line-height: 1.8; color: var(--text);">Building Regulations approval IS required for significant work, including:</p>
<p style="margin: 0 0 1rem; font-size: 1.0625rem; line-height: 1.8; color: var(--text);">- Fire safety upgrades (Part B) — fire-rated partitions, escape routes
- Acoustic upgrades (Part E) — separating walls in conversions and HMOs
- Thermal upgrades (Part L) — insulation affecting U-values
- Structural alterations (Part A) — removing or modifying load-bearing walls</p>
<p style="margin: 0 0 1rem; font-size: 1.0625rem; line-height: 1.8; color: var(--text);">We handle the Building Control notification with Maidstone Borough Council on your behalf. For listed-building consent, you will need an architect or planning consultant — we are happy to recommend local specialists.</p>
      </section>

      <section style="margin: 24px 0; padding: 18px 0; border-top: 1px solid var(--border);">
        <h3 style="font-size: 1.1rem; margin-bottom: 12px; color: var(--text);">Related Questions</h3>
        <ul style="list-style: none; padding: 0; margin: 0;">
<li><a href="/drylining-faq/can-dry-lining-be-used-in-a-loft-conversion/" style="color: var(--primary); font-weight: 500;">Can dry lining be used in a loft conversion?</a></li>
<li><a href="/drylining-faq/can-dry-lining-be-used-in-a-loft-conversion/" style="color: var(--primary); font-weight: 500;">Is dry lining suitable for older Maidstone homes?</a></li>
<li><a href="/services/drylining-contractors/" style="color: var(--primary); font-weight: 500;">Drylining Contractors service</a></li>
        </ul>
      </section>

      <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-top: 24px;">
        <a href="/faq/" class="btn btn-outline">All FAQs</a>
        <a href="/get-quote/" class="btn btn-primary">Get a Quote</a>
      </div>
    </article>
  </main>
</Layout>
