---
import Layout from "../../../layouts/Layout.astro";

const question = "Do I need planning permission for dry lining?";
const answer = "Almost never for normal internal dry lining. Internal wall and ceiling finishing is permitted development under the Town and Country Planning (General Permitted Development) (England) Order, so Maidstone Borough Council planning department is not involved. The three exceptions worth knowing:\n\n- Listed buildings: any internal alteration that affects character — even a re-skim on a protected ceiling — needs listed-building consent before work starts. Maidstone has a number of listed interiors in the town centre heritage area and parts of Boxley village\n- External-facing work: anything that changes how the building looks from the outside (external render systems, EWI, replacing soffit boards) is planning territory, not just building control\n- Change of use: converting a house (Use Class C3) to an HMO (sui generis) triggers the Maidstone Article 4 Direction — see our dedicated HMO licensing FAQs\n\nWhat does involve Maidstone Borough Council Building Control, even when planning is not needed:\n\n- Part A (Structure): removing or modifying a load-bearing wall, even partially\n- Part B (Fire Safety): new fire-rated partitions, escape routes, garage-to-house separations\n- Part E (Resistance to Sound): new walls or significant upgrades between flats, between bedsits in an HMO, or between a house and an attached garage converted to a room\n- Part L (Conservation of fuel and power): thermal upgrades that change the U-value of an external wall — the typical 50–80mm insulated plasterboard on a Victorian terrace is a notifiable change\n- Part C (Dampness): where work affects an existing DPC or introduces a new one\n- Part F (Ventilation): where work reduces background ventilation, common in retrofit insulation schemes\n\nFor notifiable work, we file the Building Control application on your behalf and arrange the inspections (typically a pre-plasterboard check and a completion inspection). For non-notifiable work, we still build to BS 8212 best practice but no formal sign-off is needed.";
const description = "Almost never for normal internal dry lining.";
const canonical = "/drylining-faq/do-i-need-planning-permission-for-dry-lining/";
const has_pricing = true;

const schema = {"@context":"https://schema.org","@graph":[{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Do I need planning permission for dry lining?","acceptedAnswer":{"@type":"Answer","text":"Almost never for normal internal dry lining. Internal wall and ceiling finishing is permitted development under the Town and Country Planning (General Permitted Development) (England) Order, so Maidstone Borough Council planning department is not involved. The three exceptions worth knowing:  - Listed buildings: any internal alteration that affects character — even a re-skim on a protected ceiling — needs listed-building consent before work starts. Maidstone has a number of listed interiors in the town centre heritage area and parts of Boxley village - External-facing work: anything that changes how the building looks from the outside (external render systems, EWI, replacing soffit boards) is planning territory, not just building control - Change of use: converting a house (Use Class C3) to an HMO (sui generis) triggers the Maidstone Article 4 Direction — see our dedicated HMO licensing FAQs  What does involve Maidstone Borough Council Building Control, even when planning is not needed:  - Part A (Structure): removing or modifying a load-bearing wall, even partially - Part B (Fire Safety): new fire-rated partitions, escape routes, garage-to-house separations - Part E (Resistance to Sound): new walls or significant upgrades between flats, between bedsits in an HMO, or between a house and an attached garage converted to a room - Part L (Conservation of fuel and power): thermal upgrades that change the U-value of an external wall — the typical 50–80mm insulated plasterboard on a Victorian terrace is a notifiable change - Part C (Dampness): where work affects an existing DPC or introduces a new one - Part F (Ventilation): where work reduces background ventilation, common in retrofit insulation schemes  For notifiable work, we file the Building Control application on your behalf and arrange the inspections (typically a pre-plasterboard check and a completion inspection). For non-notifiable work, we still build to BS 8212 best practice but no formal sign-off is needed."}}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://dryliningmaidstone.co.uk/"},{"@type":"ListItem","position":2,"name":"FAQ","item":"https://dryliningmaidstone.co.uk/faq/"},{"@type":"ListItem","position":3,"name":"Do I need planning permission for dry lining?","item":"https://dryliningmaidstone.co.uk/drylining-faq/do-i-need-planning-permission-for-dry-lining/"}]}]};
---

<Layout
  title={`${question} | Drylining Maidstone`}
  description={description}
  canonical={canonical}
  schema={schema}
>
  <!-- HERO — matches new site design: dark navy gradient + yellow accent + breadcrumb + badge + H1 + CTAs -->
  <section style="position:relative;min-height:380px;display:flex;align-items:center;background:linear-gradient(135deg,#0a0e1a 0%,#1a1f3a 100%);overflow:hidden;">
    <img src="/images/maidstone-town.jpg" alt="Maidstone town centre — backdrop for the Drylining Maidstone FAQ" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.20;" />
    <div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(10,14,26,0.88) 0%,rgba(26,31,58,0.88) 100%);"></div>
    <div class="container" style="position:relative;z-index:1;">
      <nav style="font-size:0.75rem;color:rgba(255,255,255,0.6);margin-bottom:1.25rem;">
        <a href="/" style="color:#FACC15;">HOME</a> / <a href="/faq/" style="color:#FACC15;">FAQ</a> / <span style="color:#FACC15;font-weight:600;">{question.slice(0, 60)}{question.length > 60 ? "…" : ""}</span>
      </nav>
      <span style="display:inline-block;padding:0.375rem 1rem;background:rgba(30,64,175,0.15);border:1px solid #FACC15;color:#FACC15;font-size:0.75rem;font-weight:700;letter-spacing:0.05em;border-radius:99px;margin-bottom:1.25rem;">MAIDSTONE DRYLINING FAQ</span>
      <h1 style="font-size:clamp(1.75rem,4vw,3rem);font-weight:800;color:var(--white);line-height:1.15;margin-bottom:1rem;max-width:48rem;">{question}</h1>
      <p style="font-size:1.0625rem;color:rgba(255,255,255,0.85);margin-bottom:1.5rem;max-width:42rem;">Maidstone-specific answer with current 2026 pricing, building regulations, HMO licensing rules and practical advice from our local team.</p>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;">
        <a href="/get-quote/" class="btn btn-highlight">Get My Free Quote</a>
        <a href="/faq/" class="btn btn-outline" style="color:var(--white);border-color:rgba(255,255,255,0.3);">All FAQs</a>
      </div>
    </div>
  </section>

  <main class="container" style="padding:3rem 1.5rem 4rem;">
    <article class="card" style="padding:2rem;max-width:880px;">
      <div style="background:rgba(30,64,175,0.05);border-left:4px solid #FACC15;padding:1rem 1.5rem;margin-bottom:1.75rem;border-radius:0 8px 8px 0;">
        <p style="margin:0;font-size:0.875rem;color:var(--text);text-transform:uppercase;letter-spacing:0.05em;font-weight:700;">Quick Answer</p>
        <p style="margin:0.5rem 0 0;font-size:1.0625rem;color:var(--text);line-height:1.7;font-weight:500;">{description}</p>
      </div>

      <div class="faq-answer" style="font-size:1.0625rem;line-height:1.85;color:var(--text);">
  <p style="margin:0 0 1.1rem;color:var(--text);line-height:1.8;">Almost never for normal internal dry lining. Internal wall and ceiling finishing is permitted development under the Town and Country Planning (General Permitted Development) (England) Order, so Maidstone Borough Council planning department is not involved. The three exceptions worth knowing:</p>
  <ul style="list-style:disc;padding-left:1.5rem;margin:0 0 1.25rem;color:var(--text);">
    <li style="margin-bottom:0.45rem;line-height:1.75;">Listed buildings: any internal alteration that affects character — even a re-skim on a protected ceiling — needs listed-building consent before work starts. Maidstone has a number of listed interiors in the town centre heritage area and parts of Boxley village</li>
    <li style="margin-bottom:0.45rem;line-height:1.75;">External-facing work: anything that changes how the building looks from the outside (external render systems, EWI, replacing soffit boards) is planning territory, not just building control</li>
    <li style="margin-bottom:0.45rem;line-height:1.75;">Change of use: converting a house (Use Class C3) to an HMO (sui generis) triggers the Maidstone Article 4 Direction — see our dedicated HMO licensing FAQs</li>
  </ul>
  <p style="margin:0 0 1.1rem;color:var(--text);line-height:1.8;">What does involve Maidstone Borough Council Building Control, even when planning is not needed:</p>
  <ul style="list-style:disc;padding-left:1.5rem;margin:0 0 1.25rem;color:var(--text);">
    <li style="margin-bottom:0.45rem;line-height:1.75;">Part A (Structure): removing or modifying a load-bearing wall, even partially</li>
    <li style="margin-bottom:0.45rem;line-height:1.75;">Part B (Fire Safety): new fire-rated partitions, escape routes, garage-to-house separations</li>
    <li style="margin-bottom:0.45rem;line-height:1.75;">Part E (Resistance to Sound): new walls or significant upgrades between flats, between bedsits in an HMO, or between a house and an attached garage converted to a room</li>
    <li style="margin-bottom:0.45rem;line-height:1.75;">Part L (Conservation of fuel and power): thermal upgrades that change the U-value of an external wall — the typical 50–80mm insulated plasterboard on a Victorian terrace is a notifiable change</li>
    <li style="margin-bottom:0.45rem;line-height:1.75;">Part C (Dampness): where work affects an existing DPC or introduces a new one</li>
    <li style="margin-bottom:0.45rem;line-height:1.75;">Part F (Ventilation): where work reduces background ventilation, common in retrofit insulation schemes</li>
  </ul>
  <p style="margin:0 0 1.1rem;color:var(--text);line-height:1.8;">For notifiable work, we file the Building Control application on your behalf and arrange the inspections (typically a pre-plasterboard check and a completion inspection). For non-notifiable work, we still build to BS 8212 best practice but no formal sign-off is needed.</p>
      </div>

      {has_pricing && (
        <div style="margin-top:2rem;padding:1.25rem 1.5rem;background:#fef3c7;border-left:4px solid #f59e0b;border-radius:0 8px 8px 0;">
          <p style="margin:0;font-size:0.875rem;font-weight:700;color:#92400e;text-transform:uppercase;letter-spacing:0.05em;">Pricing & figures — read this</p>
          <p style="margin:0.5rem 0 0;font-size:0.9375rem;color:#78350f;line-height:1.7;">Any prices, fees or figure-based guidance on this page are indicative and intended for budget planning only. They are not a quote and not a substitute for the published source. For current fees always check: <strong>Maidstone Borough Council Building Control fee schedule</strong>, <strong>Maidstone Borough Council HMO licensing fees</strong>, <strong>BCIS construction cost indices</strong>, and the <strong>current Approved Documents</strong> (free PDFs from GOV.UK). Send us your plans and we will turn around a fixed-price written quote within 48 hours.</p>
        </div>
      )}

      <div style="margin-top:2.5rem;padding:1.5rem;background:var(--accent);border-radius:var(--radius);">
        <h3 style="font-size:1.25rem;font-weight:700;color:var(--secondary);margin-bottom:0.75rem;">Need a quote for this in Maidstone?</h3>
        <p style="color:var(--text);margin-bottom:1.25rem;font-size:1rem;">Send a brief, your plans or just a few photos. We will turn around a fixed-price quote within 48 hours, anywhere across ME14–ME20, TN12 and TN27 postcodes.</p>
        <div style="display:flex;gap:0.75rem;flex-wrap:wrap;">
          <a href="/get-quote/" class="btn btn-primary">Get My Free Quote</a>
          <a href="/contact/" class="btn btn-outline">Contact Us</a>
        </div>
      </div>
    </article>

    <aside style="max-width:880px;margin-top:2rem;padding:1.5rem;background:var(--white);border:1px solid var(--border);border-radius:var(--radius);">
      <h3 style="font-size:1.125rem;font-weight:700;color:var(--text);margin-bottom:1rem;">Related Questions</h3>
      <ul style="list-style:none;padding:0;margin:0;display:grid;gap:0.625rem;">
            <li><a href="/drylining-faq/what-is-dry-lining-and-how-does-it-work/" style="color:var(--primary);font-weight:500;">What is dry lining and how does it work?</a></li>
            <li><a href="/drylining-faq/how-much-does-dry-lining-cost-in-maidstone/" style="color:var(--primary);font-weight:500;">How much does dry lining cost in Maidstone?</a></li>
            <li><a href="/drylining-faq/is-dry-lining-cheaper-than-traditional-plastering/" style="color:var(--primary);font-weight:500;">Is dry lining cheaper than traditional plastering?</a></li>
      </ul>
      <p style="margin-top:1.25rem;font-size:0.9375rem;color:var(--text-light);"><a href="/faq/" style="color:var(--primary);font-weight:600;">Browse all 41 FAQs →</a></p>
    </aside>
  </main>
</Layout>
