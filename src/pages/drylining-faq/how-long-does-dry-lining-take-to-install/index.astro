---
import Layout from "../../../layouts/Layout.astro";

const question = "How long does dry lining take to install?";
const answer = `Typical Maidstone installation times for September 2026:

- Single room (walls + ceiling, ~12-20 m²): 2-3 days install + 1-2 days jointing/skim
- Three-bed terrace (whole house, ~80-120 m² wall area): 5-8 working days
- Maidstone town centre apartment (full re-line, 60-80 m²): 4-6 days
- Commercial office fit-out (200 m²): 1-2 weeks
- Large commercial (500-1,000 m²): 2-4 weeks
- HMO conversion (4-6 bed): 1-2 weeks

Programme depends on access (lift availability in Maidstone town centre tower blocks can be a constraint), plasterboard delivery (next-day from Travis Perkins or CCF Maidstone), and any required electrical/plumbing first-fix.

We provide a written programme with every quote.`;
const description = `Typical Maidstone installation times for September 2026:  - Single room (walls + ceiling, ~12-20 m²): 2-3 days install + 1-2 days jointing/skim - Three-bed terrac`;
const canonical = "/drylining-faq/how-long-does-dry-lining-take-to-install/";

const schema = {"@context": "https://schema.org", "@graph": [{"@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "How long does dry lining take to install?", "acceptedAnswer": {"@type": "Answer", "text": "Typical Maidstone installation times for September 2026:\n\n- Single room (walls + ceiling, ~12-20 m²): 2-3 days install + 1-2 days jointing/skim\n- Three-bed terrace (whole house, ~80-120 m² wall area): 5-8 working days\n- Maidstone town centre apartment (full re-line, 60-80 m²): 4-6 days\n- Commercial office fit-out (200 m²): 1-2 weeks\n- Large commercial (500-1,000 m²): 2-4 weeks\n- HMO conversion (4-6 bed): 1-2 weeks\n\nProgramme depends on access (lift availability in Maidstone town centre tower blocks can be a constraint), plasterboard delivery (next-day from Travis Perkins or CCF Maidstone), and any required electrical/plumbing first-fix.\n\nWe provide a written programme with every quote."}}]}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://dryliningmaidstone.co.uk/"}, {"@type": "ListItem", "position": 2, "name": "FAQ", "item": "https://dryliningmaidstone.co.uk/faq/"}, {"@type": "ListItem", "position": 3, "name": "How long does dry lining take to install?", "item": "https://dryliningmaidstone.co.uk/drylining-faq/how-long-does-dry-lining-take-to-install/"}]}]};---

<Layout
  title={question + " | Drylining Maidstone"}
  description={description}
  canonical={canonical}
  schema={schema}
>
  <main class="container" style="padding: 34px 0 70px;">
    <article class="card" style="padding: 28px; max-width: 860px;">
      <header style="margin-bottom: 22px;">
        <p style="margin: 0 0 10px; color: var(--primary); font-weight: 700; letter-spacing: 0.02em; text-transform: uppercase; font-size: 13px;">
          Maidstone Drylining FAQ
        </p>
        <h1 style="margin: 0; font-size: clamp(26px, 4vw, 36px); line-height: 1.15;">{question}</h1>
      </header>

      <section style="padding: 18px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); margin-bottom: 22px;">
        <p style="margin: 0 0 1rem; font-size: 1.0625rem; line-height: 1.8; color: var(--text);">Typical Maidstone installation times for September 2026:</p>
<p style="margin: 0 0 1rem; font-size: 1.0625rem; line-height: 1.8; color: var(--text);">- Single room (walls + ceiling, ~12-20 m²): 2-3 days install + 1-2 days jointing/skim
- Three-bed terrace (whole house, ~80-120 m² wall area): 5-8 working days
- Maidstone town centre apartment (full re-line, 60-80 m²): 4-6 days
- Commercial office fit-out (200 m²): 1-2 weeks
- Large commercial (500-1,000 m²): 2-4 weeks
- HMO conversion (4-6 bed): 1-2 weeks</p>
<p style="margin: 0 0 1rem; font-size: 1.0625rem; line-height: 1.8; color: var(--text);">Programme depends on access (lift availability in Maidstone town centre tower blocks can be a constraint), plasterboard delivery (next-day from Travis Perkins or CCF Maidstone), and any required electrical/plumbing first-fix.</p>
<p style="margin: 0 0 1rem; font-size: 1.0625rem; line-height: 1.8; color: var(--text);">We provide a written programme with every quote.</p>
      </section>

      <section style="margin: 24px 0; padding: 18px 0; border-top: 1px solid var(--border);">
        <h3 style="font-size: 1.1rem; margin-bottom: 12px; color: var(--text);">Related Questions</h3>
        <ul style="list-style: none; padding: 0; margin: 0;">
<li><a href="/drylining-faq/can-dry-lining-improve-wall-insulation/" style="color: var(--primary); font-weight: 500;">How much does dry lining cost in Maidstone?</a></li>
<li><a href="/drylining-faq/is-dry-lining-suitable-for-commercial-properties/" style="color: var(--primary); font-weight: 500;">Is dry lining suitable for commercial?</a></li>
<li><a href="/services/drylining-contractors/" style="color: var(--primary); font-weight: 500;">Our services</a></li>
        </ul>
      </section>

      <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-top: 24px;">
        <a href="/faq/" class="btn btn-outline">All FAQs</a>
        <a href="/get-quote/" class="btn btn-primary">Get a Quote</a>
      </div>
    </article>
  </main>
</Layout>
