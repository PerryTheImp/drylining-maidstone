---
import Layout from "../../../layouts/Layout.astro";

const question = "What is a dry liner job?";
const answer = "A dry liner job is the role of a tradesperson who fixes plasterboard (drywall) to interior walls and ceilings — the modern UK alternative to a wet plasterer. The work covers: measuring and cutting boards, fixing them with adhesive dabs or by screwing to a metal stud frame, taping and jointing the seams, and finishing to a paint-ready surface. A dry liner job also includes reading drawings, working to building regulations (BS 8212 workmanship, Part E acoustics, Part F ventilation, Part L thermal), and coordinating with electricians and plumbers on first-fix services.\n\nIn Maidstone, dry liner jobs span period terrace re-lines in Bearsted and Loose, new-build apartment fit-outs at Lockmeadow and the riverside, commercial offices on the A229 ring road, retail shells at Fremlin Walk, and HMO conversions across ME14–ME18. A typical domestic dry liner job takes 3–5 days for a 3-bed terrace; a commercial office fit-out runs 2–6 weeks.\n\nDaily rate: £180–£220 per dry liner in Maidstone (2026), or £90–£110 per m² for fully-supplied and installed plasterboard on a standard domestic re-line. Subcontract day rates sit 10–15% below for sole-traders without their own insurance.\n\nA dry liner job is a recognised trade in the UK construction sector. There is no statutory NVQ requirement to call yourself a dry liner, but most reputable Maidstone dry lining firms hold:\n\n- CSCS card (Construction Skills Certification Scheme) — mandatory for site access on most UK construction projects\n- NVQ Level 2 in Interior Systems (Dry Lining) — the industry-standard qualification\n- CITB SMSTS or SSSTS for site supervisors\n- £1M+ public liability insurance\n\nDry liner jobs are physically demanding (full-day standing, lifting 25–35 kg boards, overhead work for ceilings) and pay roughly 10–15% above general labouring in the South East, reflecting the skill and responsibility.\n\nMost dry liner jobs in Maidstone are run by small owner-operator firms of 1–4 people rather than large nationals. If you are hiring a dry liner, look for: CSCS cards on arrival, examples of recent Maidstone work (Bearsted, Loose, town centre, riverside), a fixed-price quote that names the board manufacturer and fix method, and a written warranty on completion.";
const description = "A dry liner job is the role of a tradesperson who fixes plasterboard (drywall) to interior walls and ceilings — the modern UK alternative to a wet plasterer. Covers duties, qualifications (CSCS, NVQ L2), daily rates (2026: £180–£220 in Maidstone), and what to look for when hiring.";
const canonical = "/drylining-faq/what-is-a-dry-liner-job/";

const schema = {"@context":"https://schema.org","@graph":[{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is a dry liner job?","acceptedAnswer":{"@type":"Answer","text":"A dry liner job is the role of a tradesperson who fixes plasterboard (drywall) to interior walls and ceilings — the modern UK alternative to a wet plasterer. The work covers: measuring and cutting boards, fixing them with adhesive dabs or by screwing to a metal stud frame, taping and jointing the seams, and finishing to a paint-ready surface. A dry liner job also includes reading drawings, working to building regulations (BS 8212 workmanship, Part E acoustics, Part F ventilation, Part L thermal), and coordinating with electricians and plumbers on first-fix services. In Maidstone, dry liner jobs span period terrace re-lines in Bearsted and Loose, new-build apartment fit-outs at Lockmeadow and the riverside, commercial offices on the A229 ring road, retail shells at Fremlin Walk, and HMO conversions across ME14–ME18. A typical domestic dry liner job takes 3–5 days for a 3-bed terrace; a commercial office fit-out runs 2–6 weeks. Daily rate: £180–£220 per dry liner in Maidstone (2026), or £90–£110 per m² for fully-supplied and installed plasterboard on a standard domestic re-line. Subcontract day rates sit 10–15% below for sole-traders without their own insurance. A dry liner job is a recognised trade in the UK construction sector. There is no statutory NVQ requirement to call yourself a dry liner, but most reputable Maidstone dry lining firms hold: CSCS card (Construction Skills Certification Scheme) — mandatory for site access on most UK construction projects; NVQ Level 2 in Interior Systems (Dry Lining) — the industry-standard qualification; CITB SMSTS or SSSTS for site supervisors; £1M+ public liability insurance. Dry liner jobs are physically demanding (full-day standing, lifting 25–35 kg boards, overhead work for ceilings) and pay roughly 10–15% above general labouring in the South East, reflecting the skill and responsibility. Most dry liner jobs in Maidstone are run by small owner-operator firms of 1–4 people rather than large nationals. If you are hiring a dry liner, look for: CSCS cards on arrival, examples of recent Maidstone work (Bearsted, Loose, town centre, riverside), a fixed-price quote that names the board manufacturer and fix method, and a written warranty on completion."}}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://www.dryliningmaidstone.co.uk/"},{"@type":"ListItem","position":2,"name":"FAQ","item":"https://www.dryliningmaidstone.co.uk/faq/"},{"@type":"ListItem","position":3,"name":"What is a dry liner job?","item":"https://www.dryliningmaidstone.co.uk/drylining-faq/what-is-a-dry-liner-job/"}]}]};
---

<Layout
  title={`${question} | Drylining Maidstone`}
  description={description}
  canonical={canonical}
  schema={schema}
>
  <!-- HERO — matches new site design: dark navy gradient + yellow accent + breadcrumb + badge + H1 + CTAs -->
  <section style="position:relative;min-height:380px;display:flex;align-items:center;background:linear-gradient(135deg,#0a0e1a 0%,#1a1f3a 100%);overflow:hidden;">
    <img src="/images/maidstone-town.jpg" alt="Maidstone town centre — backdrop for the Drylining Maidstone FAQ" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.20;"  width="1200" height="800" loading="lazy" decoding="async" />
    <div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(10,14,26,0.88) 0%,rgba(26,31,58,0.88) 100%);"></div>
    <div class="container" style="position:relative;z-index:1;">
      <nav style="font-size:0.75rem;color:rgba(255,255,255,0.6);margin-bottom:1.25rem;">
        <a href="/" style="color:#FACC15;">HOME</a> / <a href="/faq/" style="color:#FACC15;">FAQ</a> / <span style="color:#FACC15;font-weight:600;">{question.slice(0, 60)}{question.length > 60 ? "…" : ""}</span>
      </nav>
      <span style="display:inline-block;padding:0.375rem 1rem;background:rgba(30,64,175,0.15);border:1px solid #FACC15;color:#FACC15;font-size:0.75rem;font-weight:700;letter-spacing:0.05em;border-radius:99px;margin-bottom:1.25rem;">MAIDSTONE DRYLINING FAQ</span>
      <h1 style="font-size:clamp(1.75rem,4vw,3rem);font-weight:800;color:var(--white);line-height:1.15;margin-bottom:1rem;max-width:48rem;">{question}</h1>
      <p style="font-size:1.0625rem;color:rgba(255,255,255,0.85);margin-bottom:1.5rem;max-width:42rem;">Maidstone-specific answer with current 2026 pricing, building regulations, dry liner qualifications and practical advice from our local team.</p>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;">
        <a href="/get-quote/" class="btn btn-highlight">Get My Free Quote</a>
        <a href="/faq/" class="btn btn-outline" style="color:var(--white);border-color:rgba(255,255,255,0.3);">All FAQs</a>
      </div>
    </div>
  </section>

  <main class="container" style="padding:3rem 1.5rem 4rem;">
    <article class="card" style="padding:2rem;max-width:880px;">
      <div style="background:rgba(30,64,175,0.05);border-left:4px solid #FACC15;padding:1rem 1.5rem;margin-bottom:1.75rem;border-radius:0 8px 8px 0;">
        <p style="margin:0;font-size:0.875rem;color:var(--text);text-transform:uppercase;letter-spacing:0.05em;font-weight:700;">Quick Answer</p>
        <p style="margin:0.5rem 0 0;font-size:1.0625rem;color:var(--text);line-height:1.7;font-weight:500;">{description}</p>
      </div>

      <div class="faq-answer" style="font-size:1.0625rem;line-height:1.85;color:var(--text);">
  <p style="margin:0 0 1.1rem;color:var(--text);line-height:1.8;">A dry liner job is the role of a tradesperson who fixes plasterboard (drywall) to interior walls and ceilings — the modern UK alternative to a wet plasterer. The work covers: measuring and cutting boards, fixing them with adhesive dabs or by screwing to a metal stud frame, taping and jointing the seams, and finishing to a paint-ready surface. A dry liner job also includes reading drawings, working to building regulations (BS 8212 workmanship, Part E acoustics, Part F ventilation, Part L thermal), and coordinating with electricians and plumbers on first-fix services.</p>
  <p style="margin:0 0 1.1rem;color:var(--text);line-height:1.8;">In Maidstone, dry liner jobs span period terrace re-lines in Bearsted and Loose, new-build apartment fit-outs at Lockmeadow and the riverside, commercial offices on the A229 ring road, retail shells at Fremlin Walk, and HMO conversions across ME14–ME18. A typical domestic dry liner job takes 3–5 days for a 3-bed terrace; a commercial office fit-out runs 2–6 weeks.</p>
  <p style="margin:0 0 1.1rem;color:var(--text);line-height:1.8;">Daily rate: £180–£220 per dry liner in Maidstone (2026), or £90–£110 per m² for fully-supplied and installed plasterboard on a standard domestic re-line. Subcontract day rates sit 10–15% below for sole-traders without their own insurance.</p>
  <p style="margin:0 0 1.1rem;color:var(--text);line-height:1.8;">A dry liner job is a recognised trade in the UK construction sector. There is no statutory NVQ requirement to call yourself a dry liner, but most reputable Maidstone dry lining firms hold:</p>
  <ul style="margin:0 0 1.1rem 1.5rem;color:var(--text);line-height:1.8;">
    <li>CSCS card (Construction Skills Certification Scheme) — mandatory for site access on most UK construction projects</li>
    <li>NVQ Level 2 in Interior Systems (Dry Lining) — the industry-standard qualification</li>
    <li>CITB SMSTS or SSSTS for site supervisors</li>
    <li>£1M+ public liability insurance</li>
  </ul>
  <p style="margin:0 0 1.1rem;color:var(--text);line-height:1.8;">Dry liner jobs are physically demanding (full-day standing, lifting 25–35 kg boards, overhead work for ceilings) and pay roughly 10–15% above general labouring in the South East, reflecting the skill and responsibility.</p>
  <p style="margin:0 0 1.1rem;color:var(--text);line-height:1.8;">Most dry liner jobs in Maidstone are run by small owner-operator firms of 1–4 people rather than large nationals. If you are hiring a dry liner, look for: CSCS cards on arrival, examples of recent Maidstone work (Bearsted, Loose, town centre, riverside), a fixed-price quote that names the board manufacturer and fix method, and a written warranty on completion.</p>
      </div>

      <div style="margin-top:2.5rem;padding:1.5rem;background:var(--accent);border-radius:var(--radius);">
        <h3 style="font-size:1.25rem;font-weight:700;color:var(--secondary);margin-bottom:0.75rem;">Need a quote for this in Maidstone?</h3>
        <p style="color:var(--text);margin-bottom:1.25rem;font-size:1rem;">Send a brief, your plans or just a few photos. We will turn around a fixed-price quote within 48 hours, anywhere across ME14–ME20, TN12 and TN27 postcodes.</p>
        <div style="display:flex;gap:0.75rem;flex-wrap:wrap;">
          <a href="/get-quote/" class="btn btn-primary">Get My Free Quote</a>
          <a href="/contact/" class="btn btn-outline">Contact Us</a>
        </div>
      </div>
    </article>

    <aside style="max-width:880px;margin-top:2rem;padding:1.5rem;background:var(--white);border:1px solid var(--border);border-radius:var(--radius);">
      <h3 style="font-size:1.125rem;font-weight:700;color:var(--text);margin-bottom:1rem;">Related Questions</h3>
      <ul style="list-style:none;padding:0;margin:0;display:grid;gap:0.625rem;">
        <li><a href="/drylining-faq/what-is-dry-lining-and-how-does-it-work/" style="color:var(--primary);font-weight:500;">What is dry lining and how does it work?</a></li>
        <li><a href="/drylining-faq/what-is-the-difference-between-dry-lining-and-plastering/" style="color:var(--primary);font-weight:500;">What is the difference between dry lining and plastering?</a></li>
        <li><a href="/drylining-faq/how-much-do-dry-liners-charge-per-day/" style="color:var(--primary);font-weight:500;">How much do dry liners charge per day?</a></li>
        <li><a href="/drylining-faq/how-much-does-dry-lining-cost-in-maidstone/" style="color:var(--primary);font-weight:500;">How much does dry lining cost in Maidstone?</a></li>
      </ul>
      <p style="margin-top:1.25rem;font-size:0.9375rem;color:var(--text-light);"><a href="/faq/" style="color:var(--primary);font-weight:600;">Browse all 42 FAQs →</a></p>
    </aside>
  </main>
</Layout>
