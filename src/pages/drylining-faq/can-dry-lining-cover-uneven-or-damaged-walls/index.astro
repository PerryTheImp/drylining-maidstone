---
import Layout from "../../../layouts/Layout.astro";

const question = "Can dry lining cover uneven or damaged walls?";
const answer = `Yes. Independent metal stud framing can create a perfectly flat, even surface over the most uneven or damaged masonry. This is the standard approach for:

- Severely out-of-true Victorian brickwork (common in Maidstone central and Bearsted)
- Walls with old plaster that has blown or detached
- Walls where dot-and-dab adhesive would not bond reliably
- Walls requiring services cavity for new electrical or plumbing runs

Independent stud adds 50-100mm to the wall thickness but is the most reliable way to get a perfect finish. We can also use resilient bar or acoustic clips to decouple the new plasterboard from the existing structure for improved sound insulation — relevant for Maidstone town centre apartments, Maidstone riverside studios, and HMO conversions.`;
const description = `Yes. Independent metal stud framing can create a perfectly flat, even surface over the most uneven or damaged masonry. This is the standard approach for:  - Sev`;
const canonical = "/drylining-faq/can-dry-lining-cover-uneven-or-damaged-walls/";

const schema = {"@context": "https://schema.org", "@graph": [{"@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Can dry lining cover uneven or damaged walls?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. Independent metal stud framing can create a perfectly flat, even surface over the most uneven or damaged masonry. This is the standard approach for:\n\n- Severely out-of-true Victorian brickwork (common in Maidstone central and Bearsted)\n- Walls with old plaster that has blown or detached\n- Walls where dot-and-dab adhesive would not bond reliably\n- Walls requiring services cavity for new electrical or plumbing runs\n\nIndependent stud adds 50-100mm to the wall thickness but is the most reliable way to get a perfect finish. We can also use resilient bar or acoustic clips to decouple the new plasterboard from the existing structure for improved sound insulation — relevant for Maidstone town centre apartments, Maidstone riverside studios, and HMO conversions."}}]}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://dryliningmaidstone.co.uk/"}, {"@type": "ListItem", "position": 2, "name": "FAQ", "item": "https://dryliningmaidstone.co.uk/faq/"}, {"@type": "ListItem", "position": 3, "name": "Can dry lining cover uneven or damaged walls?", "item": "https://dryliningmaidstone.co.uk/drylining-faq/can-dry-lining-cover-uneven-or-damaged-walls/"}]}]};---

<Layout
  title={question + " | Drylining Maidstone"}
  description={description}
  canonical={canonical}
  schema={schema}
>
  <main class="container" style="padding: 34px 0 70px;">
    <article class="card" style="padding: 28px; max-width: 860px;">
      <header style="margin-bottom: 22px;">
        <p style="margin: 0 0 10px; color: var(--primary); font-weight: 700; letter-spacing: 0.02em; text-transform: uppercase; font-size: 13px;">
          Maidstone Drylining FAQ
        </p>
        <h1 style="margin: 0; font-size: clamp(26px, 4vw, 36px); line-height: 1.15;">{question}</h1>
      </header>

      <section style="padding: 18px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); margin-bottom: 22px;">
        <p style="margin: 0 0 1rem; font-size: 1.0625rem; line-height: 1.8; color: var(--text);">Yes. Independent metal stud framing can create a perfectly flat, even surface over the most uneven or damaged masonry. This is the standard approach for:</p>
<p style="margin: 0 0 1rem; font-size: 1.0625rem; line-height: 1.8; color: var(--text);">- Severely out-of-true Victorian brickwork (common in Maidstone central and Bearsted)
- Walls with old plaster that has blown or detached
- Walls where dot-and-dab adhesive would not bond reliably
- Walls requiring services cavity for new electrical or plumbing runs</p>
<p style="margin: 0 0 1rem; font-size: 1.0625rem; line-height: 1.8; color: var(--text);">Independent stud adds 50-100mm to the wall thickness but is the most reliable way to get a perfect finish. We can also use resilient bar or acoustic clips to decouple the new plasterboard from the existing structure for improved sound insulation — relevant for Maidstone town centre apartments, Maidstone riverside studios, and HMO conversions.</p>
