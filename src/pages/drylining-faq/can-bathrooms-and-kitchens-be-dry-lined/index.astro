---
import Layout from "../../../layouts/Layout.astro";

const question = "Can bathrooms and kitchens be dry lined?";
const answer = `Yes, but with the right board specification. Standard plasterboard is not suitable for wet areas; moisture-resistant (MR) or tilebacker boards must be used.

Recommended specifications for Maidstone bathrooms and kitchens:

- Moisture-resistant plasterboard (Type H to BS EN 520) for areas with occasional moisture exposure (kitchens, utility rooms)
- Cement-based tilebacker board (e.g. HardieBacker, Knauf AquaPanel) for showers, wet rooms, and around baths
- 15mm MR plasterboard for tile backing in family bathrooms
- Vapour-control layer on the warm side of any insulation
- Mechanical extract ventilation to Building Regulations Part F (typically 15 l/s for bathrooms, 30 l/s for kitchens)

Maidstone Building Control will sign off bathroom and kitchen drylining only where the appropriate board has been used. We handle this as standard and specify the right board for each zone of the room.`;
const description = `Yes, but with the right board specification. Standard plasterboard is not suitable for wet areas; moisture-resistant (MR) or tilebacker boards must be used.  Re`;
const canonical = "/drylining-faq/can-bathrooms-and-kitchens-be-dry-lined/";

const schema = {"@context": "https://schema.org", "@graph": [{"@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Can bathrooms and kitchens be dry lined?", "acceptedAnswer": {"@type": "Answer", "text": "Yes, but with the right board specification. Standard plasterboard is not suitable for wet areas; moisture-resistant (MR) or tilebacker boards must be used.\n\nRecommended specifications for Maidstone bathrooms and kitchens:\n\n- Moisture-resistant plasterboard (Type H to BS EN 520) for areas with occasional moisture exposure (kitchens, utility rooms)\n- Cement-based tilebacker board (e.g. HardieBacker, Knauf AquaPanel) for showers, wet rooms, and around baths\n- 15mm MR plasterboard for tile backing in family bathrooms\n- Vapour-control layer on the warm side of any insulation\n- Mechanical extract ventilation to Building Regulations Part F (typically 15 l/s for bathrooms, 30 l/s for kitchens)\n\nMaidstone Building Control will sign off bathroom and kitchen drylining only where the appropriate board has been used. We handle this as standard and specify the right board for each zone of the room."}}]}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://dryliningmaidstone.co.uk/"}, {"@type": "ListItem", "position": 2, "name": "FAQ", "item": "https://dryliningmaidstone.co.uk/faq/"}, {"@type": "ListItem", "position": 3, "name": "Can bathrooms and kitchens be dry lined?", "item": "https://dryliningmaidstone.co.uk/drylining-faq/can-bathrooms-and-kitchens-be-dry-lined/"}]}]};---

<Layout
  title={question + " | Drylining Maidstone"}
  description={description}
  canonical={canonical}
  schema={schema}
>
  <main class="container" style="padding: 34px 0 70px;">
    <article class="card" style="padding: 28px; max-width: 860px;">
      <header style="margin-bottom: 22px;">
        <p style="margin: 0 0 10px; color: var(--primary); font-weight: 700; letter-spacing: 0.02em; text-transform: uppercase; font-size: 13px;">
          Maidstone Drylining FAQ
        </p>
        <h1 style="margin: 0; font-size: clamp(26px, 4vw, 36px); line-height: 1.15;">{question}</h1>
      </header>

      <section style="padding: 18px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); margin-bottom: 22px;">
        <p style="margin: 0 0 1rem; font-size: 1.0625rem; line-height: 1.8; color: var(--text);">Yes, but with the right board specification. Standard plasterboard is not suitable for wet areas; moisture-resistant (MR) or tilebacker boards must be used.</p>
<p style="margin: 0 0 1rem; font-size: 1.0625rem; line-height: 1.8; color: var(--text);">Recommended specifications for Maidstone bathrooms and kitchens:</p>
<p style="margin: 0 0 1rem; font-size: 1.0625rem; line-height: 1.8; color: var(--text);">- Moisture-resistant plasterboard (Type H to BS EN 520) for areas with occasional moisture exposure (kitchens, utility rooms)
- Cement-based tilebacker board (e.g. HardieBacker, Knauf AquaPanel) for showers, wet rooms, and around baths
- 15mm MR plasterboard for tile backing in family bathrooms
- Vapour-control layer on the warm side of any insulation
- Mechanical extract ventilation to Building Regulations Part F (typically 15 l/s for bathrooms, 30 l/s for kitchens)</p>
<p style="margin: 0 0 1rem; font-size: 1.0625rem; line-height: 1.8; color: var(--text);">Maidstone Building Control will sign off bathroom and kitchen drylining only where the appropriate board has been used. We handle this as standard and specify the right board for each zone of the room.</p>
      </section>

      <section style="margin: 24px 0; padding: 18px 0; border-top: 1px solid var(--border);">
        <h3 style="font-size: 1.1rem; margin-bottom: 12px; color: var(--text);">Related Questions</h3>
        <ul style="list-style: none; padding: 0; margin: 0;">
<li><a href="/drylining-faq/can-dry-lining-be-used-on-damp-walls/" style="color: var(--primary); font-weight: 500;">Can dry lining be used on damp walls?</a></li>
<li><a href="/drylining-faq/does-dry-lining-help-prevent-condensation/" style="color: var(--primary); font-weight: 500;">Does dry lining help prevent condensation?</a></li>
<li><a href="/services/plasterboard-installation/" style="color: var(--primary); font-weight: 500;">Plasterboard installation service</a></li>
        </ul>
      </section>

      <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-top: 24px;">
        <a href="/faq/" class="btn btn-outline">All FAQs</a>
        <a href="/get-quote/" class="btn btn-primary">Get a Quote</a>
      </div>
    </article>
  </main>
</Layout>
