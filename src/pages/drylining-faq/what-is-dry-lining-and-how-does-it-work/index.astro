---
import Layout from "../../../layouts/Layout.astro";

const question = "What is dry lining and how does it work?";
const answer = "Dry lining is a method of finishing internal walls and ceilings with pre-formed plasterboard sheets rather than applying several coats of wet plaster to the masonry. Plasterboard is fixed either directly to brick or blockwork with dabs of drywall adhesive (the dot-and-dab method), or screwed to a timber or metal stud frame that is itself independent of the wall. Joints and screw heads are sealed with scrim tape and jointing compound, producing a flat surface that can be decorated directly or finished with a thin plaster skim.\n\nIn Maidstone, dry lining is the standard approach for new-build apartments at Maidstone town centre, commercial fit-outs in Maidstone riverside, the Victorian terraces in Maidstone central, Bearsted and Loose, and post-war semis in Boxley, East Farleigh, Harrietsham, Allington and Headcorn. The service cavity behind the board is used to run electrical cables, plumbing, ventilation, and insulation.\n\nBritish Standard BS 8212 governs drylining and partitioning in the UK, and plasterboard itself is manufactured to BS EN 520. We install to these standards on every Maidstone project.";
const description = "Dry lining is a method of finishing internal walls and ceilings with pre-formed plasterboard sheets rather than applying several coats of wet plaster to the masonry.";
const canonical = "/drylining-faq/what-is-dry-lining-and-how-does-it-work/";

const schema = {"@context":"https://schema.org","@graph":[{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is dry lining and how does it work?","acceptedAnswer":{"@type":"Answer","text":"Dry lining is a method of finishing internal walls and ceilings with pre-formed plasterboard sheets rather than applying several coats of wet plaster to the masonry. Plasterboard is fixed either directly to brick or blockwork with dabs of drywall adhesive (the dot-and-dab method), or screwed to a timber or metal stud frame that is itself independent of the wall. Joints and screw heads are sealed with scrim tape and jointing compound, producing a flat surface that can be decorated directly or finished with a thin plaster skim.  In Maidstone, dry lining is the standard approach for new-build apartments at Maidstone town centre, commercial fit-outs in Maidstone riverside, the Victorian terraces in Maidstone central, Bearsted and Loose, and post-war semis in Boxley, East Farleigh, Harrietsham, Allington and Headcorn. The service cavity behind the board is used to run electrical cables, plumbing, ventilation, and insulation.  British Standard BS 8212 governs drylining and partitioning in the UK, and plasterboard itself is manufactured to BS EN 520. We install to these standards on every Maidstone project."}}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://dryliningmaidstone.co.uk/"},{"@type":"ListItem","position":2,"name":"FAQ","item":"https://dryliningmaidstone.co.uk/faq/"},{"@type":"ListItem","position":3,"name":"What is dry lining and how does it work?","item":"https://dryliningmaidstone.co.uk/drylining-faq/what-is-dry-lining-and-how-does-it-work/"}]}]};
---

<Layout
  title={`${question} | Drylining Maidstone`}
  description={description}
  canonical={canonical}
  schema={schema}
>
  <!-- HERO — matches new site design: dark navy gradient + yellow accent + breadcrumb + badge + H1 + CTAs -->
  <section style="position:relative;min-height:380px;display:flex;align-items:center;background:linear-gradient(135deg,#0a0e1a 0%,#1a1f3a 100%);overflow:hidden;">
    <img src="/images/maidstone-town.jpg" alt="Maidstone town centre — backdrop for the Drylining Maidstone FAQ" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.20;" />
    <div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(10,14,26,0.88) 0%,rgba(26,31,58,0.88) 100%);"></div>
    <div class="container" style="position:relative;z-index:1;">
      <nav style="font-size:0.75rem;color:rgba(255,255,255,0.6);margin-bottom:1.25rem;">
        <a href="/" style="color:#FACC15;">HOME</a> / <a href="/faq/" style="color:#FACC15;">FAQ</a> / <span style="color:#FACC15;font-weight:600;">{question.slice(0, 60)}{question.length > 60 ? "…" : ""}</span>
      </nav>
      <span style="display:inline-block;padding:0.375rem 1rem;background:rgba(30,64,175,0.15);border:1px solid #FACC15;color:#FACC15;font-size:0.75rem;font-weight:700;letter-spacing:0.05em;border-radius:99px;margin-bottom:1.25rem;">MAIDSTONE DRYLINING FAQ</span>
      <h1 style="font-size:clamp(1.75rem,4vw,3rem);font-weight:800;color:var(--white);line-height:1.15;margin-bottom:1rem;max-width:48rem;">{question}</h1>
      <p style="font-size:1.0625rem;color:rgba(255,255,255,0.85);margin-bottom:1.5rem;max-width:42rem;">Maidstone-specific answer with current 2026 pricing, building regulations, HMO licensing rules and practical advice from our local team.</p>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;">
        <a href="/get-quote/" class="btn btn-highlight">Get My Free Quote</a>
        <a href="/faq/" class="btn btn-outline" style="color:var(--white);border-color:rgba(255,255,255,0.3);">All FAQs</a>
      </div>
    </div>
  </section>

  <main class="container" style="padding:3rem 1.5rem 4rem;">
    <article class="card" style="padding:2rem;max-width:880px;">
      <div style="background:rgba(30,64,175,0.05);border-left:4px solid #FACC15;padding:1rem 1.5rem;margin-bottom:1.75rem;border-radius:0 8px 8px 0;">
        <p style="margin:0;font-size:0.875rem;color:var(--text);text-transform:uppercase;letter-spacing:0.05em;font-weight:700;">Quick Answer</p>
        <p style="margin:0.5rem 0 0;font-size:1.0625rem;color:var(--text);line-height:1.7;font-weight:500;">{description}</p>
      </div>

      <div class="faq-answer" style="font-size:1.0625rem;line-height:1.85;color:var(--text);">
  <p style="margin:0 0 1.1rem;color:var(--text);line-height:1.8;">Dry lining is a method of finishing internal walls and ceilings with pre-formed plasterboard sheets rather than applying several coats of wet plaster to the masonry. Plasterboard is fixed either directly to brick or blockwork with dabs of drywall adhesive (the dot-and-dab method), or screwed to a timber or metal stud frame that is itself independent of the wall. Joints and screw heads are sealed with scrim tape and jointing compound, producing a flat surface that can be decorated directly or finished with a thin plaster skim.</p>
  <p style="margin:0 0 1.1rem;color:var(--text);line-height:1.8;">In Maidstone, dry lining is the standard approach for new-build apartments at Maidstone town centre, commercial fit-outs in Maidstone riverside, the Victorian terraces in Maidstone central, Bearsted and Loose, and post-war semis in Boxley, East Farleigh, Harrietsham, Allington and Headcorn. The service cavity behind the board is used to run electrical cables, plumbing, ventilation, and insulation.</p>
  <p style="margin:0 0 1.1rem;color:var(--text);line-height:1.8;">British Standard BS 8212 governs drylining and partitioning in the UK, and plasterboard itself is manufactured to BS EN 520. We install to these standards on every Maidstone project.</p>
      </div>

      <div style="margin-top:2.5rem;padding:1.5rem;background:var(--accent);border-radius:var(--radius);">
        <h3 style="font-size:1.25rem;font-weight:700;color:var(--secondary);margin-bottom:0.75rem;">Need a quote for this in Maidstone?</h3>
        <p style="color:var(--text);margin-bottom:1.25rem;font-size:1rem;">Send a brief, your plans or just a few photos. We will turn around a fixed-price quote within 48 hours, anywhere across ME14–ME20, TN12 and TN27 postcodes.</p>
        <div style="display:flex;gap:0.75rem;flex-wrap:wrap;">
          <a href="/get-quote/" class="btn btn-primary">Get My Free Quote</a>
          <a href="/contact/" class="btn btn-outline">Contact Us</a>
        </div>
      </div>
    </article>

    <aside style="max-width:880px;margin-top:2rem;padding:1.5rem;background:var(--white);border:1px solid var(--border);border-radius:var(--radius);">
      <h3 style="font-size:1.125rem;font-weight:700;color:var(--text);margin-bottom:1rem;">Related Questions</h3>
      <ul style="list-style:none;padding:0;margin:0;display:grid;gap:0.625rem;">
            <li><a href="/drylining-faq/how-much-does-dry-lining-cost-in-maidstone/" style="color:var(--primary);font-weight:500;">How much does dry lining cost in Maidstone?</a></li>
            <li><a href="/drylining-faq/is-dry-lining-cheaper-than-traditional-plastering/" style="color:var(--primary);font-weight:500;">Is dry lining cheaper than traditional plastering?</a></li>
            <li><a href="/drylining-faq/how-long-does-dry-lining-take-to-install/" style="color:var(--primary);font-weight:500;">How long does dry lining take to install?</a></li>
      </ul>
      <p style="margin-top:1.25rem;font-size:0.9375rem;color:var(--text-light);"><a href="/faq/" style="color:var(--primary);font-weight:600;">Browse all 41 FAQs →</a></p>
    </aside>
  </main>
</Layout>
