---
import Layout from "../../../layouts/Layout.astro";

const question = "What should I ask a dry lining company before hiring them?";
const answer = "Key questions to put to any Maidstone drylining contractor:\n\n1. Are your operatives CSCS-accredited, and can I see current cards?\n2. What is your public liability insurance limit, and can I see the certificate?\n3. Will you provide a written itemised quote, with labour, materials, plant, and waste removal broken out?\n4. What is the programme, what happens if you overrun, and is delay damages in the contract?\n5. Do you handle Building Control notification with Maidstone Borough Council, or do I need to do that?\n6. What guarantee do you offer on workmanship? (12 months minimum, longer for fire-rated)\n7. Can you provide references for comparable projects in Maidstone — ideally in my part of the borough?\n8. Are you VAT registered, and is the quote VAT-inclusive?\n9. What payment terms do you require? (We ask for staged payments, never more than 30% upfront)\n10. Will you provide a completion certificate and warranty documentation on handover?\n\nIf any contractor refuses to answer these in writing, walk away.";
const description = "Key questions to put to any Maidstone drylining contractor: 1.";
const canonical = "/drylining-faq/what-should-i-ask-a-dry-lining-company-before-hiring-them/";
const has_pricing = false;

const schema = {"@context":"https://schema.org","@graph":[{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What should I ask a dry lining company before hiring them?","acceptedAnswer":{"@type":"Answer","text":"Key questions to put to any Maidstone drylining contractor:  1. Are your operatives CSCS-accredited, and can I see current cards? 2. What is your public liability insurance limit, and can I see the certificate? 3. Will you provide a written itemised quote, with labour, materials, plant, and waste removal broken out? 4. What is the programme, what happens if you overrun, and is delay damages in the contract? 5. Do you handle Building Control notification with Maidstone Borough Council, or do I need to do that? 6. What guarantee do you offer on workmanship? (12 months minimum, longer for fire-rated) 7. Can you provide references for comparable projects in Maidstone — ideally in my part of the borough? 8. Are you VAT registered, and is the quote VAT-inclusive? 9. What payment terms do you require? (We ask for staged payments, never more than 30% upfront) 10. Will you provide a completion certificate and warranty documentation on handover?  If any contractor refuses to answer these in writing, walk away."}}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://dryliningmaidstone.co.uk/"},{"@type":"ListItem","position":2,"name":"FAQ","item":"https://dryliningmaidstone.co.uk/faq/"},{"@type":"ListItem","position":3,"name":"What should I ask a dry lining company before hiring them?","item":"https://dryliningmaidstone.co.uk/drylining-faq/what-should-i-ask-a-dry-lining-company-before-hiring-them/"}]}]};
---

<Layout
  title={`${question} | Drylining Maidstone`}
  description={description}
  canonical={canonical}
  schema={schema}
>
  <!-- HERO — matches new site design: dark navy gradient + yellow accent + breadcrumb + badge + H1 + CTAs -->
  <section style="position:relative;min-height:380px;display:flex;align-items:center;background:linear-gradient(135deg,#0a0e1a 0%,#1a1f3a 100%);overflow:hidden;">
    <img src="/images/maidstone-town.jpg" alt="Maidstone town centre — backdrop for the Drylining Maidstone FAQ" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.20;" />
    <div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(10,14,26,0.88) 0%,rgba(26,31,58,0.88) 100%);"></div>
    <div class="container" style="position:relative;z-index:1;">
      <nav style="font-size:0.75rem;color:rgba(255,255,255,0.6);margin-bottom:1.25rem;">
        <a href="/" style="color:#FACC15;">HOME</a> / <a href="/faq/" style="color:#FACC15;">FAQ</a> / <span style="color:#FACC15;font-weight:600;">{question.slice(0, 60)}{question.length > 60 ? "…" : ""}</span>
      </nav>
      <span style="display:inline-block;padding:0.375rem 1rem;background:rgba(30,64,175,0.15);border:1px solid #FACC15;color:#FACC15;font-size:0.75rem;font-weight:700;letter-spacing:0.05em;border-radius:99px;margin-bottom:1.25rem;">MAIDSTONE DRYLINING FAQ</span>
      <h1 style="font-size:clamp(1.75rem,4vw,3rem);font-weight:800;color:var(--white);line-height:1.15;margin-bottom:1rem;max-width:48rem;">{question}</h1>
      <p style="font-size:1.0625rem;color:rgba(255,255,255,0.85);margin-bottom:1.5rem;max-width:42rem;">Maidstone-specific answer with current 2026 pricing, building regulations, HMO licensing rules and practical advice from our local team.</p>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;">
        <a href="/get-quote/" class="btn btn-highlight">Get My Free Quote</a>
        <a href="/faq/" class="btn btn-outline" style="color:var(--white);border-color:rgba(255,255,255,0.3);">All FAQs</a>
      </div>
    </div>
  </section>

  <main class="container" style="padding:3rem 1.5rem 4rem;">
    <article class="card" style="padding:2rem;max-width:880px;">
      <div style="background:rgba(30,64,175,0.05);border-left:4px solid #FACC15;padding:1rem 1.5rem;margin-bottom:1.75rem;border-radius:0 8px 8px 0;">
        <p style="margin:0;font-size:0.875rem;color:var(--text);text-transform:uppercase;letter-spacing:0.05em;font-weight:700;">Quick Answer</p>
        <p style="margin:0.5rem 0 0;font-size:1.0625rem;color:var(--text);line-height:1.7;font-weight:500;">{description}</p>
      </div>

      <div class="faq-answer" style="font-size:1.0625rem;line-height:1.85;color:var(--text);">
  <p style="margin:0 0 1.1rem;color:var(--text);line-height:1.8;">Key questions to put to any Maidstone drylining contractor:</p>
  <ol style="list-style:decimal;padding-left:1.5rem;margin:0 0 1.25rem;color:var(--text);">
    <li style="margin-bottom:0.45rem;line-height:1.75;">Are your operatives CSCS-accredited, and can I see current cards?</li>
    <li style="margin-bottom:0.45rem;line-height:1.75;">What is your public liability insurance limit, and can I see the certificate?</li>
    <li style="margin-bottom:0.45rem;line-height:1.75;">Will you provide a written itemised quote, with labour, materials, plant, and waste removal broken out?</li>
    <li style="margin-bottom:0.45rem;line-height:1.75;">What is the programme, what happens if you overrun, and is delay damages in the contract?</li>
    <li style="margin-bottom:0.45rem;line-height:1.75;">Do you handle Building Control notification with Maidstone Borough Council, or do I need to do that?</li>
    <li style="margin-bottom:0.45rem;line-height:1.75;">What guarantee do you offer on workmanship? (12 months minimum, longer for fire-rated)</li>
    <li style="margin-bottom:0.45rem;line-height:1.75;">Can you provide references for comparable projects in Maidstone — ideally in my part of the borough?</li>
    <li style="margin-bottom:0.45rem;line-height:1.75;">Are you VAT registered, and is the quote VAT-inclusive?</li>
    <li style="margin-bottom:0.45rem;line-height:1.75;">What payment terms do you require? (We ask for staged payments, never more than 30% upfront)</li>
    <li style="margin-bottom:0.45rem;line-height:1.75;">Will you provide a completion certificate and warranty documentation on handover?</li>
  </ol>
  <p style="margin:0 0 1.1rem;color:var(--text);line-height:1.8;">If any contractor refuses to answer these in writing, walk away.</p>
      </div>

      {has_pricing && (
        <div style="margin-top:2rem;padding:1.25rem 1.5rem;background:#fef3c7;border-left:4px solid #f59e0b;border-radius:0 8px 8px 0;">
          <p style="margin:0;font-size:0.875rem;font-weight:700;color:#92400e;text-transform:uppercase;letter-spacing:0.05em;">Pricing & figures — read this</p>
          <p style="margin:0.5rem 0 0;font-size:0.9375rem;color:#78350f;line-height:1.7;">Any prices, fees or figure-based guidance on this page are indicative and intended for budget planning only. They are not a quote and not a substitute for the published source. For current fees always check: <strong>Maidstone Borough Council Building Control fee schedule</strong>, <strong>Maidstone Borough Council HMO licensing fees</strong>, <strong>BCIS construction cost indices</strong>, and the <strong>current Approved Documents</strong> (free PDFs from GOV.UK). Send us your plans and we will turn around a fixed-price written quote within 48 hours.</p>
        </div>
      )}

      <div style="margin-top:2.5rem;padding:1.5rem;background:var(--accent);border-radius:var(--radius);">
        <h3 style="font-size:1.25rem;font-weight:700;color:var(--secondary);margin-bottom:0.75rem;">Need a quote for this in Maidstone?</h3>
        <p style="color:var(--text);margin-bottom:1.25rem;font-size:1rem;">Send a brief, your plans or just a few photos. We will turn around a fixed-price quote within 48 hours, anywhere across ME14–ME20, TN12 and TN27 postcodes.</p>
        <div style="display:flex;gap:0.75rem;flex-wrap:wrap;">
          <a href="/get-quote/" class="btn btn-primary">Get My Free Quote</a>
          <a href="/contact/" class="btn btn-outline">Contact Us</a>
        </div>
      </div>
    </article>

    <aside style="max-width:880px;margin-top:2rem;padding:1.5rem;background:var(--white);border:1px solid var(--border);border-radius:var(--radius);">
      <h3 style="font-size:1.125rem;font-weight:700;color:var(--text);margin-bottom:1rem;">Related Questions</h3>
      <ul style="list-style:none;padding:0;margin:0;display:grid;gap:0.625rem;">
            <li><a href="/drylining-faq/what-is-dry-lining-and-how-does-it-work/" style="color:var(--primary);font-weight:500;">What is dry lining and how does it work?</a></li>
            <li><a href="/drylining-faq/how-much-does-dry-lining-cost-in-maidstone/" style="color:var(--primary);font-weight:500;">How much does dry lining cost in Maidstone?</a></li>
            <li><a href="/drylining-faq/is-dry-lining-cheaper-than-traditional-plastering/" style="color:var(--primary);font-weight:500;">Is dry lining cheaper than traditional plastering?</a></li>
      </ul>
      <p style="margin-top:1.25rem;font-size:0.9375rem;color:var(--text-light);"><a href="/faq/" style="color:var(--primary);font-weight:600;">Browse all 41 FAQs →</a></p>
    </aside>
  </main>
</Layout>
