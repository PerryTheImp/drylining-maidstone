---
import Layout from "../../../layouts/Layout.astro";

const question = "Does dry lining help prevent condensation?";
const answer = "Yes. Insulated plasterboard with a vapour-control layer keeps the internal wall surface above the dew point, preventing condensation, mould, and mildew. This is particularly important in Maidstone's older housing stock — Victorian terraces in Maidstone central, Bearsted and Loose, and pre-1930s semis in Boxley and East Farleigh — where solid 9-inch brick walls are prone to cold-surface condensation.\n\nWhere condensation is a known issue, we install:\n\n- Insulated plasterboard (PIR or phenolic, 50-80mm) to raise internal surface temperature\n- Vapour-control layer (polyethylene sheet or foil-back board) on the warm side of the insulation\n- Positive input ventilation (PIV) or mechanical extract in kitchens and bathrooms (coordinated with your electrician)\n\nThis is also a standard retrofit measure under ECO4 and GBIS funding schemes for eligible Maidstone properties.";
const description = "Yes.";
const canonical = "/drylining-faq/does-dry-lining-help-prevent-condensation/";

const schema = {"@context":"https://schema.org","@graph":[{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Does dry lining help prevent condensation?","acceptedAnswer":{"@type":"Answer","text":"Yes. Insulated plasterboard with a vapour-control layer keeps the internal wall surface above the dew point, preventing condensation, mould, and mildew. This is particularly important in Maidstone's older housing stock — Victorian terraces in Maidstone central, Bearsted and Loose, and pre-1930s semis in Boxley and East Farleigh — where solid 9-inch brick walls are prone to cold-surface condensation.  Where condensation is a known issue, we install:  - Insulated plasterboard (PIR or phenolic, 50-80mm) to raise internal surface temperature - Vapour-control layer (polyethylene sheet or foil-back board) on the warm side of the insulation - Positive input ventilation (PIV) or mechanical extract in kitchens and bathrooms (coordinated with your electrician)  This is also a standard retrofit measure under ECO4 and GBIS funding schemes for eligible Maidstone properties."}}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://dryliningmaidstone.co.uk/"},{"@type":"ListItem","position":2,"name":"FAQ","item":"https://dryliningmaidstone.co.uk/faq/"},{"@type":"ListItem","position":3,"name":"Does dry lining help prevent condensation?","item":"https://dryliningmaidstone.co.uk/drylining-faq/does-dry-lining-help-prevent-condensation/"}]}]};
---

<Layout
  title={`${question} | Drylining Maidstone`}
  description={description}
  canonical={canonical}
  schema={schema}
>
  <!-- HERO — matches new site design: dark navy gradient + yellow accent + breadcrumb + badge + H1 + CTAs -->
  <section style="position:relative;min-height:380px;display:flex;align-items:center;background:linear-gradient(135deg,#0a0e1a 0%,#1a1f3a 100%);overflow:hidden;">
    <img src="/images/maidstone-town.jpg" alt="Maidstone town centre — backdrop for the Drylining Maidstone FAQ" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.20;" />
    <div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(10,14,26,0.88) 0%,rgba(26,31,58,0.88) 100%);"></div>
    <div class="container" style="position:relative;z-index:1;">
      <nav style="font-size:0.75rem;color:rgba(255,255,255,0.6);margin-bottom:1.25rem;">
        <a href="/" style="color:#FACC15;">HOME</a> / <a href="/faq/" style="color:#FACC15;">FAQ</a> / <span style="color:#FACC15;font-weight:600;">{question.slice(0, 60)}{question.length > 60 ? "…" : ""}</span>
      </nav>
      <span style="display:inline-block;padding:0.375rem 1rem;background:rgba(30,64,175,0.15);border:1px solid #FACC15;color:#FACC15;font-size:0.75rem;font-weight:700;letter-spacing:0.05em;border-radius:99px;margin-bottom:1.25rem;">MAIDSTONE DRYLINING FAQ</span>
      <h1 style="font-size:clamp(1.75rem,4vw,3rem);font-weight:800;color:var(--white);line-height:1.15;margin-bottom:1rem;max-width:48rem;">{question}</h1>
      <p style="font-size:1.0625rem;color:rgba(255,255,255,0.85);margin-bottom:1.5rem;max-width:42rem;">Maidstone-specific answer with current 2026 pricing, building regulations, HMO licensing rules and practical advice from our local team.</p>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;">
        <a href="/get-quote/" class="btn btn-highlight">Get My Free Quote</a>
        <a href="/faq/" class="btn btn-outline" style="color:var(--white);border-color:rgba(255,255,255,0.3);">All FAQs</a>
      </div>
    </div>
  </section>

  <main class="container" style="padding:3rem 1.5rem 4rem;">
    <article class="card" style="padding:2rem;max-width:880px;">
      <div style="background:rgba(30,64,175,0.05);border-left:4px solid #FACC15;padding:1rem 1.5rem;margin-bottom:1.75rem;border-radius:0 8px 8px 0;">
        <p style="margin:0;font-size:0.875rem;color:var(--text);text-transform:uppercase;letter-spacing:0.05em;font-weight:700;">Quick Answer</p>
        <p style="margin:0.5rem 0 0;font-size:1.0625rem;color:var(--text);line-height:1.7;font-weight:500;">{description}</p>
      </div>

      <div class="faq-answer" style="font-size:1.0625rem;line-height:1.85;color:var(--text);">
  <p style="margin:0 0 1.1rem;color:var(--text);line-height:1.8;">Yes. Insulated plasterboard with a vapour-control layer keeps the internal wall surface above the dew point, preventing condensation, mould, and mildew. This is particularly important in Maidstone's older housing stock — Victorian terraces in Maidstone central, Bearsted and Loose, and pre-1930s semis in Boxley and East Farleigh — where solid 9-inch brick walls are prone to cold-surface condensation.</p>
  <p style="margin:0 0 1.1rem;color:var(--text);line-height:1.8;">Where condensation is a known issue, we install:</p>
  <ul style="list-style:disc;padding-left:1.5rem;margin:0 0 1.25rem;color:var(--text);">
    <li style="margin-bottom:0.45rem;line-height:1.75;">Insulated plasterboard (PIR or phenolic, 50-80mm) to raise internal surface temperature</li>
    <li style="margin-bottom:0.45rem;line-height:1.75;">Vapour-control layer (polyethylene sheet or foil-back board) on the warm side of the insulation</li>
    <li style="margin-bottom:0.45rem;line-height:1.75;">Positive input ventilation (PIV) or mechanical extract in kitchens and bathrooms (coordinated with your electrician)</li>
  </ul>
  <p style="margin:0 0 1.1rem;color:var(--text);line-height:1.8;">This is also a standard retrofit measure under ECO4 and GBIS funding schemes for eligible Maidstone properties.</p>
      </div>

      <div style="margin-top:2.5rem;padding:1.5rem;background:var(--accent);border-radius:var(--radius);">
        <h3 style="font-size:1.25rem;font-weight:700;color:var(--secondary);margin-bottom:0.75rem;">Need a quote for this in Maidstone?</h3>
        <p style="color:var(--text);margin-bottom:1.25rem;font-size:1rem;">Send a brief, your plans or just a few photos. We will turn around a fixed-price quote within 48 hours, anywhere across ME14–ME20, TN12 and TN27 postcodes.</p>
        <div style="display:flex;gap:0.75rem;flex-wrap:wrap;">
          <a href="/get-quote/" class="btn btn-primary">Get My Free Quote</a>
          <a href="/contact/" class="btn btn-outline">Contact Us</a>
        </div>
      </div>
    </article>

    <aside style="max-width:880px;margin-top:2rem;padding:1.5rem;background:var(--white);border:1px solid var(--border);border-radius:var(--radius);">
      <h3 style="font-size:1.125rem;font-weight:700;color:var(--text);margin-bottom:1rem;">Related Questions</h3>
      <ul style="list-style:none;padding:0;margin:0;display:grid;gap:0.625rem;">
            <li><a href="/drylining-faq/what-is-dry-lining-and-how-does-it-work/" style="color:var(--primary);font-weight:500;">What is dry lining and how does it work?</a></li>
            <li><a href="/drylining-faq/how-much-does-dry-lining-cost-in-maidstone/" style="color:var(--primary);font-weight:500;">How much does dry lining cost in Maidstone?</a></li>
            <li><a href="/drylining-faq/is-dry-lining-cheaper-than-traditional-plastering/" style="color:var(--primary);font-weight:500;">Is dry lining cheaper than traditional plastering?</a></li>
      </ul>
      <p style="margin-top:1.25rem;font-size:0.9375rem;color:var(--text-light);"><a href="/faq/" style="color:var(--primary);font-weight:600;">Browse all 41 FAQs →</a></p>
    </aside>
  </main>
</Layout>
