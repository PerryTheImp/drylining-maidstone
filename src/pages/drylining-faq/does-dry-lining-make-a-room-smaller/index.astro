---
import Layout from "../../../layouts/Layout.astro";

const question = "Does dry lining make a room smaller?";
const answer = `Slightly, yes. Typical build-up additions:

- Dot-and-dab on solid walls: +30-50mm
- Independent metal stud (single layer): +75-100mm
- Independent metal stud (double layer acoustic): +150-200mm

For most Maidstone rooms this is negligible. Where space is critical (small bathrooms, ensuite conversions in Maidstone town centre apartments, narrow Victorian hallways), we use thinner boards and direct mechanical fix to minimise the loss. The thinnest practical drylining system is 9.5mm plasterboard on a 22mm metal track — adding about 30mm in total.

The trade-off is usually worth it: the energy efficiency, acoustic, and finish gains from a properly dry-lined wall almost always outweigh the small room loss.`;
const description = `Slightly, yes. Typical build-up additions:  - Dot-and-dab on solid walls: +30-50mm - Independent metal stud (single layer): +75-100mm - Independent metal stud (`;
const canonical = "/drylining-faq/does-dry-lining-make-a-room-smaller/";

const schema = {"@context": "https://schema.org", "@graph": [{"@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Does dry lining make a room smaller?", "acceptedAnswer": {"@type": "Answer", "text": "Slightly, yes. Typical build-up additions:\n\n- Dot-and-dab on solid walls: +30-50mm\n- Independent metal stud (single layer): +75-100mm\n- Independent metal stud (double layer acoustic): +150-200mm\n\nFor most Maidstone rooms this is negligible. Where space is critical (small bathrooms, ensuite conversions in Maidstone town centre apartments, narrow Victorian hallways), we use thinner boards and direct mechanical fix to minimise the loss. The thinnest practical drylining system is 9.5mm plasterboard on a 22mm metal track — adding about 30mm in total.\n\nThe trade-off is usually worth it: the energy efficiency, acoustic, and finish gains from a properly dry-lined wall almost always outweigh the small room loss."}}]}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://dryliningmaidstone.co.uk/"}, {"@type": "ListItem", "position": 2, "name": "FAQ", "item": "https://dryliningmaidstone.co.uk/faq/"}, {"@type": "ListItem", "position": 3, "name": "Does dry lining make a room smaller?", "item": "https://dryliningmaidstone.co.uk/drylining-faq/does-dry-lining-make-a-room-smaller/"}]}]};---

<Layout
  title={question + " | Drylining Maidstone"}
  description={description}
  canonical={canonical}
  schema={schema}
>
  <main class="container" style="padding: 34px 0 70px;">
    <article class="card" style="padding: 28px; max-width: 860px;">
      <header style="margin-bottom: 22px;">
        <p style="margin: 0 0 10px; color: var(--primary); font-weight: 700; letter-spacing: 0.02em; text-transform: uppercase; font-size: 13px;">
          Maidstone Drylining FAQ
        </p>
        <h1 style="margin: 0; font-size: clamp(26px, 4vw, 36px); line-height: 1.15;">{question}</h1>
      </header>

      <section style="padding: 18px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); margin-bottom: 22px;">
        <p style="margin: 0 0 1rem; font-size: 1.0625rem; line-height: 1.8; color: var(--text);">Slightly, yes. Typical build-up additions:</p>
<p style="margin: 0 0 1rem; font-size: 1.0625rem; line-height: 1.8; color: var(--text);">- Dot-and-dab on solid walls: +30-50mm
- Independent metal stud (single layer): +75-100mm
- Independent metal stud (double layer acoustic): +150-200mm</p>
<p style="margin: 0 0 1rem; font-size: 1.0625rem; line-height: 1.8; color: var(--text);">For most Maidstone rooms this is negligible. Where space is critical (small bathrooms, ensuite conversions in Maidstone town centre apartments, narrow Victorian hallways), we use thinner boards and direct mechanical fix to minimise the loss. The thinnest practical drylining system is 9.5mm plasterboard on a 22mm metal track — adding about 30mm in total.</p>
<p style="margin: 0 0 1rem; font-size: 1.0625rem; line-height: 1.8; color: var(--text);">The trade-off is usually worth it: the energy efficiency, acoustic, and finish gains from a properly dry-lined wall almost always outweigh the small room loss.</p>
      </section>

      <section style="margin: 24px 0; padding: 18px 0; border-top: 1px solid var(--border);">
        <h3 style="font-size: 1.1rem; margin-bottom: 12px; color: var(--text);">Related Questions</h3>
        <ul style="list-style: none; padding: 0; margin: 0;">
<li><a href="/drylining-faq/how-thick-is-a-drylined-wall/" style="color: var(--primary); font-weight: 500;">How thick is a drylined wall?</a></li>
<li><a href="/drylining-faq/what-is-dot-and-dab-dry-lining/" style="color: var(--primary); font-weight: 500;">What is dot-and-dab dry lining?</a></li>
<li><a href="/drylining-faq/can-dry-lining-cover-uneven-or-damaged-walls/" style="color: var(--primary); font-weight: 500;">Can dry lining cover uneven or damaged walls?</a></li>
        </ul>
      </section>

      <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-top: 24px;">
        <a href="/faq/" class="btn btn-outline">All FAQs</a>
        <a href="/get-quote/" class="btn btn-primary">Get a Quote</a>
      </div>
    </article>
  </main>
</Layout>
