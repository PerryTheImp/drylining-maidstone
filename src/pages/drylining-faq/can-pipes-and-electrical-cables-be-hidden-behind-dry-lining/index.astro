---
import Layout from "../../../layouts/Layout.astro";

const question = "Can pipes and electrical cables be hidden behind dry lining?";
const answer = `Yes. The cavity behind dot-and-dab plasterboard or within a metal stud partition is the standard place to run electrical cables, switch drops, socket wiring, plumbing pipes, and even radiator feeds. This is one of the big advantages of dry lining over wet plaster.

Sequence in a typical Maidstone refit:

1. First-fix electrical: cables run in cavity before boarding
2. First-fix plumbing: pipework run, tested, lagged
3. Plasterboard fixed, leaving access panels where required
4. Second-fix electrical: face plates fitted
5. Jointing and decoration

We coordinate with your electrician and plumber (or provide both as part of a full package). All electrical work is carried out to BS 7671 (the IEE Wiring Regulations) by a registered NICEIC or NAPIT electrician.`;
const description = `Yes. The cavity behind dot-and-dab plasterboard or within a metal stud partition is the standard place to run electrical cables, switch drops, socket wiring, pl`;
const canonical = "/drylining-faq/can-pipes-and-electrical-cables-be-hidden-behind-dry-lining/";

const schema = {"@context": "https://schema.org", "@graph": [{"@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Can pipes and electrical cables be hidden behind dry lining?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. The cavity behind dot-and-dab plasterboard or within a metal stud partition is the standard place to run electrical cables, switch drops, socket wiring, plumbing pipes, and even radiator feeds. This is one of the big advantages of dry lining over wet plaster.\n\nSequence in a typical Maidstone refit:\n\n1. First-fix electrical: cables run in cavity before boarding\n2. First-fix plumbing: pipework run, tested, lagged\n3. Plasterboard fixed, leaving access panels where required\n4. Second-fix electrical: face plates fitted\n5. Jointing and decoration\n\nWe coordinate with your electrician and plumber (or provide both as part of a full package). All electrical work is carried out to BS 7671 (the IEE Wiring Regulations) by a registered NICEIC or NAPIT electrician."}}]}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://dryliningmaidstone.co.uk/"}, {"@type": "ListItem", "position": 2, "name": "FAQ", "item": "https://dryliningmaidstone.co.uk/faq/"}, {"@type": "ListItem", "position": 3, "name": "Can pipes and electrical cables be hidden behind dry lining?", "item": "https://dryliningmaidstone.co.uk/drylining-faq/can-pipes-and-electrical-cables-be-hidden-behind-dry-lining/"}]}]};---

<Layout
  title={question + " | Drylining Maidstone"}
  description={description}
  canonical={canonical}
