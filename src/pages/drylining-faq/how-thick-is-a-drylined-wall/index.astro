---
import Layout from "../../../layouts/Layout.astro";

const question = "How thick is a drylined wall?";
const answer = "Quick rule of thumb by system — board thickness + build-up of the system behind it:\n\n- Dot-and-dab on sound masonry: 30–50mm total (12.5mm board + adhesive)\n- Independent metal stud, single layer both sides: 75–100mm\n- Independent metal stud, double layer both sides for sound: 150–200mm\n- Stud with services cavity (M&E first fix): 100–150mm\n- Acoustic partition to Part E (HMO separating wall): 100–150mm typical\n- Fire-rated 60-min partition (BS 476): roughly 100–150mm\n- Fire-rated 120-min partition: 150–200mm\n\nWhat drives the choice in Maidstone properties:\n\n- Maidstone town centre apartments: every millimetre counts. We use 9.5mm boards on a shallow 50mm stud where headroom and floor area are tight — gains you back roughly 40mm against a default 12.5mm/75mm build-up\n- Victorian terraces in Bearsted, Loose, Staplehurst: the opposite trade-off. We add 50–80mm of insulated plasterboard and accept the room loss in exchange for a 60–80% drop in heat loss through the wall\n- Commercial fit-outs in Maidstone riverside and the Lockmeadow: the partition thickness is set by the acoustic and fire spec first, room geometry second\n\nMeasure your door reveals and stair turnings before deciding. A 100mm partition that won't fit a 90° turn loses you more usable space than the thickness itself.";
const description = "Quick rule of thumb by system — board thickness + build-up of the system behind it: - Dot-and-dab on sound masonry: 30–50mm total (12.5mm board +";
const canonical = "/drylining-faq/how-thick-is-a-drylined-wall/";
const has_pricing = false;

const schema = {"@context":"https://schema.org","@graph":[{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How thick is a drylined wall?","acceptedAnswer":{"@type":"Answer","text":"Quick rule of thumb by system — board thickness + build-up of the system behind it:  - Dot-and-dab on sound masonry: 30–50mm total (12.5mm board + adhesive) - Independent metal stud, single layer both sides: 75–100mm - Independent metal stud, double layer both sides for sound: 150–200mm - Stud with services cavity (M&E first fix): 100–150mm - Acoustic partition to Part E (HMO separating wall): 100–150mm typical - Fire-rated 60-min partition (BS 476): roughly 100–150mm - Fire-rated 120-min partition: 150–200mm  What drives the choice in Maidstone properties:  - Maidstone town centre apartments: every millimetre counts. We use 9.5mm boards on a shallow 50mm stud where headroom and floor area are tight — gains you back roughly 40mm against a default 12.5mm/75mm build-up - Victorian terraces in Bearsted, Loose, Staplehurst: the opposite trade-off. We add 50–80mm of insulated plasterboard and accept the room loss in exchange for a 60–80% drop in heat loss through the wall - Commercial fit-outs in Maidstone riverside and the Lockmeadow: the partition thickness is set by the acoustic and fire spec first, room geometry second  Measure your door reveals and stair turnings before deciding. A 100mm partition that won't fit a 90° turn loses you more usable space than the thickness itself."}}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://dryliningmaidstone.co.uk/"},{"@type":"ListItem","position":2,"name":"FAQ","item":"https://dryliningmaidstone.co.uk/faq/"},{"@type":"ListItem","position":3,"name":"How thick is a drylined wall?","item":"https://dryliningmaidstone.co.uk/drylining-faq/how-thick-is-a-drylined-wall/"}]}]};
---

<Layout
  title={`${question} | Drylining Maidstone`}
  description={description}
  canonical={canonical}
  schema={schema}
>
  <!-- HERO — matches new site design: dark navy gradient + yellow accent + breadcrumb + badge + H1 + CTAs -->
  <section style="position:relative;min-height:380px;display:flex;align-items:center;background:linear-gradient(135deg,#0a0e1a 0%,#1a1f3a 100%);overflow:hidden;">
    <img src="/images/maidstone-town.jpg" alt="Maidstone town centre — backdrop for the Drylining Maidstone FAQ" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.20;" />
    <div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(10,14,26,0.88) 0%,rgba(26,31,58,0.88) 100%);"></div>
    <div class="container" style="position:relative;z-index:1;">
      <nav style="font-size:0.75rem;color:rgba(255,255,255,0.6);margin-bottom:1.25rem;">
        <a href="/" style="color:#FACC15;">HOME</a> / <a href="/faq/" style="color:#FACC15;">FAQ</a> / <span style="color:#FACC15;font-weight:600;">{question.slice(0, 60)}{question.length > 60 ? "…" : ""}</span>
      </nav>
      <span style="display:inline-block;padding:0.375rem 1rem;background:rgba(30,64,175,0.15);border:1px solid #FACC15;color:#FACC15;font-size:0.75rem;font-weight:700;letter-spacing:0.05em;border-radius:99px;margin-bottom:1.25rem;">MAIDSTONE DRYLINING FAQ</span>
      <h1 style="font-size:clamp(1.75rem,4vw,3rem);font-weight:800;color:var(--white);line-height:1.15;margin-bottom:1rem;max-width:48rem;">{question}</h1>
      <p style="font-size:1.0625rem;color:rgba(255,255,255,0.85);margin-bottom:1.5rem;max-width:42rem;">Maidstone-specific answer with current 2026 pricing, building regulations, HMO licensing rules and practical advice from our local team.</p>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;">
        <a href="/get-quote/" class="btn btn-highlight">Get My Free Quote</a>
        <a href="/faq/" class="btn btn-outline" style="color:var(--white);border-color:rgba(255,255,255,0.3);">All FAQs</a>
      </div>
    </div>
  </section>

  <main class="container" style="padding:3rem 1.5rem 4rem;">
    <article class="card" style="padding:2rem;max-width:880px;">
      <div style="background:rgba(30,64,175,0.05);border-left:4px solid #FACC15;padding:1rem 1.5rem;margin-bottom:1.75rem;border-radius:0 8px 8px 0;">
        <p style="margin:0;font-size:0.875rem;color:var(--text);text-transform:uppercase;letter-spacing:0.05em;font-weight:700;">Quick Answer</p>
        <p style="margin:0.5rem 0 0;font-size:1.0625rem;color:var(--text);line-height:1.7;font-weight:500;">{description}</p>
      </div>

      <div class="faq-answer" style="font-size:1.0625rem;line-height:1.85;color:var(--text);">
  <p style="margin:0 0 1.1rem;color:var(--text);line-height:1.8;">Quick rule of thumb by system — board thickness + build-up of the system behind it:</p>
  <ul style="list-style:disc;padding-left:1.5rem;margin:0 0 1.25rem;color:var(--text);">
    <li style="margin-bottom:0.45rem;line-height:1.75;">Dot-and-dab on sound masonry: 30–50mm total (12.5mm board + adhesive)</li>
    <li style="margin-bottom:0.45rem;line-height:1.75;">Independent metal stud, single layer both sides: 75–100mm</li>
    <li style="margin-bottom:0.45rem;line-height:1.75;">Independent metal stud, double layer both sides for sound: 150–200mm</li>
    <li style="margin-bottom:0.45rem;line-height:1.75;">Stud with services cavity (M&E first fix): 100–150mm</li>
    <li style="margin-bottom:0.45rem;line-height:1.75;">Acoustic partition to Part E (HMO separating wall): 100–150mm typical</li>
    <li style="margin-bottom:0.45rem;line-height:1.75;">Fire-rated 60-min partition (BS 476): roughly 100–150mm</li>
    <li style="margin-bottom:0.45rem;line-height:1.75;">Fire-rated 120-min partition: 150–200mm</li>
  </ul>
  <p style="margin:0 0 1.1rem;color:var(--text);line-height:1.8;">What drives the choice in Maidstone properties:</p>
  <ul style="list-style:disc;padding-left:1.5rem;margin:0 0 1.25rem;color:var(--text);">
    <li style="margin-bottom:0.45rem;line-height:1.75;">Maidstone town centre apartments: every millimetre counts. We use 9.5mm boards on a shallow 50mm stud where headroom and floor area are tight — gains you back roughly 40mm against a default 12.5mm/75mm build-up</li>
    <li style="margin-bottom:0.45rem;line-height:1.75;">Victorian terraces in Bearsted, Loose, Staplehurst: the opposite trade-off. We add 50–80mm of insulated plasterboard and accept the room loss in exchange for a 60–80% drop in heat loss through the wall</li>
    <li style="margin-bottom:0.45rem;line-height:1.75;">Commercial fit-outs in Maidstone riverside and the Lockmeadow: the partition thickness is set by the acoustic and fire spec first, room geometry second</li>
  </ul>
  <p style="margin:0 0 1.1rem;color:var(--text);line-height:1.8;">Measure your door reveals and stair turnings before deciding. A 100mm partition that won't fit a 90° turn loses you more usable space than the thickness itself.</p>
      </div>

      {has_pricing && (
        <div style="margin-top:2rem;padding:1.25rem 1.5rem;background:#fef3c7;border-left:4px solid #f59e0b;border-radius:0 8px 8px 0;">
          <p style="margin:0;font-size:0.875rem;font-weight:700;color:#92400e;text-transform:uppercase;letter-spacing:0.05em;">Pricing & figures — read this</p>
          <p style="margin:0.5rem 0 0;font-size:0.9375rem;color:#78350f;line-height:1.7;">Any prices, fees or figure-based guidance on this page are indicative and intended for budget planning only. They are not a quote and not a substitute for the published source. For current fees always check: <strong>Maidstone Borough Council Building Control fee schedule</strong>, <strong>Maidstone Borough Council HMO licensing fees</strong>, <strong>BCIS construction cost indices</strong>, and the <strong>current Approved Documents</strong> (free PDFs from GOV.UK). Send us your plans and we will turn around a fixed-price written quote within 48 hours.</p>
        </div>
      )}

      <div style="margin-top:2.5rem;padding:1.5rem;background:var(--accent);border-radius:var(--radius);">
        <h3 style="font-size:1.25rem;font-weight:700;color:var(--secondary);margin-bottom:0.75rem;">Need a quote for this in Maidstone?</h3>
        <p style="color:var(--text);margin-bottom:1.25rem;font-size:1rem;">Send a brief, your plans or just a few photos. We will turn around a fixed-price quote within 48 hours, anywhere across ME14–ME20, TN12 and TN27 postcodes.</p>
        <div style="display:flex;gap:0.75rem;flex-wrap:wrap;">
          <a href="/get-quote/" class="btn btn-primary">Get My Free Quote</a>
          <a href="/contact/" class="btn btn-outline">Contact Us</a>
        </div>
      </div>
    </article>

    <aside style="max-width:880px;margin-top:2rem;padding:1.5rem;background:var(--white);border:1px solid var(--border);border-radius:var(--radius);">
      <h3 style="font-size:1.125rem;font-weight:700;color:var(--text);margin-bottom:1rem;">Related Questions</h3>
      <ul style="list-style:none;padding:0;margin:0;display:grid;gap:0.625rem;">
            <li><a href="/drylining-faq/what-is-dry-lining-and-how-does-it-work/" style="color:var(--primary);font-weight:500;">What is dry lining and how does it work?</a></li>
            <li><a href="/drylining-faq/how-much-does-dry-lining-cost-in-maidstone/" style="color:var(--primary);font-weight:500;">How much does dry lining cost in Maidstone?</a></li>
            <li><a href="/drylining-faq/is-dry-lining-cheaper-than-traditional-plastering/" style="color:var(--primary);font-weight:500;">Is dry lining cheaper than traditional plastering?</a></li>
      </ul>
      <p style="margin-top:1.25rem;font-size:0.9375rem;color:var(--text-light);"><a href="/faq/" style="color:var(--primary);font-weight:600;">Browse all 41 FAQs →</a></p>
    </aside>
  </main>
</Layout>
