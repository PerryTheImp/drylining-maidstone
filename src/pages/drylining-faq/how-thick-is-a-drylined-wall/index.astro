---
import Layout from "../../../layouts/Layout.astro";

const question = "How thick is a drylined wall?";
const answer = `Thickness depends on the system:

- Dot-and-dab on solid masonry: 30-50mm (plasterboard + adhesive dabs)
- Independent metal stud (single layer each side): 75-100mm
- Independent metal stud (double layer each side, acoustic): 150-200mm
- Metal stud with services cavity for M&E: 100-150mm
- Standard partition with acoustic insulation: 100-150mm
- Fire-rated 60-min partition: typically 100-150mm
- Fire-rated 120-min partition: typically 150-200mm

For Maidstone town centre apartments where space is at a premium, we often use thinner 9.5mm plasterboard on independent stud to keep the cavity minimal. For Maidstone Victorian terraces, the trade-off is usually the other way — we use 50-80mm insulated plasterboard to gain thermal performance, accepting the 30-50mm room loss.`;
const description = `Thickness depends on the system:  - Dot-and-dab on solid masonry: 30-50mm (plasterboard + adhesive dabs) - Independent metal stud (single layer each side): 75-1`;
const canonical = "/drylining-faq/how-thick-is-a-drylined-wall/";

const schema = {"@context": "https://schema.org", "@graph": [{"@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "How thick is a drylined wall?", "acceptedAnswer": {"@type": "Answer", "text": "Thickness depends on the system:\n\n- Dot-and-dab on solid masonry: 30-50mm (plasterboard + adhesive dabs)\n- Independent metal stud (single layer each side): 75-100mm\n- Independent metal stud (double layer each side, acoustic): 150-200mm\n- Metal stud with services cavity for M&E: 100-150mm\n- Standard partition with acoustic insulation: 100-150mm\n- Fire-rated 60-min partition: typically 100-150mm\n- Fire-rated 120-min partition: typically 150-200mm\n\nFor Maidstone town centre apartments where space is at a premium, we often use thinner 9.5mm plasterboard on independent stud to keep the cavity minimal. For Maidstone Victorian terraces, the trade-off is usually the other way — we use 50-80mm insulated plasterboard to gain thermal performance, accepting the 30-50mm room loss."}}]}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://dryliningmaidstone.co.uk/"}, {"@type": "ListItem", "position": 2, "name": "FAQ", "item": "https://dryliningmaidstone.co.uk/faq/"}, {"@type": "ListItem", "position": 3, "name": "How thick is a drylined wall?", "item": "https://dryliningmaidstone.co.uk/drylining-faq/how-thick-is-a-drylined-wall/"}]}]};---

<Layout
  title={question + " | Drylining Maidstone"}
  description={description}
  canonical={canonical}
  schema={schema}
>
  <main class="container" style="padding: 34px 0 70px;">
    <article class="card" style="padding: 28px; max-width: 860px;">
      <header style="margin-bottom: 22px;">
        <p style="margin: 0 0 10px; color: var(--primary); font-weight: 700; letter-spacing: 0.02em; text-transform: uppercase; font-size: 13px;">
          Maidstone Drylining FAQ
        </p>
        <h1 style="margin: 0; font-size: clamp(26px, 4vw, 36px); line-height: 1.15;">{question}</h1>
      </header>

      <section style="padding: 18px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); margin-bottom: 22px;">
        <p style="margin: 0 0 1rem; font-size: 1.0625rem; line-height: 1.8; color: var(--text);">Thickness depends on the system:</p>
<p style="margin: 0 0 1rem; font-size: 1.0625rem; line-height: 1.8; color: var(--text);">- Dot-and-dab on solid masonry: 30-50mm (plasterboard + adhesive dabs)
- Independent metal stud (single layer each side): 75-100mm
- Independent metal stud (double layer each side, acoustic): 150-200mm
- Metal stud with services cavity for M&amp;E: 100-150mm
- Standard partition with acoustic insulation: 100-150mm
- Fire-rated 60-min partition: typically 100-150mm
- Fire-rated 120-min partition: typically 150-200mm</p>
<p style="margin: 0 0 1rem; font-size: 1.0625rem; line-height: 1.8; color: var(--text);">For Maidstone town centre apartments where space is at a premium, we often use thinner 9.5mm plasterboard on independent stud to keep the cavity minimal. For Maidstone Victorian terraces, the trade-off is usually the other way — we use 50-80mm insulated plasterboard to gain thermal performance, accepting the 30-50mm room loss.</p>
      </section>

      <section style="margin: 24px 0; padding: 18px 0; border-top: 1px solid var(--border);">
        <h3 style="font-size: 1.1rem; margin-bottom: 12px; color: var(--text);">Related Questions</h3>
        <ul style="list-style: none; padding: 0; margin: 0;">
<li><a href="/drylining-faq/does-dry-lining-make-a-room-smaller/" style="color: var(--primary); font-weight: 500;">Does dry lining make a room smaller?</a></li>
<li><a href="/drylining-faq/can-dry-lining-improve-wall-insulation/" style="color: var(--primary); font-weight: 500;">Can dry lining improve wall insulation?</a></li>
<li><a href="/drylining-faq/can-dry-lining-improve-soundproofing/" style="color: var(--primary); font-weight: 500;">Can dry lining improve soundproofing?</a></li>
        </ul>
      </section>

      <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-top: 24px;">
        <a href="/faq/" class="btn btn-outline">All FAQs</a>
        <a href="/get-quote/" class="btn btn-primary">Get a Quote</a>
      </div>
    </article>
  </main>
</Layout>
