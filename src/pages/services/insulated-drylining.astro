---
import Layout from "../../layouts/Layout.astro";

const serviceName = "Insulated Drylining";
const serviceSlug = "insulated-drylining";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {"@type":"Question","name":"What is insulated drylining?","acceptedAnswer":{"@type":"Answer","text":"Insulated drylining uses insulated plasterboard — typically PIR, phenolic, or graphite EPS bonded to a plasterboard face — to add thermal insulation and a smooth internal finish in one installation. It is the standard solution for upgrading uninsulated solid walls."}},
    {"@type":"Question","name":"How much heat loss does it reduce?","acceptedAnswer":{"@type":"Answer","text":"Insulated drylining can reduce heat loss through an uninsulated solid wall by 60-80%, depending on the insulation thickness and the wall construction. This typically makes rooms feel noticeably warmer and reduces heating bills."}},
    {"@type":"Question","name":"How thick is insulated drylining?","acceptedAnswer":{"@type":"Answer","text":"Insulated plasterboard is typically 30-90 mm thick total, depending on the required thermal performance. We will specify the correct thickness to meet Part L targets while keeping the room loss to a minimum."}},
    {"@type":"Question","name":"Can it be installed in listed buildings?","acceptedAnswer":{"@type":"Answer","text":"Yes. Insulated drylining is often the preferred thermal upgrade for listed buildings because it does not alter the external appearance. However, it may require listed building consent if it affects significant internal features. We liaise with Maidstone Borough Council conservation officers as needed."}}
  ]
};

