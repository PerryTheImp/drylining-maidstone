---
import Layout from "../../layouts/Layout.astro";

const serviceName = "Suspended Ceilings";
const serviceSlug = "suspended-ceilings";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {"@type":"Question","name":"What is a suspended ceiling?","acceptedAnswer":{"@type":"Answer","text":"A suspended ceiling is a secondary ceiling hung below the main structural ceiling. It creates a clean visual plane, hides services like ductwork and cabling, and allows easy access for maintenance."}},
    {"@type":"Question","name":"How long does suspended ceiling installation take?","acceptedAnswer":{"@type":"Answer","text":"A typical office suspended ceiling takes 2-3 days. Larger commercial spaces may take 4-7 days depending on the area and any integrated services like lighting or air vents."}},
    {"@type":"Question","name":"Can suspended ceilings improve acoustics?","acceptedAnswer":{"@type":"Answer","text":"Yes. Acoustic ceiling tiles absorb sound and reduce noise levels in open-plan offices, meeting rooms, and call centres. We install mineral fibre and perforated metal tiles with NRC ratings up to 0.85 for optimal sound control."}},
    {"@type":"Question","name":"Are suspended ceilings fire-rated?","acceptedAnswer":{"@type":"Answer","text":"Yes. We install fire-rated ceiling systems that meet Part B building regulations. Fire-rated tiles and grid systems provide protection and slow the spread of fire through ceiling voids."}},
    {"@type":"Question","name":"Can you integrate lighting into suspended ceilings?","acceptedAnswer":{"@type":"Answer","text":"Yes. We can integrate LED panels, recessed downlights, emergency lighting, and air conditioning vents into suspended ceiling systems for a seamless, professional finish."}},
    {"@type":"Question","name":"What types of ceiling tiles do you install?","acceptedAnswer":{"@type":"Answer","text":"We install mineral fibre tiles, metal tiles (perforated and plain), plasterboard suspended ceilings, fire-rated tiles, and moisture-resistant tiles for kitchens and bathrooms."}},
    {"@type":"Question","name":"What areas do you cover for suspended ceilings?","acceptedAnswer":{"@type":"Answer","text":"We provide suspended ceiling installation across Maidstone, Maidstone town centre, the High Street, Bearsted, Headcorn, Allington, Harrietsham, Staplehurst, Boxley, Marden, Yalding, and East Farleigh."}}
  ],
};

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Suspended Ceilings Maidstone",
  additionalType: "https://www.wikidata.org/entity/Q175294",
  about: { "@type": "Thing", name: "Dropped ceiling", sameAs: ["https://www.wikidata.org/entity/Q175294", "https://en.wikipedia.org/wiki/Dropped_ceiling"] },
  sameAs: "https://en.wikipedia.org/wiki/Drywall",
  provider: {
    "@type": "Organization",
    name: "Drylining Maidstone",
    "@id": "https://dryliningmaidstone.co.uk/#business",
    knowsAbout: ["https://en.wikipedia.org/wiki/Drywall", "https://en.wikipedia.org/wiki/Plaster", "https://en.wikipedia.org/wiki/Partition_wall", "https://en.wikipedia.org/wiki/Building_regulations_in_the_United_Kingdom", "https://en.wikipedia.org/wiki/Construction_worker", "https://en.wikipedia.org/wiki/General_contractor", "https://en.wikipedia.org/wiki/Cold-formed_steel", "https://en.wikipedia.org/wiki/Dropped_ceiling"],
  },
  areaServed: {
    "@type": "Place",
    name: "Maidstone and surrounding areas",
    sameAs: [
      "https://en.wikipedia.org/wiki/Maidstone",
      "https://www.wikidata.org/entity/Q213180"
    ],
    geo: { "@type": "GeoCoordinates", "latitude": 51.2748, "longitude": 0.5232 }
  },
};
