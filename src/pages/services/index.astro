---
import Layout from "../../layouts/Layout.astro";
import FlipCard from "../../components/FlipCard.astro";

const services = [
  { title: "Drylining Contractors", description: "Expert drylining installation for residential and commercial properties across Maidstone. We create smooth, paint-ready wall finishes quickly and cleanly.", link: "/services/drylining-contractors/" },
  { title: "Partition Walls", description: "Build durable, cost-effective partition walls to divide open-plan offices, retail units, and homes. Sound-rated options available.", link: "/services/partition-walls/" },
  { title: "Metal Stud Partitioning", description: "Lightweight, strong metal stud partitions perfect for commercial fit-outs. Faster to install and easier to modify than traditional timber framing.", link: "/services/metal-stud-partitioning/" },
  { title: "Suspended Ceilings", description: "Install clean, modern suspended ceilings that hide services, improve acoustics, and enhance lighting. Ideal for offices, retail, and healthcare.", link: "/services/suspended-ceilings/" },
  { title: "Plasterboard Installation", description: "Precision plasterboard fitting for walls and ceilings. Seamless joints, professional finishing, and minimal disruption to your project timeline.", link: "/services/plasterboard-installation/" },
  { title: "Taping & Jointing", description: "Smooth, crack-resistant finishes with expert taping and jointing. No need for full plastering — faster, cleaner, and ready for decoration.", link: "/services/taping-and-jointing/" },
  { title: "Commercial Drylining", description: "Large-scale drylining for offices, retail spaces, warehouses, and public buildings. We work to tight deadlines and specifications.", link: "/services/commercial-drylining/" },
  { title: "Office Drylining", description: "Create modern, flexible office interiors with drylined partitions, feature walls, and ceiling systems. Minimal downtime for your business.", link: "/services/office-drylining/" },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "serviceType": "Drylining Services",
      "provider": { "@type": "LocalBusiness", "name": "Drylining Maidstone", "@id": "https://dryliningmaidstone.co.uk/#business" },
      "areaServed": { "@type": "City", "name": "Maidstone", "@id": "https://www.wikidata.org/entity/Q213180", "sameAs": ["https://en.wikipedia.org/wiki/Maidstone", "https://www.wikidata.org/entity/Q213180"], "geo": { "@type": "GeoCoordinates", "latitude": 51.2748, "longitude": 0.5232 } }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://dryliningmaidstone.co.uk/" },
        { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://dryliningmaidstone.co.uk/services/" }
      ]
    }
  ]
};
---

<Layout
  title="Drylining Services Maidstone | Partitions, Ceilings & More"
  description="Full range of drylining services in Maidstone: partition walls, suspended ceilings, metal stud framing, plasterboard, taping & jointing. Free quotes."
  canonical="/services/"
  schema={schema}
>
  <section style="position:relative;min-height:480px;display:flex;align-items:center;background:linear-gradient(135deg,#0a0e1a 0%,#1a1f3a 100%);overflow:hidden;">
    <img src="/images/service-office.jpg" alt="Office drylining and partition wall installation in Maidstone" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.45;">
    <div style="position:absolute;inset:0;background:linear-gradient(90deg,rgba(10,14,26,0.85) 0%,rgba(10,14,26,0.5) 60%,rgba(10,14,26,0.2) 100%);"></div>
    <div class="container" style="position:relative;z-index:1;text-align:center;">
      <nav style="font-size:12px;color:rgba(255,255,255,0.7);margin-bottom:14px;letter-spacing:0.05em;text-transform:uppercase;">
        <a href="/" style="text-decoration:none;color:rgba(255,255,255,0.7);">Home</a> &nbsp;/&nbsp; <span style="color:#FACC15;">Services</span>
      </nav>
      <div style="display:inline-block;background:rgba(30,64,175,0.25);color:#ffffff;padding:0.4rem 1rem;border-radius:9999px;font-size:0.8125rem;font-weight:600;margin-bottom:1.25rem;border:1px solid rgba(250,204,21,0.4);letter-spacing:0.05em;">FULL SERVICE RANGE</div>
      <h1 style="font-size:clamp(2.25rem,5vw,3.75rem);font-weight:800;color:#ffffff;margin-bottom:1rem;line-height:1.05;letter-spacing:-0.02em;">Our <span style="color:#FACC15;">Drylining Services</span></h1>
      <p style="font-size:1.125rem;color:rgba(255,255,255,0.88);max-width:680px;margin:0 auto 1.5rem;line-height:1.65;font-weight:400;">From single-room renovations to full commercial fit-outs, we provide every drylining service you need across <strong style="color:#ffffff;">Maidstone</strong> and the surrounding M-codes.</p>
      <div style="display:flex;gap:0.875rem;justify-content:center;flex-wrap:wrap;">
        <a href="/get-quote/" class="btn btn-highlight" style="font-size:1rem;padding:0.875rem 1.75rem;">Get a Free Quote</a>
        <a href="/areas/" class="btn btn-outline" style="border-color:rgba(255,255,255,0.4);color:#ffffff;font-size:1rem;padding:0.75rem 1.75rem;">View All Areas</a>
      </div>
    </div>
  </section>

  <section class="section" style="background: var(--accent);">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
        {services.map(s => (
          <FlipCard title={s.title} description={s.description} link={s.link} icon={`<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>`} />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container" style="text-align: center;">
      <h2 style="font-size: 2rem; font-weight: 800; color: var(--secondary); margin-bottom: 1rem;">Need a Custom Drylining Solution?</h2>
      <p style="color: var(--text-light); max-width: 600px; margin: 0 auto 2rem; font-size: 1.0625rem;">Every project is different. Tell us what you need and we will tailor our drylining services to fit your budget, timeline, and specifications.</p>
      <a href="/get-quote/" class="btn btn-primary" style="font-size: 1.0625rem; padding: 1rem 2.5rem;">Get Your Free Quote</a>
    </div>
  </section>
</Layout>
