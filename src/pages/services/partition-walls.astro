---
import Layout from "../../layouts/Layout.astro";

const serviceName = "Partition Walls";
const serviceSlug = "partition-walls";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {"@type":"Question","name":"What is a partition wall?","acceptedAnswer":{"@type":"Answer","text":"A partition wall is a non-load-bearing interior wall used to divide open spaces into separate rooms or areas. Partition walls are lightweight, cost-effective, and can be modified or removed in the future."}},
    {"@type":"Question","name":"How much does partition wall installation cost?","acceptedAnswer":{"@type":"Answer","text":"Partition wall costs depend on size, materials, and any acoustic or fire-rating requirements. Single-layer partitions start from around £45-£65 per square metre. We provide free, detailed quotes for every project."}},
    {"@type":"Question","name":"Can partition walls be soundproofed?","acceptedAnswer":{"@type":"Answer","text":"Yes. We install acoustic insulation within the partition cavity and can use double-layer plasterboard with acoustic boards to achieve excellent sound reduction for offices, bedrooms, and meeting rooms."}},
    {"@type":"Question","name":"Are partition walls fire-rated?","acceptedAnswer":{"@type":"Answer","text":"Yes. When combined with fire-rated plasterboard, partition walls can achieve fire ratings from 30 minutes up to 120 minutes, meeting Part B building regulation requirements."}},
    {"@type":"Question","name":"How long does it take to install a partition wall?","acceptedAnswer":{"@type":"Answer","text":"A single partition wall takes 1-2 days. Multiple partitions or complex layouts may take 3-5 days. We provide accurate timelines during your quote."}},
    {"@type":"Question","name":"Can partition walls include doors and windows?","acceptedAnswer":{"@type":"Answer","text":"Yes. We can integrate standard and fire-rated doors, glazing panels, and sliding doors into partition wall systems to create fully functional rooms."}},
    {"@type":"Question","name":"What areas do you cover for partition walls?","acceptedAnswer":{"@type":"Answer","text":"We provide partition wall installation across Maidstone, Maidstone town centre, the High Street, Bearsted, Headcorn, Allington, Harrietsham, Staplehurst, Boxley, Marden, Yalding, and East Farleigh."}}
  ],
};

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Partition Walls Maidstone",
  additionalType: "https://www.wikidata.org/entity/Q175263",
  about: { "@type": "Thing", name: "Partition wall", sameAs: ["https://www.wikidata.org/entity/Q175263", "https://en.wikipedia.org/wiki/Partition_wall"] },
  sameAs: "https://en.wikipedia.org/wiki/Drywall",
  provider: {
    "@type": "Organization",
    name: "Drylining Maidstone",
    "@id": "https://dryliningmaidstone.co.uk/#business",
    knowsAbout: ["https://en.wikipedia.org/wiki/Drywall", "https://en.wikipedia.org/wiki/Plaster", "https://en.wikipedia.org/wiki/Partition_wall", "https://en.wikipedia.org/wiki/Building_regulations_in_the_United_Kingdom", "https://en.wikipedia.org/wiki/Construction_worker", "https://en.wikipedia.org/wiki/General_contractor", "https://en.wikipedia.org/wiki/Cold-formed_steel", "https://en.wikipedia.org/wiki/Dropped_ceiling"],
  },
  areaServed: {
    "@type": "Place",
    name: "Maidstone and surrounding areas",
    sameAs: [
      "https://en.wikipedia.org/wiki/Maidstone",
      "https://www.wikidata.org/entity/Q213180"
    ],
    geo: { "@type": "GeoCoordinates", "latitude": 51.2748, "longitude": 0.5232 }
  },
};
