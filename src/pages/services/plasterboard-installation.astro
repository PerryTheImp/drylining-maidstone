---
import Layout from "../../layouts/Layout.astro";

const serviceName = "Plasterboard Installation";
const serviceSlug = "plasterboard-installation";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {"@type":"Question","name":"What is plasterboard installation?","acceptedAnswer":{"@type":"Answer","text":"Plasterboard installation is the process of measuring, cutting, and fixing plasterboard sheets to walls and ceilings. It forms the foundation of drylining and provides a smooth surface ready for decoration."}},
    {"@type":"Question","name":"How long does plasterboard installation take?","acceptedAnswer":{"@type":"Answer","text":"A single room takes 1-2 days. Whole-house installations typically take 3-7 days depending on the number of rooms and any complex features like ceilings or bulkheads."}},
    {"@type":"Question","name":"What types of plasterboard do you install?","acceptedAnswer":{"@type":"Answer","text":"We install standard wallboard, moisture-resistant boards for bathrooms and kitchens, fire-rated boards for safety compliance, acoustic boards for sound insulation, and insulated plasterboard for thermal efficiency."}},
    {"@type":"Question","name":"Do I need plastering after plasterboard installation?","acceptedAnswer":{"@type":"Answer","text":"Not necessarily. We offer taping and jointing as an alternative to wet plastering, which produces a smooth, paint-ready finish without the mess and drying time of traditional plaster."}},
    {"@type":"Question","name":"Can plasterboard be installed on existing brick walls?","acceptedAnswer":{"@type":"Answer","text":"Yes. We use the dot and dab method or timber battens to fix plasterboard directly to brick and block walls, creating a smooth surface and improving insulation."}},
    {"@type":"Question","name":"Is plasterboard installation messy?","acceptedAnswer":{"@type":"Answer","text":"We work cleanly and efficiently, keeping dust and debris to a minimum. Our team uses dust extraction equipment and protects floors and furnishings throughout the installation."}},
    {"@type":"Question","name":"What areas do you cover for plasterboard installation?","acceptedAnswer":{"@type":"Answer","text":"We provide plasterboard installation across Maidstone, Maidstone town centre, the High Street, Bearsted, Headcorn, Allington, Harrietsham, Staplehurst, Boxley, Marden, Yalding, and East Farleigh."}}
  ],
};

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
