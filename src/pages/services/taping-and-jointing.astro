const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {"@type":"Question","name":"What is taping and jointing?","acceptedAnswer":{"@type":"Answer","text":"Taping and jointing is the process of covering plasterboard joints and screw holes with jointing compound and paper tape. It creates a smooth, seamless finish ready for painting without the need for wet plastering."}},
    {"@type":"Question","name":"How long does taping and jointing take?","acceptedAnswer":{"@type":"Answer","text":"A typical room takes 2-3 days including drying time between coats. Larger projects take proportionally longer, but the process is still faster than traditional wet plastering."}},
    {"@type":"Question","name":"Is taping and jointing better than plastering?","acceptedAnswer":{"@type":"Answer","text":"Taping and jointing is faster, cleaner, and more cost-effective than wet plastering. It produces a smooth, crack-resistant finish that is indistinguishable from plastered walls and ready for decoration sooner."}},
    {"@type":"Question","name":"Will the joints crack over time?","acceptedAnswer":{"@type":"Answer","text":"When done correctly, taped joints are highly resistant to cracking. We use paper tape and multiple coats of jointing compound to create a flexible, durable seam that moves with the building."}},
    {"@type":"Question","name":"Can you tape and joint ceilings as well as walls?","acceptedAnswer":{"@type":"Answer","text":"Yes. We provide taping and jointing for both walls and ceilings, including bulkheads, bulkhead details, and complex shapes."}},
