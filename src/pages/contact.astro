---
import Layout from "../layouts/Layout.astro";
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ContactPage",
      "name": "Contact Drylining Maidstone",
      "url": "https://www.dryliningmaidstone.co.uk/contact/"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.dryliningmaidstone.co.uk/" },
        { "@type": "ListItem", "position": 2, "name": "Contact", "item": "https://www.dryliningmaidstone.co.uk/contact/" }
      ]
    }
  ]
};
---
<Layout title="Contact Us | Drylining Maidstone — Get in Touch" description="Contact Drylining Maidstone for drylining, partition walls, and suspended ceiling services. Call, email, or fill out our quote form for a free consultation." canonical="/contact/" schema={schema}>
<section style="position:relative;min-height:480px;display:flex;align-items:center;background:linear-gradient(135deg,#0a0e1a 0%,#1a1f3a 100%);overflow:hidden;">
  <img src="/images/area-maidstone-central.jpg" alt="Maidstone skyline from the Medway with All Saints Church spire and Lockmeadow" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.45;" width="1200" height="800" loading="lazy" decoding="async">
  <div style="position:absolute;inset:0;background:linear-gradient(90deg,rgba(10,14,26,0.85) 0%,rgba(10,14,26,0.5) 60%,rgba(10,14,26,0.2) 100%);"></div>
  <div class="container" style="position:relative;z-index:1;text-align:center;">
    <nav style="font-size:12px;color:rgba(255,255,255,0.7);margin-bottom:14px;letter-spacing:0.05em;text-transform:uppercase;">
      <a href="/" style="text-decoration:none;color:rgba(255,255,255,0.7);">Home</a> &nbsp;/&nbsp; <span style="color:#FACC15;">Contact</span>
    </nav>
    <div style="display:inline-block;background:rgba(30,64,175,0.25);color:#ffffff;padding:0.4rem 1rem;border-radius:9999px;font-size:0.8125rem;font-weight:600;margin-bottom:1.25rem;border:1px solid rgba(250,204,21,0.4);letter-spacing:0.05em;">24-HOUR RESPONSE · FREE QUOTES</div>
    <h1 style="font-size:clamp(2.25rem,5vw,3.75rem);font-weight:800;color:#ffffff;margin-bottom:1rem;line-height:1.05;letter-spacing:-0.02em;">Contact <span style="color:#FACC15;">Drylining Maidstone</span></h1>
    <p style="font-size:1.125rem;color:rgba(255,255,255,0.88);max-width:680px;margin:0 auto 1.5rem;line-height:1.65;font-weight:400;">Have a question or ready to start your project? We are here to help — phone, email, or use our quick quote form. Maidstone-based, covering all M-codes.</p>
    <div style="display:flex;gap:0.875rem;justify-content:center;flex-wrap:wrap;">
      <a href="/get-quote/" class="btn btn-highlight" style="font-size:1rem;padding:0.875rem 1.75rem;">Request a Quote</a>
      <a href="tel:+448****8888" class="btn btn-outline" style="border-color:rgba(255,255,255,0.4);color:#ffffff;font-size:1rem;padding:0.75rem 1.75rem;">Call FREEPHONE 0800 MAIDSTONE</a>
    </div>
  </div>
</section>
<section class="section"><div class="container"><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:2rem;max-width:900px;margin:0 auto;">
<div style="background:var(--accent);padding:2rem;border-radius:var(--radius);">
<div style="font-size:2rem;margin-bottom:1rem;">📞</div>
<h3 style="font-size:1.25rem;font-weight:700;color:var(--secondary);margin-bottom:0.5rem;">Phone</h3>
<p style="color:var(--text-light);font-size:0.9375rem;margin-bottom:1rem;">Speak directly with our team for urgent enquiries or to book a site visit.</p>
<a href="tel:+448****8888" style="color:var(--primary);font-weight:600;font-size:1.0625rem;">FREEPHONE 0800 MAIDSTONE</a>
</div>
<div style="background:var(--accent);padding:2rem;border-radius:var(--radius);">
<div style="font-size:2rem;margin-bottom:1rem;">📝</div>
<h3 style="font-size:1.25rem;font-weight:700;color:var(--secondary);margin-bottom:0.5rem;">Request a Quote</h3>
<p style="color:var(--text-light);font-size:0.9375rem;margin-bottom:1rem;">Get a free, no-obligation quote. Fast response guaranteed.</p>
<form action="https://script.google.com/macros/s/AKfycbx2ROgDcHu3ArLmfqPETQYCkFn_5YP6fy1WfZMbynAZsoARpnMRntm5iLlgKSFSJBkG/exec" method="POST" id="contactQuoteForm" style="display:flex;flex-direction:column;gap:0.75rem;">
<input type="hidden" name="source" value="dryliningmaidstone-co-uk-contact" />
<input type="hidden" name="city" value="Maidstone" />
<input type="text" name="name" required placeholder="Your name" style="width:100%;padding:0.75rem 0.875rem;border:1px solid var(--border);border-radius:var(--radius);font-size:0.875rem;font-family:inherit;" />
<input type="tel" name="phone" required placeholder="Phone number" style="width:100%;padding:0.75rem 0.875rem;border:1px solid var(--border);border-radius:var(--radius);font-size:0.875rem;font-family:inherit;" />
<input type="email" name="email" placeholder="Email (optional)" style="width:100%;padding:0.75rem 0.875rem;border:1px solid var(--border);border-radius:var(--radius);font-size:0.875rem;font-family:inherit;" />
<textarea name="details" rows="3" placeholder="Tell us about your project..." style="width:100%;padding:0.75rem 0.875rem;border:1px solid var(--border);border-radius:var(--radius);font-size:0.875rem;font-family:inherit;resize:vertical;"></textarea>

<label for="contactAttachments" style="font-size:0.8125rem;color:#666;display:flex;align-items:center;gap:8px;cursor:pointer;margin-top:0.5rem;font-weight:600;">
  <svg style="width:16px;height:16px;flex-shrink:0;" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M16.5 6v11.5a4.5 4.5 0 1 1-9 0V5a2.5 2.5 0 0 1 5 0v10.5a1 1 0 1 1-2 0V6H9v9.5a3.5 3.5 0 1 0 7 0V5a5 5 0 0 0-10 0v12.5a6.5 6.5 0 1 0 13 0V6h-2.5z"/></svg>
  <span>Attach drawings, plans, or photos (PDF, JPG, PNG, DWG, DOC, ZIP — up to 18 MB each)</span>
</label>
<input type="file" id="contactAttachments" multiple accept=".pdf,.jpg,.jpeg,.png,.webp,.heic,.dwg,.doc,.docx,.xls,.xlsx,.zip,.msg,.txt,.csv" style="font-size:0.8125rem;color:#666;margin-top:0.375rem;" />
<div id="contactAttachmentStatus" style="font-size:0.75rem;color:#666;margin-top:0.25rem;min-height:1em;"></div>

<button type="submit" class="btn btn-primary" id="contactSubmitBtn" style="width:100%;">Request Free Quote</button>
<div id="contactFormMessage" style="padding:0.75rem;border-radius:var(--radius);display:none;font-size:0.875rem;"></div>
</form>
</div>
</div></div></section>
<section class="section" style="background:var(--accent);"><div class="container" style="text-align:center;max-width:700px;">
<h2 style="font-size:1.75rem;font-weight:700;color:var(--secondary);margin-bottom:1rem;">Working Hours</h2>
<p style="color:var(--text-light);font-size:1.0625rem;line-height:1.8;">We are available Monday to Friday, 8:00 AM to 6:00 PM. For commercial projects, we also offer evening and weekend appointments to minimise business disruption.</p>
</div></section>

<!-- Map -->
<section style="padding: 0 0 4rem;">
  <div class="container">
    <h2 style="font-size: 1.75rem; font-weight: 800; margin-bottom: 0.5rem; text-align: center;">Where We Work — Maidstone & the Whole Borough</h2>
    <p style="text-align: center; color: var(--text-light); font-size: 1rem; margin-bottom: 1.25rem;">From Maidstone town centre and the riverside out to Boxley, East Farleigh, Harrietsham, Allington, Marden and Yalding. Every <strong>ME14, ME15, ME16, ME17, ME18, TN12, TN27</strong> postcode.</p>
    <div style="border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow);">
      <iframe src="https://www.openstreetmap.org/export/embed.html?bbox=0.35,51.15,0.85,51.45&amp;layer=mapnik&amp;marker=51.2748,0.5232" width="100%" height="450" style="border:0; display:block;" loading="lazy" title="Maidstone borough service area map"></iframe>
      <p style="text-align: center; font-size: 0.8125rem; color: var(--text-light); padding: 0.5rem; background: var(--surface); margin: 0;"><a href="https://www.openstreetmap.org/?mlat=51.2748&amp;mlon=0.5232#map=10/51.2748/0.5232" target="_blank" rel="noopener" style="color: var(--primary);">View larger map</a></p>
    </div>
  </div>
</section>
<script>
import { upload } from '@vercel/blob/client';
const APP_ID = 'maidstone';
const FREEPHONE = '0800 MAIDSTONE';
const SOURCE_FALLBACK = 'dryliningmaidstone-co-uk-contact';
const PAGE = '/contact/';
(function(){
const form=document.getElementById('contactQuoteForm');
if(!form)return;
const btn=document.getElementById('contactSubmitBtn')||form.querySelector('button[type="submit"]');
const msg=document.getElementById('contactFormMessage')||form.querySelector('[id$="Message"],[id$="FormMessage"]');
const fileInput=document.getElementById('contactAttachments')||form.querySelector('input[type="file"]');
const status=document.getElementById('contactAttachmentStatus')||form.querySelector('[id$="Status"],[id$="AttachmentStatus"]');

function setProgress(text,color){if(status){status.textContent=text;status.style.color=color||'#666';}}
function showError(t){if(!msg)return;msg.style.display='block';msg.style.background='#fee2e2';msg.style.color='#b91c1c';msg.style.border='1px solid #fecaca';msg.textContent=t;}
function showSuccess(t){if(!msg)return;msg.style.display='block';msg.style.background='#dcfce7';msg.style.color='#15803d';msg.style.border='1px solid #bbf7d0';msg.textContent=t;}

async function uploadOne(file){
  const safe=file.name.replace(/[^A-Za-z0-9._-]+/g,'_').slice(0,80);
  const ts=Date.now();const batch=Math.random().toString(36).slice(2,10);
  try{
    const r=await upload('leads/'+APP_ID+'/'+ts+'-'+batch+'/'+safe,file,{
      access:'public',
      handleUploadUrl:'/api/quote-upload-token',
      clientPayload:JSON.stringify({filename:file.name})
    });
    return {filename:file.name,url:r.url,size:file.size,mime:file.type||'application/octet-stream'};
  }catch(err){console.warn('upload_failed',file.name,err);return null;}
}

form.addEventListener('submit',async function(e){
  e.preventDefault();
  btn.disabled=true;btn.textContent='Sending...';if(msg)msg.style.display='none';
  try{
    const fd=new FormData(form);
    const files=fileInput&&fileInput.files?Array.from(fileInput.files):[];
    let fileUrls=[];
    if(files.length){
      setProgress('Uploading '+files.length+' file'+(files.length>1?'s':'')+'...');
      const results=await Promise.all(files.map(uploadOne));
      fileUrls=results.filter(Boolean);
      setProgress(fileUrls.length+'/'+results.length+(fileUrls.length<results.length?' (some skipped)':' uploaded'));
    }
    const payload={};
    fd.forEach(function(v,k){if(k!=='attachments')payload[k]=v;});
    payload.source=payload.source||SOURCE_FALLBACK;
    payload.page=PAGE;
    payload.referrer=document.referrer||'';
    payload.submitted_at=new Date().toISOString();
    payload.file_urls=fileUrls;
    const resp=await fetch('/api/submit-quote',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});
    const data=await resp.json().catch(function(){return{};});
    if(resp.ok&&data&&data.ok){
      showSuccess('Thank you! Your quote request has been sent. We will contact you within 24 hours.');
      form.reset();
      setProgress('');
    }else{
      throw new Error((data&&data.error)||('Status '+resp.status));
    }
  }catch(err){
    showError('Something went wrong. Please call us on '+FREEPHONE+' or try again. ('+(err&&err.message||'error')+')');
  }finally{
    btn.disabled=false;btn.textContent='Request Free Quote';
  }
});
})();
</script>

<script>
import { upload } from '@vercel/blob/client';
const APP_ID = 'maidstone';
const FREEPHONE = '0800 MAIDSTONE';
(function(){
const FORMS = [
  {form:'contactQuoteForm', btn:'contactSubmitBtn', msg:'contactFormMessage', file:'contactAttachments', status:'contactAttachmentStatus', source:'dryliningmaidstone-co-uk-contact', page:'/contact/'},
  // Auto-detect other forms on the page
];
function findForm(fallback){const forms=document.querySelectorAll('form');for(const f of forms){if(f.id===fallback.form||f.id.endsWith('QuoteForm')){return f;}}return null;}
function setProgress(text,color){const el=document.getElementById(fallback.status);if(el){el.textContent=text;el.style.color=color||'#666';}}
function showError(t){const el=document.getElementById(fallback.msg);if(!el)return;el.style.display='block';el.style.background='#fee2e2';el.style.color='#b91c1c';el.style.border='1px solid #fecaca';el.textContent=t;}
function showSuccess(t){const el=document.getElementById(fallback.msg);if(!el)return;el.style.display='block';el.style.background='#dcfce7';el.style.color='#15803d';el.style.border='1px solid #bbf7d0';el.textContent=t;}

async function uploadOne(file){
  const safe=file.name.replace(/[^A-Za-z0-9._-]+/g,'_').slice(0,80);
  const ts=Date.now();const batch=Math.random().toString(36).slice(2,10);
  try{
    const r=await upload('leads/'+APP_ID+'/'+ts+'-'+batch+'/'+safe,file,{
      access:'public',
      handleUploadUrl:'/api/quote-upload-token',
      clientPayload:JSON.stringify({filename:file.name})
    });
    return {filename:file.name,url:r.url,size:file.size,mime:file.type||'application/octet-stream'};
  }catch(err){console.warn('upload_failed',file.name,err);return null;}
}

const fb = FORMS[0];
const form=document.getElementById(fb.form);const btn=document.getElementById(fb.btn);const msg=document.getElementById(fb.msg);const fileInput=document.getElementById(fb.file);const status=document.getElementById(fb.status);
if(!form)return;

form.addEventListener('submit',async function(e){
  e.preventDefault();
  btn.disabled=true;btn.textContent='Sending...';msg.style.display='none';
  try{
    const fd=new FormData(form);
    const files=fileInput&&fileInput.files?Array.from(fileInput.files):[];
    let fileUrls=[];
    if(files.length){
      setProgress('Uploading '+files.length+' file'+(files.length>1?'s':'')+'...');
      const results=await Promise.all(files.map(uploadOne));
      fileUrls=results.filter(Boolean);
      setProgress(fileUrls.length+'/'+results.length+(fileUrls.length<results.length?' (some skipped)':' uploaded'));
    }
    const payload={};
    fd.forEach(function(v,k){if(k!=='attachments')payload[k]=v;});
    payload.source=payload.source||fb.source;
    payload.page=fb.page;
    payload.referrer=document.referrer||'';
    payload.submitted_at=new Date().toISOString();
    payload.file_urls=fileUrls;
    const resp=await fetch('/api/submit-quote',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});
    const data=await resp.json().catch(function(){return{};});
    if(resp.ok&&data&&data.ok){
      showSuccess('Thank you! Your quote request has been sent. We will contact you within 24 hours.');
      form.reset();
      setProgress('');
    }else{
      throw new Error((data&&data.error)||('Status '+resp.status));
    }
  }catch(err){
    showError('Something went wrong. Please call us on '+FREEPHONE+' or try again. ('+(err&&err.message||'error')+')');
  }finally{
    btn.disabled=false;btn.textContent='Request Free Quote';
  }
});
})();
</script>

</Layout>
