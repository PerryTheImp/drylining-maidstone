---
import Layout from "../layouts/Layout.astro";
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ContactPage",
      "name": "Contact Drylining Maidstone",
      "url": "https://dryliningmaidstone.co.uk/contact/"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://dryliningmaidstone.co.uk/" },
        { "@type": "ListItem", "position": 2, "name": "Contact", "item": "https://dryliningmaidstone.co.uk/contact/" }
      ]
    }
  ]
};
---
<Layout title="Contact Us | Drylining Maidstone — Get in Touch" description="Contact Drylining Maidstone for drylining, partition walls, and suspended ceiling services. Call, email, or fill out our quote form for a free consultation." canonical="/contact/" schema={schema}>
<section style="position:relative;min-height:480px;display:flex;align-items:center;background:linear-gradient(135deg,#0a0e1a 0%,#1a1f3a 100%);overflow:hidden;">
  <img src="/images/area-maidstone-central.jpg" alt="Maidstone skyline from the Medway with All Saints Church spire and Lockmeadow" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.45;">
  <div style="position:absolute;inset:0;background:linear-gradient(90deg,rgba(10,14,26,0.85) 0%,rgba(10,14,26,0.5) 60%,rgba(10,14,26,0.2) 100%);"></div>
  <div class="container" style="position:relative;z-index:1;text-align:center;">
    <nav style="font-size:12px;color:rgba(255,255,255,0.7);margin-bottom:14px;letter-spacing:0.05em;text-transform:uppercase;">
      <a href="/" style="text-decoration:none;color:rgba(255,255,255,0.7);">Home</a> &nbsp;/&nbsp; <span style="color:#FACC15;">Contact</span>
    </nav>
    <div style="display:inline-block;background:rgba(30,64,175,0.25);color:#ffffff;padding:0.4rem 1rem;border-radius:9999px;font-size:0.8125rem;font-weight:600;margin-bottom:1.25rem;border:1px solid rgba(250,204,21,0.4);letter-spacing:0.05em;">24-HOUR RESPONSE · FREE QUOTES</div>
    <h1 style="font-size:clamp(2.25rem,5vw,3.75rem);font-weight:800;color:#ffffff;margin-bottom:1rem;line-height:1.05;letter-spacing:-0.02em;">Contact <span style="color:#FACC15;">Drylining Maidstone</span></h1>
    <p style="font-size:1.125rem;color:rgba(255,255,255,0.88);max-width:680px;margin:0 auto 1.5rem;line-height:1.65;font-weight:400;">Have a question or ready to start your project? We are here to help — phone, email, or use our quick quote form. Maidstone-based, covering all M-codes.</p>
    <div style="display:flex;gap:0.875rem;justify-content:center;flex-wrap:wrap;">
      <a href="/get-quote/" class="btn btn-highlight" style="font-size:1rem;padding:0.875rem 1.75rem;">Request a Quote</a>
      <a href="tel:+448****8888" class="btn btn-outline" style="border-color:rgba(255,255,255,0.4);color:#ffffff;font-size:1rem;padding:0.75rem 1.75rem;">Call FREEPHONE 0800 MAIDSTONE</a>
    </div>
  </div>
</section>
<section class="section"><div class="container"><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:2rem;max-width:900px;margin:0 auto;">
<div style="background:var(--accent);padding:2rem;border-radius:var(--radius);">
<div style="font-size:2rem;margin-bottom:1rem;">📞</div>
<h3 style="font-size:1.25rem;font-weight:700;color:var(--secondary);margin-bottom:0.5rem;">Phone</h3>
<p style="color:var(--text-light);font-size:0.9375rem;margin-bottom:1rem;">Speak directly with our team for urgent enquiries or to book a site visit.</p>
<a href="tel:+448****8888" style="color:var(--primary);font-weight:600;font-size:1.0625rem;">FREEPHONE 0800 MAIDSTONE</a>
</div>
<div style="background:var(--accent);padding:2rem;border-radius:var(--radius);">
<div style="font-size:2rem;margin-bottom:1rem;">📝</div>
<h3 style="font-size:1.25rem;font-weight:700;color:var(--secondary);margin-bottom:0.5rem;">Request a Quote</h3>
<p style="color:var(--text-light);font-size:0.9375rem;margin-bottom:1rem;">Get a free, no-obligation quote. Fast response guaranteed.</p>
<form action="https://script.google.com/macros/s/AKfycbx2ROgDcHu3ArLmfqPETQYCkFn_5YP6fy1WfZMbynAZsoARpnMRntm5iLlgKSFSJBkG/exec" method="POST" id="contactQuoteForm" style="display:flex;flex-direction:column;gap:0.75rem;">
<input type="hidden" name="source" value="dryliningmaidstone-co-uk-contact" />
<input type="text" name="name" required placeholder="Your name" style="width:100%;padding:0.75rem 0.875rem;border:1px solid var(--border);border-radius:var(--radius);font-size:0.875rem;font-family:inherit;" />
<input type="tel" name="phone" required placeholder="Phone number" style="width:100%;padding:0.75rem 0.875rem;border:1px solid var(--border);border-radius:var(--radius);font-size:0.875rem;font-family:inherit;" />
<input type="email" name="email" placeholder="Email (optional)" style="width:100%;padding:0.75rem 0.875rem;border:1px solid var(--border);border-radius:var(--radius);font-size:0.875rem;font-family:inherit;" />
<textarea name="details" rows="3" placeholder="Tell us about your project..." style="width:100%;padding:0.75rem 0.875rem;border:1px solid var(--border);border-radius:var(--radius);font-size:0.875rem;font-family:inherit;resize:vertical;"></textarea>
<button type="submit" class="btn btn-primary" id="contactSubmitBtn" style="width:100%;">Request Free Quote</button>
<div id="contactFormMessage" style="padding:0.75rem;border-radius:var(--radius);display:none;font-size:0.875rem;"></div>
</form>
</div>
</div></div></section>
<section class="section" style="background:var(--accent);"><div class="container" style="text-align:center;max-width:700px;">
<h2 style="font-size:1.75rem;font-weight:700;color:var(--secondary);margin-bottom:1rem;">Working Hours</h2>
<p style="color:var(--text-light);font-size:1.0625rem;line-height:1.8;">We are available Monday to Friday, 8:00 AM to 6:00 PM. For commercial projects, we also offer evening and weekend appointments to minimise business disruption.</p>
</div></section>

<!-- Map -->
<section style="padding: 0 0 4rem;">
  <div class="container">
    <h2 style="font-size: 1.75rem; font-weight: 800; margin-bottom: 0.5rem; text-align: center;">Where We Work — Maidstone & the Whole Borough</h2>
    <p style="text-align: center; color: var(--text-light); font-size: 1rem; margin-bottom: 1.25rem;">From Maidstone town centre and the riverside out to Boxley, East Farleigh, Harrietsham, Allington, Marden and Yalding. Every <strong>ME14, ME15, ME16, ME17, ME18, TN12, TN27</strong> postcode.</p>
    <div style="border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow);">
      <iframe src="https://www.openstreetmap.org/export/embed.html?bbox=0.35,51.15,0.85,51.45&amp;layer=mapnik&amp;marker=51.2748,0.5232" width="100%" height="450" style="border:0; display:block;" loading="lazy" title="Maidstone borough service area map"></iframe>
      <p style="text-align: center; font-size: 0.8125rem; color: var(--text-light); padding: 0.5rem; background: var(--surface); margin: 0;"><a href="https://www.openstreetmap.org/?mlat=51.2748&amp;mlon=0.5232#map=10/51.2748/0.5232" target="_blank" rel="noopener" style="color: var(--primary);">View larger map</a></p>
    </div>
  </div>
</section>
<script>
(function(){
var form=document.getElementById("contactQuoteForm");var btn=document.getElementById("contactSubmitBtn");var msg=document.getElementById("contactFormMessage");if(!form)return;
form.addEventListener("submit",function(e){
e.preventDefault();
btn.disabled=true;btn.textContent="Sending...";msg.style.display="none";
var data=new FormData(form);var payload={};
data.forEach(function(v,k){payload[k]=v;});
fetch(form.action,{method:"POST",body:JSON.stringify(payload),headers:{"Content-Type":"application/json"},mode:"no-cors"})
.then(function(r){if(r.ok||r.status===0){msg.style.display="block";msg.style.background="#dcfce7";msg.style.color="#15803d";msg.style.border="1px solid #bbf7d0";msg.textContent="Thank you! We will contact you within 24 hours.";form.reset();}else{throw new Error("Status "+r.status);}})
.catch(function(){msg.style.display="block";msg.style.background="#fee2e2";msg.style.color="#b91c1c";msg.style.border="1px solid #fecaca";msg.textContent="Something went wrong. Please call us on FREEPHONE 0800 MAIDSTONE or try again.";})
.finally(function(){btn.disabled=false;btn.textContent="Request Free Quote";});
});
})();
</script>
</Layout>
