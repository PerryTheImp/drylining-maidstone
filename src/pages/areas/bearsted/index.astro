const description = `Drylining in Bearsted (ME14): partition walls, suspended ceilings, metal stud, fire-rated, acoustic, and plasterboard installation for edwardian semis, large detached houses, new-build estates, conservation-area cottages. Local ME-postcode team, same-day quotes.`;
const canonical = `/areas/bearsted/`;
const schema = {"@context":"https://schema.org","@graph":[{"@type":"LocalBusiness","@id":`https://dryliningmaidstone.co.uk/#business`,"name":"Drylining Maidstone","url":"https://dryliningmaidstone.co.uk","telephone":"+448****8888","image":"https://dryliningmaidstone.co.uk/images/area-bearsted.jpg","address":{"@type":"PostalAddress","addressLocality":"Bearsted","addressRegion":"Kent","postalCode":"ME14","addressCountry":"GB"},"areaServed":{"@type":"Place","name":"Bearsted","url":`https://dryliningmaidstone.co.uk/areas/bearsted/`}},{"@type":"Service","serviceType":"Drylining contractors","provider":{"@id":`https://dryliningmaidstone.co.uk/#business`},"areaServed":{"@type":"Place","name":"Bearsted"},"description":`Drylining contractors in Bearsted (ME14). Partition walls, suspended ceilings, plasterboard for edwardian semis, large detached houses, new-build estates, conservation-area cottages in and around Bearsted. Free quotes.`},{"@type":"Place","name":"Bearsted","url":`https://dryliningmaidstone.co.uk/areas/bearsted/`,"containedInPlace":{"@type":"AdministrativeArea","name":"Maidstone Borough"},"address":{"@type":"PostalAddress","addressLocality":"Bearsted","addressRegion":"Kent","postalCode":"ME14","addressCountry":"GB"}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://dryliningmaidstone.co.uk/"},{"@type":"ListItem","position":2,"name":"Areas","item":"https://dryliningmaidstone.co.uk/areas/"},{"@type":"ListItem","position":3,"name":"Bearsted","item":`https://dryliningmaidstone.co.uk/areas/bearsted/`}]}]};
---
<Layout title={title} description={description} canonical={canonical} schema={schema}>
  <section style="position:relative;min-height:480px;display:flex;align-items:center;background:linear-gradient(135deg,#0a0e1a 0%,#1a1f3a 100%);overflow:hidden;">
    <img src="/images/area-bearsted.jpg" alt="Drylining work in Bearsted, Maidstone" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.25;">
    <div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(10,14,26,0.85) 0%,rgba(26,31,58,0.85) 100%);"></div>
    <div class="container" style="position:relative;z-index:1;">
      <nav style="font-size:0.75rem;color:rgba(255,255,255,0.6);margin-bottom:1.5rem;">
        <a href="/" style="color:#FACC15;">HOME</a> / <a href="/areas/" style="color:#FACC15;">AREAS</a> / <span style="color:#FACC15;font-weight:600;">BEARSTED</span>
      </nav>
      <span style="display:inline-block;padding:0.375rem 1rem;background:rgba(30,64,175,0.15);border:1px solid #FACC15;color:#FACC15;font-size:0.75rem;font-weight:700;letter-spacing:0.05em;border-radius:99px;margin-bottom:1.25rem;">ME14 POSTCODES</span>
      <h1 style="font-size:3.5rem;font-weight:800;color:var(--white);line-height:1.1;margin-bottom:1.25rem;">Drylining in <span style="color:#FACC15;">Bearsted</span></h1>
      <p style="font-size:1.125rem;color:rgba(255,255,255,0.85);margin-bottom:1.5rem;max-width:48rem;">ME14 — partition walls, suspended ceilings, fire-rated and acoustic drylining across Bearsted.</p>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;">
        <a href="/get-quote/" class="btn btn-highlight">Get My Free Quote</a>
        <a href="/services/" class="btn btn-outline" style="color:var(--white);border-color:rgba(255,255,255,0.3);">View All Services</a>
      </div>
    </div>
  </section>

  <section class="container" style="padding:3rem 1.5rem;">
    <div style="background:rgba(30,64,175,0.05);border-left:4px solid #FACC15;padding:1rem 1.5rem;margin-bottom:2rem;border-radius:0 8px 8px 0;">
      <p style="margin:0;font-size:1rem;font-weight:600;color:var(--text);"><strong>TL;DR:</strong> Local Maidstone drylining team covering Bearsted (ME14). CSCS-accredited, £1M insured, same-day quotes on all standard partition, ceiling, plasterboard and fire-rated work.</p>
    </div>

    <h2 style="font-size:1.875rem;font-weight:700;margin-bottom:1rem;">About Bearsted</h2>
    <p style="font-size:1.0625rem;color:var(--text);line-height:1.8;margin-bottom:1.5rem;">Bearsted is the affluent northern suburb of Maidstone, sitting between the A20 Bearsted Road corridor and the North Downs. Property stock is dominated by Edwardian semis on the Ashford Road, large detached houses in the Madginford estate, and the more recent Bearsted Green and Cross Keys developments.</p>
    <p style="font-size:1.0625rem;color:var(--text);line-height:1.8;margin-bottom:1.5rem;">Our standard wet-trade coverage across Bearsted includes dot-and-dab plasterboarding, independent metal stud partitions, suspended ceiling grids, fire-rated column and beam encasements, and acoustic partitions to Part E. We work directly for homeowners, landlords, commercial tenants and main contractors, and we can usually be on-site in Bearsted within a week of acceptance.</p>

    <h2 style="font-size:1.875rem;font-weight:700;margin:2.5rem 0 1rem;">What We Do in Bearsted</h2>
    <ul style="list-style:disc;padding-left:1.5rem;color:var(--text);line-height:1.8;font-size:1.0625rem;margin-bottom:1.5rem;">
      <li>Dot-and-dab plasterboarding (insulated + standard plasterboard)</li>
      <li>Metal stud partition walls (single + twin frame, acoustic infill)</li>
      <li>Suspended ceilings (grid + tile, MF plaster, exposed grid)</li>
      <li>Fire-rated plasterboard systems (30/60/90/120 minutes to BS 476)</li>
      <li>Acoustic partitions (Part E compliance, Robust Detail construction)</li>
      <li>Taping and jointing to finish standard</li>
    </ul>

    <h2 style="font-size:1.875rem;font-weight:700;margin:2.5rem 0 1rem;">Typical Property Types in Bearsted</h2>
    <p style="font-size:1.0625rem;color:var(--text);line-height:1.8;margin-bottom:1.5rem;">Edwardian semis, large detached houses, new-build estates, conservation-area cottages. Our Bearsted team is set up for quick site visits across all of them.</p>

    <h2 style="font-size:1.875rem;font-weight:700;margin:2.5rem 0 1rem;">Nearby Areas</h2>
    <p style="font-size:1.0625rem;color:var(--text);line-height:1.8;margin-bottom:1.5rem;">We also provide drylining services in nearby Maidstone areas: Maidstone Central, Bearsted, Allington, Loose, Boxley, Staplehurst, Headcorn, Marden, Yalding, East Farleigh, Harrietsham, Hollingbourne.</p>

    <div style="background:var(--accent);padding:2rem;border-radius:12px;margin-top:2rem;text-align:center;">
      <h3 style="color:var(--secondary);margin-bottom:0.75rem;font-size:1.5rem;font-weight:700;">Need drylining in Bearsted?</h3>
      <p style="color:var(--secondary);margin-bottom:1.25rem;font-size:1.0625rem;">Same-day quote, local team, ME postcodes covered.</p>
      <a href="/get-quote/" class="btn btn-primary">Get My Free Quote</a>
    </div>
  </section>
</Layout>
