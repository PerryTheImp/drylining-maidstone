        <a href="/" style="color:#FACC15;">HOME</a> / <a href="/areas/" style="color:#FACC15;">AREAS</a> / <span style="color:#FACC15;font-weight:600;">HOLLINGBOURNE</span>
      </nav>
      <span style="display:inline-block;padding:0.375rem 1rem;background:rgba(30,64,175,0.15);border:1px solid #FACC15;color:#FACC15;font-size:0.75rem;font-weight:700;letter-spacing:0.05em;border-radius:99px;margin-bottom:1.25rem;">ME17 POSTCODES</span>
