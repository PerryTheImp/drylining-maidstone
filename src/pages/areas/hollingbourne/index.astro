const canonical = `/areas/hollingbourne/`;
const schema = {"@context":"https://schema.org","@graph":[{"@type":"LocalBusiness","@id":`https://dryliningmaidstone.co.uk/#business`,"name":"Drylining Maidstone","url":"https://dryliningmaidstone.co.uk","telephone":"+448****8888","image":"https://dryliningmaidstone.co.uk/images/area-hollingbourne.jpg","address":{"@type":"PostalAddress","addressLocality":"Hollingbourne","addressRegion":"Kent","postalCode":"ME17","addressCountry":"GB"},"areaServed":{"@type":"Place","name":"Hollingbourne","url":`https://dryliningmaidstone.co.uk/areas/hollingbourne/`}},{"@type":"Service","serviceType":"Drylining contractors","provider":{"@id":`https://dryliningmaidstone.co.uk/#business`},"areaServed":{"@type":"Place","name":"Hollingbourne"},"description":`Drylining contractors in Hollingbourne (ME17). Partition walls, suspended ceilings, plasterboard for period cottages, 1960s/70s detached houses, north downs rural properties in and around Hollingbourne. Free quotes.`},{"@type":"Place","name":"Hollingbourne","url":`https://dryliningmaidstone.co.uk/areas/hollingbourne/`,"containedInPlace":{"@type":"AdministrativeArea","name":"Maidstone Borough"},"address":{"@type":"PostalAddress","addressLocality":"Hollingbourne","addressRegion":"Kent","postalCode":"ME17","addressCountry":"GB"}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://dryliningmaidstone.co.uk/"},{"@type":"ListItem","position":2,"name":"Areas","item":"https://dryliningmaidstone.co.uk/areas/"},{"@type":"ListItem","position":3,"name":"Hollingbourne","item":`https://dryliningmaidstone.co.uk/areas/hollingbourne/`}]}]};
---
<Layout title={title} description={description} canonical={canonical} schema={schema}>
  <section style="position:relative;min-height:480px;display:flex;align-items:center;background:linear-gradient(135deg,#0a0e1a 0%,#1a1f3a 100%);overflow:hidden;">
