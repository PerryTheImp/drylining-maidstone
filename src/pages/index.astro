  <script>
    (function() {
      var form = document.getElementById("heroQuoteForm");
      var btn = document.getElementById("heroSubmitBtn");
      var msg = document.getElementById("heroFormMessage");
      if (!form) return;
      form.addEventListener("submit", function(e) {
        e.preventDefault();
        if (btn) { btn.disabled = true; btn.textContent = "Sending..."; }
        if (msg) { msg.style.display = "none"; }
        var data = new FormData(form);
        var payload = {};
        data.forEach(function(v, k) { payload[k] = v; });
        fetch(form.action, {
          method: "POST",
          body: JSON.stringify(payload),
          headers: { "Content-Type": "application/json" },
          mode: "no-cors"
        }).then(function(r) {
          if (r.ok || r.status === 0) {
            if (msg) { msg.style.display = "block"; msg.style.color = "#15803d"; msg.textContent = "Thank you! We will be in touch within 24 hours."; }
            form.reset();
          } else {
            throw new Error("Status " + r.status);
          }
        }).catch(function(err) {
          if (msg) { msg.style.display = "block"; msg.style.color = "#1E40AF"; msg.textContent = "Something went wrong. Please call us or try again."; }
        }).finally(function() {
          if (btn) { btn.disabled = false; btn.textContent = "Request Free Quote"; }
        });
      });
    })();
  </script>
