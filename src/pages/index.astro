---
import Layout from "../layouts/Layout.astro";
import FlipCard from "../components/FlipCard.astro";
import TrustBar from "../components/TrustBar.astro";
import AreasGrid from "../components/AreasGrid.astro";
import FAQItem from "../components/FAQItem.astro";
import { faqs as allFaqs } from "../data/faqs";

const services = [
  { title: "Drylining Contractors", description: "Expert drylining installation for residential and commercial properties across Maidstone. We create smooth, paint-ready wall finishes quickly and cleanly.", link: "/services/drylining-contractors/" },
  { title: "Partition Walls", description: "Build durable, cost-effective partition walls to divide open-plan offices, retail units, and homes. Sound-rated options available.", link: "/services/partition-walls/" },
  { title: "Metal Stud Partitioning", description: "Lightweight, strong metal stud partitions perfect for commercial fit-outs. Faster to install and easier to modify than traditional timber framing.", link: "/services/metal-stud-partitioning/" },
  { title: "Suspended Ceilings", description: "Install clean, modern suspended ceilings that hide services, improve acoustics, and enhance lighting. Ideal for offices, retail, and healthcare.", link: "/services/suspended-ceilings/" },
  { title: "Plasterboard Installation", description: "Precision plasterboard fitting for walls and ceilings. Seamless joints, professional finishing, and minimal disruption to your project timeline.", link: "/services/plasterboard-installation/" },
  { title: "Taping & Jointing", description: "Smooth, crack-resistant finishes with expert taping and jointing. No need for full plastering — faster, cleaner, and ready for decoration.", link: "/services/taping-and-jointing/" },
  { title: "Commercial Drylining", description: "Large-scale drylining for offices, retail spaces, warehouses, and public buildings. We work to tight deadlines and specifications.", link: "/services/commercial-drylining/" },
  { title: "Office Drylining", description: "Create modern, flexible office interiors with drylined partitions, feature walls, and ceiling systems. Minimal downtime for your business.", link: "/services/office-drylining/" },
  { title: "Fire-Rated Drylining", description: "Fire-rated plasterboard systems for 30, 60, and 120-minute fire resistance. Approved Document B compliant for HMOs, apartments, and commercial premises.", link: "/services/fire-rated-drylining/" },
  { title: "Acoustic Drylining", description: "Acoustic plasterboard and insulation for Part E sound resistance between homes, flats, offices, and schools.", link: "/services/acoustic-drylining/" },
  { title: "Insulated Drylining", description: "Insulated plasterboard for thermal upgrades on external walls. Cuts heat loss in Maidstone's Victorian terraces and pre-1920s semis.", link: "/services/insulated-drylining/" },
  { title: "Refurbishment Drylining", description: "Strip-out and re-plaster for renovation projects. From a single room to a full property refurb, including damp and damage repair.", link: "/services/refurbishment-drylining/" },
];

const areas = [
  { name: "Maidstone Central", slug: "maidstone-central", desc: "Full drylining services across Maidstone town centre, the High Street, riverside quarters, and all surrounding neighbourhoods (ME14, ME15)." },
  { name: "Bearsted", slug: "bearsted", desc: "Affluent north Maidstone suburb — Victorian and Edwardian semis, larger detached houses, and the Bearsted Green new-build estates (ME14)." },
  { name: "Allington", slug: "allington", desc: "South of the Medway near Maidstone Borough Council HQ — drylining for post-war estates, Castle Road commercial units, and Allington new-builds (ME16)." },
  { name: "Loose", slug: "loose", desc: "South-east Maidstone village — Victorian cottages along Loose Road, 1930s semis in the Loose Valley, and conservation-area renovations (ME15, ME17)." },
  { name: "Boxley", slug: "boxley", desc: "North Maidstone village on the A249 — period homes near Boxley Abbey, modern Church Lane estates, and North Downs new-builds (ME14)." },
  { name: "Staplehurst", slug: "staplehurst", desc: "Large village 9 mi south of Maidstone on the Hastings Line — Victorian terraces and post-war council housing (ME17, TN12)." },
  { name: "Headcorn", slug: "headcorn", desc: "8 mi SE of Maidstone — pre-war village housing plus the recent Headcorn Aerodrome residential developments (ME17, TN27)." },
  { name: "Marden", slug: "marden", desc: "11 mi south of Maidstone — rural village with growing new-build estates and ongoing barn conversions (TN12)." },
  { name: "Yalding", slug: "yalding", desc: "Conservation Area village 7 mi SW of Maidstone — heritage cottage renovations and farm-conversion drylining (ME18)." },
  { name: "East Farleigh", slug: "east-farleigh", desc: "3 mi SW of Maidstone on the Medway — rural village with farm conversions and riverside period cottages (ME15)." },
  { name: "Harrietsham", slug: "harrietsham", desc: "7 mi east along the M20 corridor — village housing plus new-build estates at Harrietsham Park (ME17)." },
  { name: "Hollingbourne", slug: "hollingbourne", desc: "5 mi east on the North Downs — hillside village properties and Hollingbourne Rural Park (ME17)." },
];

const faqs = allFaqs.slice(0, 5);

const serviceAreaSchema = {
  "@type": "DefinedRegion",
  "@id": "https://dryliningmaidstone.co.uk/#serviceArea",
  "name": "Maidstone and surrounding areas",
  "addressCountry": "GB",
  "addressRegion": ["Maidstone", "Kent", "Maidstone (borough)", "Maidstone (borough)"]
};

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "LocalBusiness",
      "@id": "https://dryliningmaidstone.co.uk/#business",
      "name": "Drylining Maidstone",
      "url": "https://dryliningmaidstone.co.uk",
      "telephone": "+448****8888",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Maidstone",
        "addressRegion": "England",
        "addressCountry": "GB",
        "sameAs": "https://www.wikidata.org/entity/Q213180"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 51.2748,
        "longitude": 0.5232
      },
      "areaServed": [
        { "@type": "City", "name": "Maidstone", "@id": "https://www.wikidata.org/entity/Q213180", "sameAs": ["https://en.wikipedia.org/wiki/Maidstone", "https://www.wikidata.org/entity/Q213180"] },
        { "@type": "Place", "name": "Maidstone town centre" },
        { "@type": "Place", "name": "Maidstone riverside" },
        { "@type": "Place", "name": "Maidstone central" },
        { "@type": "Place", "name": "Bearsted" },
        { "@type": "Place", "name": "Headcorn" },
        { "@type": "Place", "name": "Allington" },
        { "@type": "Place", "name": "Harrietsham" },
        { "@type": "Place", "name": "Staplehurst" },
        { "@type": "Place", "name": "Boxley" },
        { "@type": "Place", "name": "Marden" },
        { "@type": "Place", "name": "Yalding" },
        { "@type": "Place", "name": "East Farleigh" }
      ],
      "serviceType": "Drylining, Partition Walls, Suspended Ceilings",
      "sameAs": [
        "https://en.wikipedia.org/wiki/Maidstone",
        "https://www.wikidata.org/entity/Q213180",
        "https://en.wikipedia.org/wiki/Drywall",
        "https://www.wikidata.org/entity/Q213825",
        "https://www.wikidata.org/entity/Q385378"
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Drylining Services",
        "itemListElement": services.map(s => ({ "@type": "Offer", "itemOffered": { "@type": "Service", "name": s.title } }))
      }
    },
    {
      "@type": "Organization",
      "@id": "https://dryliningmaidstone.co.uk/#org",
      "name": "Drylining Maidstone",
      "url": "https://dryliningmaidstone.co.uk",
      "sameAs": [
        "https://www.wikidata.org/entity/Q213180",
        "https://en.wikipedia.org/wiki/Maidstone",
        "https://www.wikidata.org/entity/Q385378"
      ],
      "knowsAbout": [
        "https://en.wikipedia.org/wiki/Drywall",
        "https://en.wikipedia.org/wiki/Partition_wall",
        "https://en.wikipedia.org/wiki/Dropped_ceiling",
        "https://en.wikipedia.org/wiki/Plaster",
        "https://en.wikipedia.org/wiki/Building_regulations_in_the_United_Kingdom",
        "https://en.wikipedia.org/wiki/Construction_worker",
        "https://en.wikipedia.org/wiki/General_contractor"
      ],
      "areaServed": { "@id": "https://dryliningmaidstone.co.uk/#serviceArea" }
    },
    {
      "@type": "WebSite",
      "@id": "https://dryliningmaidstone.co.uk/#website",
      "url": "https://dryliningmaidstone.co.uk",
      "name": "Drylining Maidstone",
      "publisher": { "@id": "https://dryliningmaidstone.co.uk/#org" },
      "potentialAction": {
        "@type": "SearchAction",
        "target": { "@type": "EntryPoint", "urlTemplate": "https://dryliningmaidstone.co.uk/search?q={search_term_string}" },
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.question,
        "acceptedAnswer": { "@type": "Answer", "text": f.answer }
      }))
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://dryliningmaidstone.co.uk/" }]
    }
  ]
};
---

<Layout
  title="Drylining Maidstone | Plasterboard, Partitions & Ceiling Specialists"
  description="Professional drylining contractors in Maidstone. Partition walls, suspended ceilings, metal stud framing, plasterboard installation. Free quotes, CSCS accredited, fully insured."
  canonical="/"
  schema={schema}
>
  <!-- Hero Section -->
  <section style="position: relative; min-height: 620px; display: flex; align-items: center; background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%); overflow: hidden;">
    <img src="/images/maidstone-town.jpg" alt="Maidstone town centre skyline with the River Medway" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.25;" />
    <div class="container hero-grid" style="position: relative; z-index: 1; display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center;">
      <div>
        <div style="display: inline-block; background: rgba(30,64,175,0.2); color: var(--primary); padding: 0.375rem 1rem; border-radius: 9999px; font-size: 0.875rem; font-weight: 600; margin-bottom: 1.5rem; border: 1px solid rgba(30,64,175,0.3);">CSCS Accredited • £1M Insured</div>
        <h1 style="font-size: 3.5rem; font-weight: 800; color: var(--white); line-height: 1.1; margin-bottom: 1.25rem;">Drylining Maidstone<br/><span style="color: #FACC15;">Plasterboard, Partitions &amp; Ceiling Specialists</span></h1>
        <p style="font-size: 1.125rem; color: rgba(255,255,255,0.85); max-width: 500px; line-height: 1.7; margin-bottom: 2rem;">Expert drylining contractors serving Maidstone and surrounding areas. Free quotes, fast turnaround, and quality workmanship guaranteed.</p>
        <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
          <a href="/get-quote/" class="btn btn-primary" style="font-size: 1.0625rem; padding: 1rem 2.25rem;">Get My Free Quote</a>
          <a href="tel:+448****8888" class="btn btn-outline" style="border-color: rgba(255,255,255,0.4); color: var(--white); font-size: 1.0625rem; padding: 1rem 2.25rem;">FREEPHONE 0800 MAIDSTONE</a>
        </div>
      </div>
      
      <div style="background: var(--white); border-radius: var(--radius); padding: 2rem; box-shadow: var(--shadow-lg);">
        <h3 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 1.25rem; color: var(--secondary);">Quick Quote Request</h3>
        <form action="https://script.google.com/macros/s/AKfycbx2ROgDcHu3ArLmfqPETQYCkFn_5YP6fy1WfZMbynAZsoARpnMRntm5iLlgKSFSJBkG/exec" method="POST" id="heroQuoteForm" style="display: flex; flex-direction: column; gap: 0.875rem;">
          <input type="hidden" name="source" value="dryliningmaidstone-co-uk" />
          <input type="text" name="name" placeholder="Your name" required style="padding: 0.75rem 1rem; border: 1px solid var(--border); border-radius: var(--radius); font-size: 0.9375rem; font-family: inherit;" />
          <input type="tel" name="phone" placeholder="Phone number" required style="padding: 0.75rem 1rem; border: 1px solid var(--border); border-radius: var(--radius); font-size: 0.9375rem; font-family: inherit;" />
          <input type="email" name="email" placeholder="Email address" style="padding: 0.75rem 1rem; border: 1px solid var(--border); border-radius: var(--radius); font-size: 0.9375rem; font-family: inherit;" />
          <select name="service" required style="padding: 0.75rem 1rem; border: 1px solid var(--border); border-radius: var(--radius); font-size: 0.9375rem; font-family: inherit; background: var(--white); color: var(--text);">
            <option value="" disabled selected>Select a service</option>
            <option>Drylining Contractors</option>
            <option>Partition Walls</option>
            <option>Metal Stud Partitioning</option>
            <option>Suspended Ceilings</option>
            <option>Plasterboard Installation</option>
            <option>Taping & Jointing</option>
            <option>Commercial Drylining</option>
            <option>Office Drylining</option>
          </select>
          <textarea name="details" placeholder="Project details (optional)" rows="3" style="padding: 0.75rem 1rem; border: 1px solid var(--border); border-radius: var(--radius); font-size: 0.9375rem; font-family: inherit; resize: vertical;"></textarea>
          <button type="submit" class="btn btn-primary" id="heroSubmitBtn" style="width: 100%; margin-top: 0.25rem;">Request Free Quote</button>
          <div id="heroFormMessage" style="font-size: 0.875rem; margin-top: 0.5rem; display: none;"></div>
        </form>
      </div>
    </div>
  </section>

  <TrustBar />

  <!-- Video Section -->
  <section class="section" style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);">
    <div class="container" style="text-align: center;">
      <h2 class="section-title" style="color: var(--white);">See Our Work in Action</h2>
      <p style="font-size: 1.125rem; color: rgba(255,255,255,0.85); max-width: 600px; margin: 0 auto 2rem;">Watch how our expert team transforms spaces with professional drylining, partition walls, and suspended ceilings across Maidstone.</p>
      <div style="position: relative; max-width: 900px; margin: 0 auto; border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow-lg);">
        <video controls poster="/images/maidstone-town.jpg" style="width: 100%; display: block;" preload="metadata">
          <source src="https://dryliningmaidstone.vercel.app/videos/drylining-maidstone-promo.mp4" type="video/mp4">
          Your browser does not support the video tag.
        </video>
      </div>
      <p style="font-size: 0.875rem; color: rgba(255,255,255,0.6); margin-top: 1rem;">Drylining Maidstone — Maidstone town centre fit-outs, period-home renovations and plasterboard installation across ME14-ME18, TN12, TN27.</p>
    </div>
  </section>

  <!-- Before & After Showcase -->
  <section class="section" style="background: var(--white);">
    <div class="container">
      <div style="text-align: center; margin-bottom: 2.5rem;">
        <div style="display:inline-block;background:rgba(30,64,175,0.10);color:var(--primary);padding:0.4rem 1rem;border-radius:9999px;font-size:0.8125rem;font-weight:600;margin-bottom:1rem;border:1px solid rgba(30,64,175,0.25);letter-spacing:0.05em;">REAL MAIDSTONE PROJECTS</div>
        <h2 class="section-title">Before &amp; After — Our Recent Work</h2>
        <p class="section-subtitle" style="margin-left:auto;margin-right:auto;text-align:center;">Period-home renovations, Maidstone riverside fit-outs, and new-build plasterboard installations across the Maidstone. Every project delivered by our CSCS-accredited team with full sign-off and warranty.</p>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem;">
        <figure style="margin:0;background:var(--accent);border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow);">
          <img src="/images/beforeafter-newbuild-partition-1.jpg" alt="Before and after of a new-build partition wall in Maidstone — metal stud framing to skim-finished plasterboard" style="width:100%;height:280px;object-fit:cover;display:block;" />
          <figcaption style="padding:1rem 1.25rem;font-size:0.9375rem;color:var(--text);"><strong style="color:var(--secondary);">New-build partition wall</strong> · Maidstone central · metal stud to finished plasterboard</figcaption>
        </figure>
        <figure style="margin:0;background:var(--accent);border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow);">
          <img src="/images/beforeafter-office-ceiling-1.jpg" alt="Before and after of an office suspended ceiling installation in Maidstone riverside Maidstone" style="width:100%;height:280px;object-fit:cover;display:block;" />
          <figcaption style="padding:1rem 1.25rem;font-size:0.9375rem;color:var(--text);"><strong style="color:var(--secondary);">Office suspended ceiling</strong> · Maidstone town centre · grid &amp; tile fit-out</figcaption>
        </figure>
        <figure style="margin:0;background:var(--accent);border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow);">
          <img src="/images/beforeafter-victorian-living-1.jpg" alt="Before and after of a Victorian living room re-plaster in Bearsted Maidstone" style="width:100%;height:280px;object-fit:cover;display:block;" />
          <figcaption style="padding:1rem 1.25rem;font-size:0.9375rem;color:var(--text);"><strong style="color:var(--secondary);">Victorian living room</strong> · Bearsted · full re-plaster &amp; drylining</figcaption>
        </figure>
        <figure style="margin:0;background:var(--accent);border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow);">
          <img src="/images/beforeafter-commercial-ceiling-1.jpg" alt="Before and after of a commercial building exposed ceiling upgrade in Maidstone" style="width:100%;height:280px;object-fit:cover;display:block;" />
          <figcaption style="padding:1rem 1.25rem;font-size:0.9375rem;color:var(--text);"><strong style="color:var(--secondary);">Commercial ceiling upgrade</strong> · Maidstone · services hidden, plaster skim finish</figcaption>
        </figure>
        <figure style="margin:0;background:var(--accent);border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow);">
          <img src="/images/beforeafter-edwardian-living-1.jpg" alt="Before and after of an Edwardian house living room drylining in Maidstone" style="width:100%;height:280px;object-fit:cover;display:block;" />
          <figcaption style="padding:1rem 1.25rem;font-size:0.9375rem;color:var(--text);"><strong style="color:var(--secondary);">Edwardian living room</strong> · Loose · plaster skim over new plasterboard</figcaption>
        </figure>
        <figure style="margin:0;background:var(--accent);border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow);">
          <img src="/images/beforeafter-newbuild-ceiling-2.jpg" alt="Before and after of a new-build suspended ceiling installation in Maidstone" style="width:100%;height:280px;object-fit:cover;display:block;" />
          <figcaption style="padding:1rem 1.25rem;font-size:0.9375rem;color:var(--text);"><strong style="color:var(--secondary);">New-build MF ceiling</strong> · Harrietsham · full MF plasterboard system</figcaption>
        </figure>
      </div>
      <div style="text-align:center;margin-top:2.5rem;">
        <a href="/get-quote/" class="btn btn-primary" style="font-size:1.0625rem;padding:0.875rem 1.75rem;">Get Your Free Quote</a>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="section" style="background: var(--accent);">
    <div class="container">
      <h2 class="section-title">Our Drylining Services</h2>
      <p class="section-subtitle">From residential renovations to large commercial fit-outs, we deliver every drylining service you need — all under one roof, fully accredited, and fully insured.</p>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
        {services.map(s => (
          <FlipCard title={s.title} description={s.description} link={s.link} icon={`<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>`} />
        ))}
      </div>
      <div style="text-align: center; margin-top: 3rem;">
        <a href="/services/" class="btn btn-secondary">View All Services</a>
      </div>
    </div>
  </section>

  <!-- Areas Section -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">Areas We Cover</h2>
      <p class="section-subtitle">We provide drylining, partition walls, and suspended ceiling services across Maidstone and the surrounding region. If your area is not listed, get in touch — we likely still cover it.</p>
      <AreasGrid areas={areas} />
      <div style="text-align: center; margin-top: 3rem;">
        <a href="/areas/" class="btn btn-secondary">View All Areas</a>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="section" style="background: var(--accent);">
    <div class="container">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center;">
        <div>
          <img src="/images/about-team.jpg" alt="Drylining Maidstone contractor at work on a plasterboard wall" style="border-radius: var(--radius); width: 100%; max-width: 420px; display: block; margin: 0 auto; box-shadow: var(--shadow-lg);" />
        </div>
        <div>
          <h2 class="section-title">Why Choose Drylining Maidstone?</h2>
          <p style="color: var(--text-light); margin-bottom: 2rem; font-size: 1.0625rem; line-height: 1.7;">We are not just another drylining company. We are a team of skilled tradespeople who take pride in every board we fix and every seam we tape. Here is what sets us apart:</p>
          <ul style="list-style: none; display: flex; flex-direction: column; gap: 1.25rem;">
            <li style="display: flex; gap: 1rem; align-items: flex-start;">
              <span style="background: var(--primary); color: var(--white); width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem; flex-shrink: 0;">1</span>
              <div>
                <strong style="color: var(--secondary); display: block; margin-bottom: 0.25rem;">CSCS Accredited Team</strong>
                <span style="color: var(--text-light); font-size: 0.9375rem;">Every contractor on our team holds valid CSCS cards and site safety certifications.</span>
              </div>
            </li>
            <li style="display: flex; gap: 1rem; align-items: flex-start;">
              <span style="background: var(--primary); color: var(--white); width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem; flex-shrink: 0;">2</span>
              <div>
                <strong style="color: var(--secondary); display: block; margin-bottom: 0.25rem;">£1M Public Liability Insurance</strong>
                <span style="color: var(--text-light); font-size: 0.9375rem;">Full insurance coverage on every project, giving you total peace of mind.</span>
              </div>
            </li>
            <li style="display: flex; gap: 1rem; align-items: flex-start;">
              <span style="background: var(--primary); color: var(--white); width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem; flex-shrink: 0;">3</span>
              <div>
                <strong style="color: var(--secondary); display: block; margin-bottom: 0.25rem;">Free, No-Obligation Quotes</strong>
                <span style="color: var(--text-light); font-size: 0.9375rem;">Transparent pricing with no hidden fees. We quote honestly and stick to it.</span>
              </div>
            </li>
            <li style="display: flex; gap: 1rem; align-items: flex-start;">
              <span style="background: var(--primary); color: var(--white); width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem; flex-shrink: 0;">4</span>
              <div>
                <strong style="color: var(--secondary); display: block; margin-bottom: 0.25rem;">24-Hour Response Time</strong>
                <span style="color: var(--text-light); font-size: 0.9375rem;">We aim to respond to all enquiries within 24 hours, often the same day.</span>
              </div>
            </li>
            <li style="display: flex; gap: 1rem; align-items: flex-start;">
              <span style="background: var(--primary); color: var(--white); width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem; flex-shrink: 0;">5</span>
