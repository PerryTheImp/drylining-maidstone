---
import "../styles/tokens.css";
import "../styles/base.css";

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: Record<string, unknown>;
}
const { title, description, canonical, schema } = Astro.props;
const siteUrl = "https://dryliningmaidstone.co.uk";
const canonicalUrl = canonical ? `${siteUrl}${canonical}` : siteUrl;

// Unified LocalBusiness NAP — present on every page, schema-aware pages can extend
const localBusinessSchema = {
  "@type": "LocalBusiness",
  "@id": `${siteUrl}/#business`,
  "name": "Drylining Maidstone",
  "url": siteUrl,
  "telephone": "+448****8888",
  "priceRange": "££",
  "image": `${siteUrl}/images/maidstone-town.jpg`,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Maidstone Metropolitan Borough",
    "addressLocality": "Maidstone",
    "addressRegion": "Kent",
    "postalCode": "ME14",
    "addressCountry": "GB"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 51.2748,
    "longitude": 0.5232
  },
  "areaServed": {
    "@type": "AdministrativeArea",
    "name": "Maidstone Borough",
    "sameAs": ["https://en.wikipedia.org/wiki/Maidstone", "https://www.wikidata.org/wiki/Q213180"]
  },
  "openingHoursSpecification": [
    { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "08:00", "closes": "18:00" },
    { "@type": "OpeningHoursSpecification", "dayOfWeek": "Saturday", "opens": "09:00", "closes": "13:00" }
  ]
};

// Compose final schema: site-wide LocalBusiness + per-page schema (if provided)
// De-duplicate LocalBusiness entries so the layout's NAP always wins
const isLb = (n: any) => n && (n["@type"] === "LocalBusiness" || (Array.isArray(n["@type"]) && n["@type"].includes("LocalBusiness")));
const finalSchema = schema
  ? (schema["@graph"]
      ? { "@context": "https://schema.org", "@graph": [localBusinessSchema, ...schema["@graph"].filter((n: any) => !isLb(n))] }
      : { "@context": "https://schema.org", "@graph": [localBusinessSchema, schema] })
  : { "@context": "https://schema.org", "@graph": [localBusinessSchema] };
---
<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="google-site-verification" content="wjWfGd4Uru4RvsLIspgW8uGsAGtOsxPUUQP5b0RP0f0" />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <!-- Google Preferred Sources SDK (Publisher Center button placeholder lives on the cost-guide and about pages) -->
  <script async src="https://news.google.com/swg/js/v1/publisher.js"></script>
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://dryliningmaidstone.co.uk/images/maidstone-town.jpg" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://dryliningmaidstone.co.uk/images/maidstone-town.jpg" />
  <!-- Local SEO / NAP geo-meta tags -->
  <meta name="geo.region" content="GB-ENG" />
  <meta name="geo.placename" content="Maidstone, Kent" />
  <meta name="geo.position" content="51.2748;0.5232" />
  <meta name="ICBM" content="51.2748, 0.5232" />
  <meta name="format-detection" content="telephone=yes" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify(finalSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": "https://dryliningmaidstone.co.uk/#org",
    name: "Drylining Maidstone",
    url: "https://dryliningmaidstone.co.uk",
    sameAs: [
      "https://www.wikidata.org/wiki/Q213180",
      "https://en.wikipedia.org/wiki/Maidstone",
      "https://en.wikipedia.org/wiki/Maidstone"
    ],
    knowsAbout: [
      "https://en.wikipedia.org/wiki/Drywall",
      "https://en.wikipedia.org/wiki/Partition_wall",
      "https://en.wikipedia.org/wiki/Dropped_ceiling",
      "https://en.wikipedia.org/wiki/Plaster",
      "https://en.wikipedia.org/wiki/Building_regulations_in_the_United_Kingdom",
      "https://en.wikipedia.org/wiki/Construction_worker",
      "https://en.wikipedia.org/wiki/General_contractor"
    ],
    areaServed: {
      "@type": "Place",
      name: "Maidstone, Kent, UK",
      sameAs: [
        "https://en.wikipedia.org/wiki/Maidstone",
        "https://www.wikidata.org/wiki/Q213180",
        "https://en.wikipedia.org/wiki/Maidstone"
      ]
    }
  })} />
</head>
<body>
  <header style="background: var(--white); border-bottom: 1px solid var(--border); position: sticky; top: 0; z-index: var(--z-header);">
    <div class="container" style="display: flex; align-items: center; justify-content: space-between; height: 72px;">
      <a href="/" style="display: flex; align-items: center; gap: 0.5rem; font-weight: 800; font-size: 1.5rem; color: var(--secondary);">
        <span style="color: var(--primary);">Drylining</span> Maidstone
      </a>
      <nav style="display: flex; gap: 1.25rem; align-items: center;" class="desktop-nav">
        <a href="/services/" style="font-weight: 500; font-size: 0.8125rem; color: var(--text);">Services</a>
        <a href="/areas/" style="font-weight: 500; font-size: 0.8125rem; color: var(--text);">Areas</a>
        <a href="/about/" style="font-weight: 500; font-size: 0.8125rem; color: var(--text);">About</a>
        <div class="nav-dropdown" style="position: relative;">
          <a href="/resources/dry-lining-cost-guide/" style="font-weight: 500; font-size: 0.8125rem; color: var(--text);">Resources</a>
          <div class="dropdown-menu" style="display: none; position: absolute; top: 100%; left: 0; background: var(--white); border: 1px solid var(--border); border-radius: var(--radius); padding: 6px 0; min-width: 200px; box-shadow: var(--shadow); z-index: var(--z-dropdown);">
            <a href="/blog/" style="display: block; padding: 6px 14px; font-size: 0.8125rem; font-weight: 500; color: var(--text);">Blog</a>
            <a href="/faq/" style="display: block; padding: 6px 14px; font-size: 0.8125rem; font-weight: 500; color: var(--text);">FAQ</a>
            <a href="/resources/dry-lining-cost-guide/" style="display: block; padding: 6px 14px; font-size: 0.8125rem; color: var(--text-light);">Dry Lining Cost Guide</a>
          </div>
        </div>
        <a href="/contact/" style="font-weight: 500; font-size: 0.8125rem; color: var(--text);">Contact</a>
        <div style="display: flex; gap: 0.5rem; align-items: center; flex-shrink: 0;">
          <a href="tel:+448****8888" class="btn btn-secondary" style="padding: 0.5rem 1rem; font-size: 0.75rem; white-space: nowrap;">FREEPHONE 0800 MAIDSTONE</a>
          <a href="/get-quote/" class="btn btn-primary" style="padding: 0.5rem 1rem; font-size: 0.75rem; white-space: nowrap;">Contact Us</a>
        </div>
      </nav>
      <button id="mobileMenuBtn" style="display: none; background: none; border: none; font-size: 1.5rem; cursor: pointer;" aria-label="Open menu">☰</button>
    </div>
    <nav id="mobileNav" style="display: none; border-top: 1px solid var(--border); padding: 1rem 1.5rem; flex-direction: column; gap: 1rem; background: var(--white);">
      <a href="/services/" style="font-weight: 500; color: var(--text); padding: 0.5rem 0;">Services</a>
      <a href="/areas/" style="font-weight: 500; color: var(--text); padding: 0.5rem 0;">Areas</a>
      <a href="/about/" style="font-weight: 500; color: var(--text); padding: 0.5rem 0;">About</a>
      <a href="/resources/dry-lining-cost-guide/" style="font-weight: 500; color: var(--text); padding: 0.5rem 0;">Resources</a>
      <a href="/blog/" style="font-weight: 500; color: var(--text-light); padding: 0.5rem 0 0.5rem 1.25rem; font-size: 0.9375rem;">— Blog</a>
      <a href="/faq/" style="font-weight: 500; color: var(--text-light); padding: 0.5rem 0 0.5rem 1.25rem; font-size: 0.9375rem;">— FAQ</a>
      <a href="/contact/" style="font-weight: 500; color: var(--text); padding: 0.5rem 0;">Contact</a>
      <a href="tel:+448****8888" class="btn btn-secondary" style="text-align: center;">FREEPHONE 0800 MAIDSTONE</a>
      <a href="/get-quote/" class="btn btn-primary" style="text-align: center;">Contact Us</a>
    </nav>
  </header>
  <main>
    <slot />
  </main>
  <footer style="background: var(--secondary); color: var(--white); padding: 4rem 0 2rem;">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 3rem; margin-bottom: 3rem;">
        <div>
          <div style="font-weight: 800; font-size: 1.5rem; margin-bottom: 1rem;"><span style="color: var(--primary);">Drylining</span> Maidstone</div>
          <p style="color: #aaa; font-size: 0.9375rem; line-height: 1.7;">Professional drylining, partition wall and suspended ceiling contractors serving the Maidstone and the wider Kent area. Free, no-obligation written quotes.</p>
        </div>
        <div>
          <h4 style="font-weight: 700; margin-bottom: 1rem; font-size: 1rem; text-transform: uppercase; letter-spacing: 0.05em;">Services</h4>
          <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.5rem;">
            <li><a href="/services/drylining-contractors/" style="color: #aaa; font-size: 0.9375rem;">Drylining Contractors</a></li>
            <li><a href="/services/partition-walls/" style="color: #aaa; font-size: 0.9375rem;">Partition Walls</a></li>
            <li><a href="/services/suspended-ceilings/" style="color: #aaa; font-size: 0.9375rem;">Suspended Ceilings</a></li>
            <li><a href="/services/commercial-drylining/" style="color: #aaa; font-size: 0.9375rem;">Commercial Drylining</a></li>
          </ul>
        </div>
        <div>
          <h4 style="font-weight: 700; margin-bottom: 1rem; font-size: 1rem; text-transform: uppercase; letter-spacing: 0.05em;">Areas</h4>
          <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.5rem;">
            <li><a href="/areas/maidstone-central/" style="color: #aaa; font-size: 0.9375rem;">Maidstone Central</a></li>
            <li><a href="/areas/bearsted/" style="color: #aaa; font-size: 0.9375rem;">Bearsted</a></li>
            <li><a href="/areas/allington/" style="color: #aaa; font-size: 0.9375rem;">Allington</a></li>
            <li><a href="/areas/loose/" style="color: #aaa; font-size: 0.9375rem;">Loose</a></li>
          </ul>
        </div>
        <div>
          <h4 style="font-weight: 700; margin-bottom: 1rem; font-size: 1rem; text-transform: uppercase; letter-spacing: 0.05em;">Contact</h4>
          <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.5rem; color: #aaa; font-size: 0.9375rem;">
            <li>📞 <a href="tel:+448****8888" style="color: #aaa;">FREEPHONE 0800 MAIDSTONE</a></li>
            <li>📍 Maidstone, Kent, ME14</li>
            <li>⏰ Mon–Fri 8am–6pm · Sat 9am–1pm</li>
            <li><a href="/get-quote/" class="btn btn-primary" style="margin-top: 0.5rem; display: inline-block;">Get a Free Quote</a></li>
          </ul>
        </div>
      </div>
      <div style="border-top: 1px solid #333; padding-top: 2rem; display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; align-items: center;">
        <p style="color: #888; font-size: 0.875rem;">© {new Date().getFullYear()} Drylining Maidstone. All rights reserved.</p>
        <div style="display: flex; gap: 1.5rem; font-size: 0.875rem;">
          <a href="/privacy/" style="color: #888;">Privacy Policy</a>
          <a href="/contact/" style="color: #888;">Contact</a>
        </div>
      </div>
    </div>
  </footer>
  <script>
    const btn = document.getElementById("mobileMenuBtn");
    const nav = document.getElementById("mobileNav");
    if (btn && nav) {
      const update = () => {
        const isMobile = window.innerWidth <= 768;
        btn.style.display = isMobile ? "block" : "none";
        if (!isMobile) nav.style.display = "none";
      };
      update();
      window.addEventListener("resize", update);
      btn.addEventListener("click", () => {
        nav.style.display = nav.style.display === "flex" ? "none" : "flex";
      });
    }
  </script>
</body>
</html>